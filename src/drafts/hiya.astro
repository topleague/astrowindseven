---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Product Description Writing Services | Top League',
  description:
    'Persuasive, research-driven and SEO-friendly product descriptions that help shoppers understand your products and feel confident buying them.',
};

const sampleLink = 'mailto:hello@topleaguetech.com?subject=Free%20Sample%20Request';

const stats = [
  { n: 'Product', l: 'Understand the product' },
  { n: 'Buyer', l: 'Understand the buyer' },
  { n: 'Words', l: 'Find the right words' },
  { n: 'Review', l: 'Write, review and refine' },
];

const why = [
  { g: '◆', t: 'Features need meaning', d: 'Features tell shoppers what a product has. Benefits help them understand what it can do for them. We bring the two together through clear, compelling writing.' },
  { g: '?', t: 'Buyers need answers', d: 'We consider your target audience, their priorities and the questions they’re likely to ask before putting words on the page.' },
  { g: '⌕', t: 'Products need visibility', d: 'We incorporate relevant search keywords naturally, without compromising readability or turning your descriptions into keyword lists.' },
];

const moment = [
  { t: 'Browsing', d: 'Imagine someone browsing your online store.' },
  { t: 'Interested', d: 'They find a product that looks promising. The photographs are appealing. The price seems reasonable.' },
  { t: 'Scrolling', d: 'They scroll down to learn a little more.' },
  { t: 'Nothing to go on', d: 'But the description tells them almost nothing. Just a list of specifications, a few generic sentences and perhaps some technical details copied from the manufacturer’s catalogue.' },
  { t: 'Still asking', d: 'They still have questions. Will it solve their problem? Is it worth the price? What makes it different from the alternatives?' },
  { t: 'Another tab', d: 'They hesitate. They open another tab. And your product becomes just another option they considered.' },
];

const usual = [
  'Long lists of unexplained specifications',
  'Generic claims that could describe any product',
  'Keyword-heavy sentences that are hard to read',
  'Pushy language and exaggerated promises',
];
const better = [
  'Clear information that answers real questions',
  'Meaningful benefits connected to product features',
  'Natural keywords and readable copy',
  'Persuasion grounded in the product’s actual value',
];

const steps = [
  { dot: '1', k: 'STEP 01', t: 'Understand the product', d: 'We examine its features, specifications, intended uses and distinguishing qualities. We identify what a prospective customer needs to know.' },
  { dot: '2', k: 'STEP 02', t: 'Understand the buyer', d: 'Who is likely to purchase this product? What matters to them? What concerns might prevent them from buying?' },
  { dot: '3', k: 'STEP 03', t: 'Find the right words', d: 'We identify relevant keywords and translate product information into clear, benefit-oriented language.' },
  { dot: '4', k: 'STEP 04', t: 'Write, review and refine', d: 'We review the copy for clarity, accuracy, readability and SEO considerations before delivery.' },
];

const plans = [
  {
    k: 'Basic', t: 'A practical starting point',
    d: 'For businesses looking to experience our product description writing before placing a larger order.',
    li: ['Product-focused descriptions', 'Research-led writing', 'SEO-aware copy'],
  },
  {
    k: 'Standard', t: 'For growing catalogues',
    d: 'For online stores improving product content across a growing catalogue.',
    li: ['Consistent catalogue voice', 'Product and audience research', 'SEO titles and meta descriptions'], feat: true, badge: 'Popular',
  },
  {
    k: 'Premium', t: 'For larger catalogues',
    d: 'For businesses with substantial product ranges that need consistent descriptions at scale.',
    li: ['Bulk-order planning', 'Consistent writing standards', 'Volume-based pricing'],
  },
];

const marquee = ['Meaning', 'Answers', 'Visibility', 'Confidence'].join(' ✦ ') + ' ✦ ';
---

<Layout metadata={metadata} pageClass="product-description-page">

  <script is:inline>
    document.documentElement.classList.add('sx-js');
    // Safety net: if the page script ever fails to start, show everything.
    setTimeout(function () {
      if (!document.querySelector('.sx-page[data-sx-ready]')) document.documentElement.classList.remove('sx-js');
    }, 4000);
  </script>

  <div class="sx-page">
    <div class="sx-progress" aria-hidden="true"><span></span></div>

    <!-- 1. HERO -->
    <section class="sx-hero">
      <div class="sx-wrap sx-hero-grid">
        <div class="sx-hero-copy">
          <div class="sx-pill"><span class="sx-dot"></span> Product description writing</div>

          <h1>
            Product descriptions
            <span>that make buying easier.</span>
          </h1>

          <p>
            We turn product features into meaningful reasons to buy, with persuasive,
            research-driven and SEO-friendly product descriptions.
          </p>

          <div class="sx-actions">
            <a class="sx-btn sx-btn-primary" href="#contact">Request a free sample <i>↗</i></a>
            <a class="sx-btn sx-btn-ghost" href="#included">See what's included <i>↓</i></a>
          </div>

          <div class="sx-note">No obligation. Just good product writing for you to evaluate.</div>
        </div>

        <div
          class="sx-stage"
          role="img"
          aria-label="Illustration: a product page where a bare list of specifications sits next to a description that explains benefits and answers questions."
        >
          <div class="sx-win">
            <div class="sx-win-bar"><i></i><i></i><i></i><span>yourstore.com/product</span></div>
            <div class="sx-win-body">
              <div class="sx-cols" style="--c:2">
                <span class="sx-sk is-img" style="height:140px"></span>
                <div style="display:grid;gap:10px;align-content:start">
                  <span class="sx-sk is-h w90"></span>
                  <span class="sx-sk w50"></span>
                  <span class="sx-sk w70"></span>
                  <span class="sx-sk is-btn" style="width:120px;margin-top:6px"></span>
                </div>
              </div>
              <div class="sx-cols" style="--c:2">
                <div class="sx-box">
                  <span class="sx-chip" style="justify-self:start">Specs only</span>
                  <span class="sx-sk w90"></span>
                  <span class="sx-sk w70"></span>
                  <span class="sx-sk w80"></span>
                  <span class="sx-sk w60"></span>
                </div>
                <div class="sx-box sx-hl" style="--hd:3s">
                  <span class="sx-chip is-hot" style="justify-self:start">With our copy</span>
                  <span class="sx-sk is-hot w70"></span>
                  <span class="sx-sk w90"></span>
                  <span class="sx-sk w80"></span>
                  <span class="sx-sk w50"></span>
                </div>
              </div>
            </div>
          </div>

          <span class="sx-pin" style="right:-2%;top:6%"><b>1</b> Benefits, not just features</span>
          <span class="sx-pin" style="left:-2%;top:56%"><b>2</b> Answers buyer questions</span>
          <span class="sx-pin" style="right:-2%;bottom:5%"><b>3</b> Keywords, naturally</span>
        </div>
      </div>
    </section>

    <!-- 2. STRIP -->
    <section class="sx-proof">
      <div class="sx-wrap sx-proof-grid">
        <div class="sx-proof-lead sx-reveal">Understand first.<br />Write second.</div>
        <div class="sx-stats is-text">
          {stats.map((s, i) => (
            <div class="sx-stat sx-reveal" style={`--d:${i * 0.08}s`}>
              <div class="sx-num"><span>{s.n}</span></div>
              <div class="sx-stat-l">{s.l}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. WHY IT MATTERS -->
    <section class="sx-section" id="coming">
      <div class="sx-wrap sx-two">
        <div>
          <div class="sx-kicker sx-reveal">Why it matters</div>
          <h2 class="sx-h2 sx-reveal" style="max-width:none">Good product descriptions make the value obvious.</h2>
          <p class="sx-lead sx-reveal">The right words connect what a product does with what a customer actually cares about.</p>

          <ul class="sx-problems">
            {why.map((w, i) => (
              <li class="sx-reveal" style={`--d:${0.1 + i * 0.1}s`}>
                <span class="sx-ico" aria-hidden="true">{w.g}</span>
                <div>
                  <div class="sx-p-t">{w.t}</div>
                  <div class="sx-p-d">{w.d}</div>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="sx-win sx-reveal" role="img" aria-label="Illustrative example: a plain feature turned into a benefit, a buyer question turned into an answer, and a search term used naturally.">
          <div class="sx-bridge">
            <div style="display:grid;gap:8px">
              <div class="sx-bridge-l">Features need meaning</div>
              <div class="sx-qa">Stainless steel, 750 ml</div>
              <div class="sx-qa is-a">Keeps your drink cold through the workday.</div>
            </div>
            <div style="display:grid;gap:8px">
              <div class="sx-bridge-l">Buyers need answers</div>
              <div class="sx-qa">Will it fit in my bag?</div>
              <div class="sx-qa is-a">Slim enough for a side pocket.</div>
            </div>
            <div style="display:grid;gap:8px">
              <div class="sx-bridge-l">Products need visibility</div>
              <div class="sx-qa">insulated water bottle</div>
              <div class="sx-qa is-a">An insulated water bottle that stays out of the way.</div>
            </div>
            <div class="sx-dots-cap" style="padding:0"><div>Illustrative example only.</div></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. A FAMILIAR SHOPPING MOMENT -->
    <section class="sx-section sx-night" id="story">
      <div class="sx-wrap sx-story-grid">
        <div class="sx-sticky">
          <div class="sx-kicker sx-reveal">A familiar shopping moment</div>
          <h2 class="sx-h2 sx-reveal" style="max-width:none">Someone is interested in your product. But are they convinced?</h2>
          <blockquote class="sx-bigq sx-reveal">The problem isn't necessarily your product. Sometimes, it's the way your product is presented.</blockquote>
          <div class="sx-copy">
            <p class="sx-reveal">
              A good product description closes that gap. It helps shoppers understand what they're looking at,
              imagine how it fits into their lives and recognise why it might be the right choice.
            </p>
            <p class="sx-reveal"><strong>That's what we believe product writing should accomplish.</strong></p>
          </div>
        </div>

        <ol class="sx-steps">
          {moment.map((m, i) => (
            <li class="sx-reveal" style={`--d:${i * 0.07}s`}>
              <span>{i + 1}</span>
              <div>
                <div class="sx-p-t">{m.t}</div>
                <div class="sx-p-d">{m.d}</div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5. THE TOP LEAGUE APPROACH -->
    <section class="sx-section sx-alt" id="difference">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">The Top League approach</div>
          <h2 class="sx-h2 sx-reveal">Your product may be excellent. Your description should make that obvious.</h2>
          <p class="sx-lead sx-reveal">
            Effective product copy doesn't need to be complicated. It needs to communicate the right
            things in the right way.
          </p>
        </div>

        <div class="sx-vs">
          <article class="sx-vs-card sx-vs-old sx-watch sx-reveal">
            <div class="sx-vs-k"><span class="sx-x">×</span> The usual way</div>
            <h3>Descriptions that get in the way</h3>
            <ul>{usual.map((t, i) => <li style={`--i:${i}`}>{t}</li>)}</ul>
          </article>

          <div class="sx-vs-badge" aria-hidden="true">VS</div>

          <article class="sx-vs-card sx-vs-new sx-watch sx-reveal" style="--d:.12s">
            <div class="sx-vs-k"><span class="sx-tick">✓</span> The Top League approach</div>
            <h3>Copy that helps customers decide</h3>
            <ul>{better.map((t, i) => <li style={`--i:${i}`}><span class="sx-tick">✓</span>{t}</li>)}</ul>
          </article>
        </div>
      </div>
    </section>

    <!-- 6. HOW WE WORK -->
    <section class="sx-section" id="process">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">How we work</div>
          <h2 class="sx-h2 sx-reveal">Before we write about your product, we need to understand it.</h2>
          <p class="sx-lead sx-reveal">
            Good product descriptions don't begin with a writing template. They begin with understanding.
          </p>
        </div>

        <ol class="sx-tl sx-watch" style={`--n:${steps.length}`}>
          {steps.map((s) => (
            <li>
              <span class="sx-tl-dot">{s.dot}</span>
              <div class="sx-tl-k">{s.k}</div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. WHAT'S INCLUDED -->
    <section class="sx-section sx-alt" id="included">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">What's included</div>
          <h2 class="sx-h2 sx-reveal">Everything your product page needs to make a stronger impression.</h2>
        </div>

        <div class="sx-bento">

          <article class="sx-card sx-glow sx-reveal sx-b7">
            <div class="sx-viz sx-serp-wrap" aria-hidden="true">
              <div class="sx-serp">
                <div class="sx-serp-top">
                  <span class="sx-fav">Y</span>
                  <div><b>Your Store</b><small>yourstore.com › products › product-name</small></div>
                </div>
                <div class="sx-serp-title">Product name | Your Store</div>
                <div class="sx-serp-desc">Benefit-led copy that helps each product page make a stronger first impression in search.</div>
              </div>
            </div>
            <div class="sx-card-k">04 — Search</div>
            <h3>SEO titles and meta descriptions</h3>
            <p>
              We provide SEO titles and meta descriptions alongside your product descriptions, helping
              each product page make a stronger first impression in search.
            </p>
          </article>

          <article class="sx-card sx-glow sx-reveal sx-b5" style="--d:.08s">
            <div class="sx-viz" aria-hidden="true">
              <div class="sx-tiles">
                {[0, 1, 2, 3, 4, 5].map(() => (
                  <div class="sx-tile"><span class="sx-sk is-img"></span><span class="sx-sk is-hot w50"></span><span class="sx-sk w90"></span></div>
                ))}
              </div>
            </div>
            <div class="sx-card-k">05 — Consistency</div>
            <h3>A consistent catalogue</h3>
            <p>
              Whether you have a handful of products or hundreds, your catalogue should communicate a
              consistent brand personality.
            </p>
          </article>

          <article class="sx-card sx-glow sx-reveal sx-b5">
            <div class="sx-viz" aria-hidden="true">
              <div class="sx-stack">
                <div class="sx-box" style="--k:0"><span class="sx-sk w70"></span><span class="sx-sk w50"></span></div>
                <div class="sx-box" style="--k:1"><span class="sx-sk w70"></span><span class="sx-sk w50"></span></div>
                <div class="sx-box is-top" style="--k:2"><span class="sx-sk is-hot w70"></span><span class="sx-sk w50"></span></div>
              </div>
            </div>
            <div class="sx-card-k">06 — Bulk value</div>
            <h3>Better value on bulk orders</h3>
            <p>Have a large catalogue to populate? Ask us about volume-based pricing for qualifying bulk orders.</p>
          </article>

          <article class="sx-card sx-glow sx-reveal sx-b7" style="--d:.08s">
            <div class="sx-viz is-stack" aria-hidden="true">
              <div class="sx-chips"><span class="sx-chip is-hot">Free sample</span></div>
              <span class="sx-sk w90"></span>
              <span class="sx-sk w60"></span>
              <div class="sx-url"><b>Sample</b> Try before you commit <span class="sx-ok">✓</span></div>
            </div>
            <div class="sx-card-k">07 — Free sample</div>
            <h3>Try before you commit</h3>
            <p>
              Not sure whether our writing is right for your business? Get in touch to discuss a sample
              before choosing a package.
            </p>
          </article>

        </div>
      </div>
    </section>

    <!-- 8. PACKAGES -->
    <section class="sx-section" id="packages">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">Writing packages</div>
          <h2 class="sx-h2 sx-reveal">Start small. Scale when you're ready.</h2>
          <p class="sx-lead sx-reveal">
            Whether you're testing the waters or building an entire catalogue, there's a package to get you moving.
          </p>
        </div>

        <div class="sx-paths">
          {plans.map((p, i) => (
            <article class={`sx-path sx-glow sx-reveal${p.feat ? ' is-feat' : ''}`} style={`--d:${i * 0.1}s`}>
              <span class="sx-path-n" aria-hidden="true">0{i + 1}</span>
              {p.badge && <span class="sx-badge">{p.badge}</span>}
              <div class="sx-card-k">{p.k}</div>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
              <ul>{p.li.map((t) => <li><span class="sx-tick">✓</span>{t}</li>)}</ul>
              <a class={`sx-btn ${p.feat ? 'sx-btn-primary' : 'sx-btn-dark'}`} href="#contact">Discuss your requirements <i>↗</i></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 9. MARQUEE -->
    <div class="sx-marquee" aria-hidden="true">
      <div class="sx-marquee-track">
        <span>{marquee}</span>
        <span>{marquee}</span>
        <span>{marquee}</span>
        <span>{marquee}</span>
      </div>
    </div>

    <!-- 10. CTA -->
    <section class="sx-cta" id="contact">
      <div class="sx-wrap">
        <div class="sx-cta-card sx-reveal">
          <div>
            <div class="sx-kicker sx-kicker-lime">Let's talk</div>
            <h2>Let's make your descriptions shine</h2>
            <p>You've already invested in your products. Let's make the shoppers notice what they're worth.</p>
          </div>
          <a class="sx-btn sx-btn-primary sx-btn-lg" href={sampleLink}>Request a free sample <i>↗</i></a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style is:global>
.sx-page {
    --bg: #fff; --alt: #f1f4f2; --ink: #16202a; --muted: #566470; --line: #dfe5e8; --card: #fff;
    --red: #b34a43; --green: #1f5f55; --lime: #d9ff43; --night: #17242b; --night-2: #0f1a1f;
    color: var(--ink); background: var(--bg); overflow-x: clip; position: relative;
  }
.dark .sx-page {
    --bg: #1e293b; --alt: #172033; --ink: #f8fafc; --muted: #cbd5e1; --line: #334155; --card: #243247;
  }
.sx-page p { color: var(--muted); }
.sx-page .sx-wrap { max-width: 1180px; margin-inline: auto; padding-inline: 20px; }
.sx-page .sx-section { padding: clamp(72px, 9vw, 120px) 0; background: var(--bg); position: relative; }
.sx-page .sx-alt { background: var(--alt); border-block: 1px solid var(--line); }
.sx-page .sx-progress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 70; pointer-events: none; }
.sx-page .sx-progress span { display: block; height: 100%; background: var(--lime); transform: scaleX(0); transform-origin: 0 50%; }
.sx-js .sx-page .sx-reveal:not(.is-in) { opacity: 0; transform: translateY(22px); }
.sx-page .sx-reveal { transition: opacity .7s ease, transform .7s cubic-bezier(.2, .8, .2, 1); transition-delay: var(--d, 0s); }
.sx-page .sx-kicker { font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--red); margin-bottom: 18px; }
.sx-page .sx-kicker-lime { color: var(--lime); }
.sx-page .sx-h2 { font-size: clamp(34px, 4.6vw, 60px); line-height: 1.04; margin: 0 0 20px; color: var(--ink); max-width: 16ch; }
.sx-page .sx-head .sx-h2 { max-width: 20ch; }
.sx-page .sx-lead { font-size: clamp(17px, 1.6vw, 20px); line-height: 1.55; max-width: 46ch; margin: 0; }
.sx-page .sx-head { margin-bottom: 56px; max-width: 760px; }
.sx-page .sx-two { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(36px, 6vw, 90px); align-items: center; }
.sx-page .sx-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 15px 24px; border-radius: 999px;
    font-weight: 700; font-size: 15px; text-decoration: none; transition: transform .25s ease, background .25s ease, box-shadow .25s ease;
    border: 1px solid transparent; line-height: 1.2; cursor: pointer;
  }
.sx-page .sx-btn i { font-style: normal; display: inline-block; transition: transform .25s ease; }
.sx-page .sx-btn:hover i { transform: translate(3px, -3px); }
.sx-page .sx-btn:hover { transform: translateY(-2px); }
.sx-page .sx-btn-primary { background: var(--lime); color: #17242b; box-shadow: 0 10px 30px -10px rgba(217, 255, 67, .55); }
.sx-page .sx-btn-primary:hover { box-shadow: 0 16px 36px -10px rgba(217, 255, 67, .75); }
.sx-page .sx-btn-ghost { color: #fff; border-color: rgba(255, 255, 255, .35); }
.sx-page .sx-btn-ghost:hover { background: rgba(255, 255, 255, .08); }
.sx-page .sx-btn-dark { background: #17242b; color: #fff; }
.sx-page .sx-btn-dark:hover { background: #22343d; }
.sx-page .sx-btn-lg { padding: 18px 30px; font-size: 16px; white-space: nowrap; }
.sx-page .sx-hero {
    position: relative; overflow: hidden; color: #fff; padding: 150px 0 90px;
    background:
      radial-gradient(900px 520px at 88% 8%, rgba(217, 255, 67, .13), transparent 60%),
      radial-gradient(700px 520px at 0% 100%, rgba(179, 74, 67, .25), transparent 60%),
      linear-gradient(120deg, #0f1a1f, #17242b 55%, #1f3038);
  }
.sx-page .sx-hero::before {
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background-image: linear-gradient(rgba(255, 255, 255, .06) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .06) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse at 60% 40%, #000 10%, transparent 70%);
    mask-image: radial-gradient(ellipse at 60% 40%, #000 10%, transparent 70%);
  }
.sx-page .sx-hero-grid { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; gap: 40px; align-items: center; }
.sx-page .sx-pill {
    display: inline-flex; align-items: center; gap: 10px; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; font-weight: 700;
    padding: 8px 14px; border-radius: 999px; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .16); margin-bottom: 28px;
  }
.sx-page .sx-dot { width: 8px; height: 8px; border-radius: 50%; background: #b9db1c; box-shadow: 0 0 0 0 rgba(185, 219, 28, .7); animation: sx-ping 2s infinite; }
.sx-page .sx-hero h1 {
    font-size: clamp(46px, 6.4vw, 92px); line-height: 1; letter-spacing: -.045em; margin: 0 0 26px; color: #fff; max-width: 11ch;
  }
.sx-page .sx-hero h1 span {
    display: block; color: var(--lime);
    background: linear-gradient(transparent 82%, rgba(217, 255, 67, .22) 82%); width: fit-content;
  }
.sx-page .sx-hero p { font-size: clamp(18px, 1.7vw, 21px); line-height: 1.55; color: rgba(255, 255, 255, .8); max-width: 34em; margin: 0 0 34px; }
.sx-page .sx-actions { display: flex; flex-wrap: wrap; gap: 12px; }
