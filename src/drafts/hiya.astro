.sx-page .sx-float .sx-serp-desc { font-size: 12px; }
.sx-page .sx-url { display: flex; align-items: center; gap: 10px; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .18); border-radius: 999px; padding: 10px 16px; font-weight: 700; font-size: 15px; color: rgba(255, 255, 255, .85); overflow: hidden; }
.sx-page .sx-url b { color: var(--lime); }
.sx-page .sx-ok { flex: none; margin-left: auto; width: 22px; height: 22px; border-radius: 50%; background: var(--lime); color: #17242b; display: grid; place-items: center; font-size: 12px; font-weight: 900; }
.sx-page .sx-viz svg { width: 100%; height: auto; max-width: 280px; overflow: visible; }
