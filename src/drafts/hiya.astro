.sx-page .sx-stack { position: relative; width: 100%; height: 150px; }
.sx-page .sx-stack .sx-box { position: absolute; width: 74%; left: calc(var(--k, 0) * 10%); top: calc(var(--k, 0) * 16px); background: #1d3037; box-shadow: 0 14px 30px -14px rgba(0, 0, 0, .7); }
.sx-page .sx-stack .sx-box.is-top { background: #1f5f55; border-color: rgba(217, 255, 67, .5); }
