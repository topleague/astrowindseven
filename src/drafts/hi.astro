</style>

<script>
  const initHomeDraft = () => {
    const root = document.querySelector('.home-draft');
    if (!root || root.dataset.hdReady) return;
    root.dataset.hdReady = 'true';
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      root.classList.add('hd-js');
      const observer = new IntersectionObserver((entries, current) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            current.unobserve(entry.target);
          }
        });
      }, { threshold: 0.16, rootMargin: '0px 0px -5% 0px' });
      root.querySelectorAll('.hd-reveal').forEach((element) => observer.observe(element));
    }
    const progress = root.querySelector('.hd-progress span');
    let ticking = false;
    const update = () => {
      if (progress) {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        progress.style.transform = `scaleX(${max > 0 ? window.scrollY / max : 0})`;
      }
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
    update();
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initHomeDraft, { once: true });
  else initHomeDraft();
</script>
