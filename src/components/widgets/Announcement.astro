
---
export interface Props {
  badge?: string;
  text?: string;
  href?: string;
  showStars?: boolean;
}

const {
  badge = 'NEW',
  text = 'Astro v7 is now available! »',
  href = 'https://astro.build/blog/astro-7/',
  showStars = true,
} = Astro.props;
---

<div style="display: none;">
  {
    badge && <span>{badge}</span>
  }
  {
    text &&
      (href ? (
        <a href={href} set:html={text} />
      ) : (
        <span set:html={text} />
      ))
  }
  {
    showStars && (
      <a
        target="_blank"
        rel="noopener noreferrer"
        href="https://github.com/arthelokyo/astrowind"
      >
        <span>GitHub stars</span>
      </a>
    )
  }
</div>
