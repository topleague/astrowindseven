---
export interface Props {
  prevUrl?: string;
  nextUrl?: string;
  prevText?: string;
  nextText?: string;
}

// `prevUrl`/`nextUrl` come from Astro's `page.url` and already include `base`
// and honour `trailingSlash`, so they must not go through `getPermalink()`.
const { prevUrl, nextUrl, prevText = 'Newer posts', nextText = 'Older posts' } = Astro.props;
---

{
  (prevUrl || nextUrl) && (
    <nav class="sx-pager" aria-label="Pagination">
      {prevUrl ? (
        <a class="sx-btn" href={prevUrl} rel="prev">
          <i>←</i> {prevText}
        </a>
      ) : (
        <span />
      )}
      {nextUrl ? (
        <a class="sx-btn" href={nextUrl} rel="next">
          {nextText} <i>→</i>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
