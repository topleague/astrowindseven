---
import type { ImageMetadata } from 'astro';
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';

import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import { getPermalink } from '~/utils/permalinks';
import { findImage } from '~/utils/images';
import { getFormattedDate } from '~/utils/utils';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = (await findImage(post.image)) as ImageMetadata | undefined;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
const categoryLink = post.category ? getPermalink(post.category.slug, 'category') : '';
---

<article class="sx-post sx-glow">
  <div class="sx-post-media">
    {
      image ? (
        <Image
          src={image}
          widths={[400, 900]}
          width={900}
          height={506}
          sizes="(max-width: 900px) 400px, 900px"
          alt=""
          format="webp"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="sx-post-ph" aria-hidden="true">
          <span>{post.category?.title ?? 'Article'}</span>
        </div>
      )
    }
  </div>

  <div class="sx-post-body">
    <div class="sx-post-meta">
      {
        post.category &&
          (APP_BLOG?.category?.isEnabled ? (
            <a class="sx-ptag is-cat" href={categoryLink}>
              {post.category.title}
            </a>
          ) : (
            <span class="sx-ptag is-cat">{post.category.title}</span>
          ))
      }
      <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
      {post.author && <span>· {post.author.replaceAll('-', ' ')}</span>}
      {post.readingTime && <span>· {post.readingTime} min read</span>}
    </div>

    <h2 class="sx-post-title">
      {link ? <a href={link}>{post.title}</a> : post.title}
    </h2>

    {post.excerpt && <p class="sx-post-ex">{post.excerpt}</p>}

    <div class="sx-post-foot">
      {post.tags && Array.isArray(post.tags) ? <PostTags tags={post.tags.slice(0, 3)} /> : <span />}
      {link && <span class="sx-post-more">Read article <i>→</i></span>}
    </div>
  </div>
</article>
