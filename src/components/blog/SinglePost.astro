---
import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';

import { APP_BLOG } from 'astrowind:config';
import { getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
  crumbs?: Array<{ text: string; href?: string; icon?: string }>;
}

const { post, url, crumbs } = Astro.props;
const updateDate = post.updateDate;
const updated = updateDate && updateDate.getTime() !== post.publishDate.getTime();
---

<article>
  <header class="sx-hero sx-blog-hero sx-art-hero">
    <div class="sx-wrap">
      {
        crumbs && (
          <div class="sx-crumbs">
            <Breadcrumbs items={crumbs} hideCurrent />
          </div>
        )
      }

      <div class="sx-art-meta">
        {
          post.category &&
            (APP_BLOG?.category?.isEnabled ? (
              <a class="sx-ptag is-cat" href={getPermalink(post.category.slug, 'category')}>
                {post.category.title}
              </a>
            ) : (
              <span class="sx-ptag is-cat">{post.category.title}</span>
            ))
        }
        <time datetime={post.publishDate.toISOString()}>{getFormattedDate(post.publishDate)}</time>
        {
          updated && updateDate && (
            <span>
              · Updated <time datetime={updateDate.toISOString()}>{getFormattedDate(updateDate)}</time>
            </span>
          )
        }
        {post.author && <span>· {post.author.replaceAll('-', ' ')}</span>}
        {post.readingTime && <span>· {post.readingTime} min read</span>}
      </div>

      <h1>{post.title}</h1>
      {post.excerpt && <p>{post.excerpt}</p>}
    </div>
  </header>

  {
    post.image && (
      <div class="sx-wrap sx-art-cover">
        <Image
          src={post.image}
          widths={[400, 900]}
          sizes="(max-width: 900px) 400px, 900px"
          alt={post.imageAlt || ''}
          width={900}
          height={506}
          format="webp"
          loading="eager"
          decoding="async"
        />
      </div>
    )
  }

  <section class="sx-section sx-art-section">
    <div class="sx-wrap">
      <div
        class="sx-art-body prose prose-lg dark:prose-invert prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-headings:scroll-mt-[80px] prose-li:my-0"
      >
        <slot />
      </div>

      <div class="sx-art-foot">
        <PostTags tags={post.tags} />
        <SocialShare url={url} text={post.title} />
      </div>
    </div>
  </section>
</article>
