          class="sx-growth-area"
          d="M40 300
             C145 286 205 235 275 170
             S425 65 520 35
             L520 300Z"
          fill="url(#sx-growth-fill)"
        />

        <!-- Website growth ceiling -->
        <path
          class="sx-growth-ceiling"
          d="M40 300
             C145 286 205 235 275 170
             S390 145 520 145"
        />

