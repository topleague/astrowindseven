            <div class="sx-box">
              <span class="sx-sk is-hot w50"></span>
              <span class="sx-sk w90"></span>
              <span class="sx-sk w70"></span>
            </div>
          </div>
        </div>
      </div>

      <span class="sx-pin" style="right:-2%;top:6%">
        <b>1</b> Looks like your brand
      </span>
      <span class="sx-pin" style="left:-2%;top:58%">
        <b>2</b> Fast on any device
      </span>
      <span class="sx-pin" style="right:-2%;bottom:5%">
        <b>3</b> SEO from day one
      </span>
    </div>
  </div>
</section>
