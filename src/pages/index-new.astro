          <path d="M40 60H520 M40 120H520 M40 180H520 M40 240H520 M40 300H520" />
          <path d="M40 30V300 M160 30V300 M280 30V300 M400 30V300 M520 30V300" />
        </g>

        <!-- Growth area -->
