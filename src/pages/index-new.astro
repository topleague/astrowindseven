</section>

    <!-- 2. THIRD HERO /*___________________________________🟢 ¯\_(ツ)_/¯ 🟢 ___________________________________*/-->
<!-- 1. HERO SECTION -->
<section class="sx-hero sx-hero-refined">
  <div class="sx-wrap sx-hero-grid">
    <div class="sx-hero-copy">
      <div class="sx-pill sx-hero-eyebrow">
        <span class="sx-dot"></span>
        Website design
      </div>

      <h1>
        Build Your Online Presence,
        <span class="sx-hero-aside">Not Just a<br />Website.</span>
      </h1>

      <p>
        Based in Bhubaneswar, working with small businesses across India and worldwide.
      </p>

      <div class="sx-actions">
        <a class="sx-btn sx-btn-primary" href="#contact">
          Free consultation <i>↗</i>
        </a>
        <a class="sx-btn sx-btn-ghost" href="#plans">
          See plans and prices <i>↓</i>
        </a>
      </div>

      <div class="sx-note">
        Website design · Content writing · SEO &amp; social media · Maintenance
      </div>
    </div>

    <!-- Growth-ceiling illustration -->
    <figure class="sx-reveal sx-watch sx-chart-card">
      <div class="sx-chart">
        <svg
          viewBox="0 0 560 340"
          role="img"
          aria-label="Illustration: SEO on a weak website levels off at the website's ceiling, while SEO on a website built for it keeps climbing."
        >
          <defs>
            <linearGradient
              id="sx-area"
              x1="0"
              x2="0"
              y1="0"
              y2="1"
            >
              <stop offset="0" stop-color="#1f5f55" stop-opacity=".35" />
              <stop offset="1" stop-color="#1f5f55" stop-opacity="0" />
            </linearGradient>
          </defs>

          <g class="sx-grid">
            <path d="M40,300H540" />
            <path d="M40,225H540" />
            <path d="M40,150H540" />
            <path d="M40,75H540" />
            <path d="M40,20V300" />
          </g>

          <path
            d="M40,300C150,288 220,215 300,148C380,92 450,48 540,30L540,300L40,300Z"
            class="sx-area"
            fill="url(#sx-area)"
          />

          <path
            d="M40,120H540"
            class="sx-ceiling"
          />

          <path
            d="M40,300C140,292 200,214 270,160C330,124 420,122 540,120"
            class="sx-curve sx-draw sx-curve-a"
            pathLength="1"
          />

          <path
            d="M40,300C150,288 220,215 300,148C380,92 450,48 540,30"
            class="sx-curve sx-draw sx-curve-b"
            pathLength="1"
          />

