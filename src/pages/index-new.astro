        <defs>
          <linearGradient
            id="sx-growth-fill"
            x1="0"
            y1="0"
            x2="0"
            y2="1"
          >
            <stop
              offset="0%"
              stop-color="var(--sx-growth-line)"
              stop-opacity=".16"
            />
            <stop
              offset="100%"
              stop-color="var(--sx-growth-line)"
              stop-opacity="0"
            />
