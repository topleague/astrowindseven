---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'SEO Article Writing Services | Top League',
  description:
    'Well-researched, reader-focused SEO articles that answer real questions and give your business something useful to say.',
};

const enquiryLink = 'mailto:hello@topleaguetech.com?subject=SEO%20Article%20Writing%20Enquiry';
---

<Layout metadata={metadata} pageClass="product-description-page">
  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="eyebrow">
        <span class="dot"></span>
        SEO article writing
      </div>

      <h1>
        SEO article writing
        <span>worth reading.</span>
      </h1>

      <p>
        Well-researched, reader-focused articles that answer real questions and give your
        business something useful to say.
      </p>

      <div class="actions">
        <a class="btn primary" href="#packages">Explore packages ↗</a>
        <a class="btn ghost" href="#process">See how we work ↓</a>
      </div>

      <div class="hero-note">
        Industry experience since 2006 · Top League established in 2010
      </div>
    </div>
  </section>

  <!-- THE PROBLEM / WHY IT MATTERS -->
  <section class="section" id="story">
    <div class="container story-layout">
      <span class="story-number" aria-hidden="true">01</span>

      <div class="story-content">
        <div class="kicker">A changing search landscape</div>

        <h2>Publishing more content isn't the goal. Publishing better content is.</h2>

        <p>
          Your audience has questions. Search engines have become better at understanding
          them. And generic, keyword-filled articles are unlikely to make your business stand out.
        </p>

        <p>
          You need content that understands the subject, addresses the reader's intent and
          communicates ideas clearly.
        </p>

        <p>
          <strong>That's where we come in.</strong> We bring two decades of industry
          experience to content that has a clear purpose—not simply another page to fill.
        </p>
      </div>
    </div>
  </section>

  <!-- THE TOP LEAGUE APPROACH -->
  <section class="section band" id="difference">
    <div class="container">
      <div class="feature-head">
        <div>
          <div class="kicker">The Top League approach</div>
          <h2>Search has changed. Your content should too.</h2>
          <p>
            We focus on useful information, clear structure and natural optimisation—not
            outdated content shortcuts.
          </p>
        </div>
      </div>

      <div class="features">
        <article class="feature">
          <div class="kicker">× THE USUAL WAY</div>
          <h3>Articles built around keywords</h3>
          <ul>
            <li>Generic advice repackaged across websites</li>
            <li>Keywords forced into awkward sentences</li>
            <li>Word counts mistaken for value</li>
            <li>Publishing volume without a clear purpose</li>
          </ul>
        </article>

        <article class="feature">
          <div class="kicker">✓ THE TOP LEAGUE APPROACH</div>
          <h3>Articles built around readers</h3>
          <ul>
            <li>Search intent shapes the structure</li>
            <li>Research informs the substance</li>
            <li>Keywords fit naturally into useful copy</li>
            <li>Every section earns its place</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- WHAT WE WRITE -->
  <section class="section" id="included">
    <div class="container">
      <div class="feature-head">
        <div>
          <div class="kicker">What we write</div>
          <h2>Different topics. Different purposes. One focus on quality.</h2>
          <p>Choose the kind of content that fits your audience and your goals.</p>
        </div>
      </div>

      <div class="features">
        <article class="feature">
          <div class="kicker">01 — BLOG CONTENT</div>
          <h3>SEO blog posts</h3>
          <p>
            Useful, search-focused posts that keep your blog relevant and give readers a
            reason to return.
          </p>
        </article>

        <article class="feature">
          <div class="kicker">02 — EXPLAINERS</div>
          <h3>Informational articles</h3>
          <p>
            Clear explanations that answer questions, unpack concepts and help readers make
            informed decisions.
          </p>
        </article>

        <article class="feature">
          <div class="kicker">03 — PRACTICAL CONTENT</div>
          <h3>How-to guides and tutorials</h3>
          <p>Step-by-step content that helps your audience understand how to do something.</p>
        </article>

        <article class="feature">
          <div class="kicker">04 — INDUSTRY CONTENT</div>
          <h3>Industry-specific articles</h3>
          <p>
            Well-researched articles shaped around your sector, your audience and the
            questions that matter to them.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="section band" id="process">
    <div class="container">
      <div class="feature-head">
        <div>
          <div class="kicker">How we work</div>
          <h2>From your brief to a finished article.</h2>
          <p>A straightforward process. Clear communication at every stage.</p>
        </div>
      </div>

      <div class="process">
        <article>
          <div class="kicker">STEP 01</div>
          <h3>Understand the brief</h3>
          <p>
            We discuss your topic, audience, objectives, keywords and content requirements.
          </p>
        </article>

        <article>
          <div class="kicker">STEP 02</div>
          <h3>Research and structure</h3>
          <p>
            We explore the subject and organise the article around its purpose and the
            reader's intent.
          </p>
        </article>

        <article>
          <div class="kicker">STEP 03</div>
          <h3>Write and refine</h3>
          <p>
            We develop the article with a clear structure, natural keyword integration and
            reader-friendly language.
          </p>
        </article>

        <article>
          <div class="kicker">STEP 04</div>
          <h3>Review and deliver</h3>
          <p>
            We proofread the content, incorporate agreed feedback and deliver the finished
            article.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- CLIENT FEEDBACK -->
  <section class="section" id="proof">
    <div class="container proof">
      <div>
        <div class="kicker">Client feedback</div>
        <h2 class="quote">
          “Well written, concise and well optimized for search.”
          <small>Sean · Founder, Acquisition Engine</small>
        </h2>
      </div>

      <div class="proofcards">
        <article class="testimonial">
          <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
          <p>
            “If you are in search of good SEO articles, look no further. At Top League you
            will find the best team of content writers in the internet. I have been using
            their services for over a year and have accomplished great results in my online
            marketing campaign.”
          </p>
          <div class="person">Roberto · Founder, Polo Mercantile</div>
        </article>

        <article class="testimonial">
          <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
          <p>
            “The team did an excellent job on content creation for our appliance repair
            website. They must have done a thorough research on this topic because everything
            was written very professionally.”
          </p>
          <div class="person">Alex Garayev · Founder, SD Appliances</div>
        </article>
      </div>
    </div>
  </section>

  <!-- WRITING PACKAGES -->
  <section class="section band" id="packages">
    <div class="container">
      <div class="feature-head">
        <div>
          <div class="kicker">Writing packages</div>
          <h2>Clear pricing. Plenty of room to scale.</h2>
          <p>
            Every package includes 2,000-word articles. Choose the volume that suits your
            content plan.
          </p>
        </div>
      </div>

      <div class="pricing-grid">
        <article class="price-card">
          <div class="kicker">Basic</div>
          <h3>A practical starting point</h3>
          <div class="price">$320</div>
          <ul>
            <li>5 articles</li>
            <li>2,000 words each</li>
            <li>10 business days</li>
          </ul>
          <a
            class="btn primary"
            href="mailto:hello@topleaguetech.com?subject=Basic%20SEO%20Article%20Package"
          >Discuss this package ↗</a>
        </article>

        <article class="price-card price-popular">
          <div class="kicker">Standard</div>
          <h3>For a steady content plan</h3>
          <div class="price">$640</div>
          <ul>
            <li>10 articles</li>
            <li>2,000 words each</li>
            <li>20 business days</li>
          </ul>
          <a
            class="btn primary"
            href="mailto:hello@topleaguetech.com?subject=Standard%20SEO%20Article%20Package"
          >Discuss this package ↗</a>
        </article>

        <article class="price-card">
          <div class="kicker">Premium</div>
          <h3>For larger content plans</h3>
          <div class="price">$1,280</div>
          <ul>
            <li>20 articles</li>
            <li>2,000 words each</li>
            <li>40 business days</li>
          </ul>
          <a
            class="btn primary"
            href="mailto:hello@topleaguetech.com?subject=Premium%20SEO%20Article%20Package"
          >Discuss this package ↗</a>
        </article>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section id="contact" class="cta">
    <div class="wrap">
      <div class="kicker">Let's talk</div>
      <h2>Have a topic in mind? Let's make it useful.</h2>
      <p>
        Tell us what you want to communicate, who you're trying to reach and what you want
        your content to achieve. We'll help you take it from there.
      </p>
      <a class="primary button" href={enquiryLink}>Discuss your project ↗</a>
    </div>
  </section>
</Layout>
