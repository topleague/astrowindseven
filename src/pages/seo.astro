---
import Layout from '~/layouts/PageLayout.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'SEO Services | Top League Technologies',
  description:
    'SEO that starts with your website. Development-led SEO for speed, structure and search visibility, from the team that builds it.',
};

const enquiryLink = 'mailto:hello@topleaguetech.com?subject=SEO%20Services%20Enquiry';
---

<Layout metadata={metadata} pageClass="product-description-page">

  <!-- 1. HERO -->
  <section class="hero">
    <div class="container">

      <div class="eyebrow">
        <span class="dot"></span>
        SEO + web development
      </div>

      <h1>
        Here for SEO?
        <span>Start with your website.</span>
      </h1>

      <p>
        Rankings are built on speed, structure and clean code. We fix the website,
        then the search. One team. One plan.
      </p>

      <div class="actions">
        <a class="btn primary" href={enquiryLink}>Get a free website + SEO review ↗</a>
        <a class="btn ghost" href="#difference">See why ↓</a>
      </div>

      <div class="hero-note">
        No giant proposal. Just a conversation.
      </div>

    </div>
  </section>

  <!-- 2. STRIP -->
  <section class="proofbar" aria-label="What SEO depends on">
    <div class="container proofgrid">
      <div class="proof">
        <strong>Speed</strong>
        <span>fast on every device</span>
      </div>
      <div class="proof">
        <strong>Structure</strong>
        <span>clean, crawlable pages</span>
      </div>
      <div class="proof">
        <strong>Content</strong>
        <span>written for real searches</span>
      </div>
      <div class="proof">
        <strong>Growth</strong>
        <span>improved after launch</span>
      </div>
    </div>
  </section>

  <!-- 3. THE UNCOMFORTABLE TRUTH -->
  <Features2
    id="coming"
    classes={{ container: 'coming-section', headline: { container: 'max-w-3xl !mx-0 !text-left' } }}
    tagline="The uncomfortable truth"
    title="SEO can't outrun a weak website."
    subtitle="Keywords and content only go as far as the site underneath can carry them."
    columns={3}
    items={[
      {
        title: 'Slow pages lose twice',
        description: 'Visitors leave. Search engines notice.',
        icon: 'tabler:search',
      },
      {
        title: 'Messy structure hides good content',
        description: 'Pages that are hard to crawl are hard to rank.',
        icon: 'tabler:sitemap',
      },
      {
        title: 'Unclear journeys waste traffic',
        description: 'Visitors who can’t find the next step don’t get in touch.',
        icon: 'tabler:target-arrow',
      },
    ]}
  />

  <!-- 4. SEO ON ITS OWN vs SEO + DEVELOPMENT -->
  <section class="section band" id="difference">
    <div class="container">

      <div class="feature-head">
        <div>
          <div class="kicker">The Top League approach</div>
          <h2 class="!text-heading">SEO is part of the build, not a patch on top.</h2>
          <p>Most SEO starts after the website is finished. Ours starts before it's designed.</p>
        </div>
      </div>

      <div class="features">
        <article class="feature">
          <div class="kicker">× SEO ON ITS OWN</div>
          <h3>Fix it from the outside</h3>
          <ul>
            <li>Keywords added to pages that weren't planned for them</li>
            <li>Speed and structure problems left as they are</li>
            <li>Recommendations someone else has to build</li>
            <li>Results capped by the website itself</li>
          </ul>
        </article>

        <article class="feature">
          <div class="kicker">✓ SEO + DEVELOPMENT</div>
          <h3>Build it right from the inside</h3>
          <ul>
            <li>Search intent shapes the pages before design begins</li>
            <li>Speed, structure and markup built in</li>
            <li>The people who build it are the people who optimise it</li>
            <li>Nothing capped. Nothing lost in handover.</li>
          </ul>
        </article>
      </div>

    </div>
  </section>

  <!-- 5. WHAT RANKINGS DEPEND ON -->
  <section class="section" id="included">
    <div class="container">

      <div class="feature-head">
        <div>
          <div class="kicker">SEO from the development side</div>
          <h2 class="!text-heading">Four things rankings quietly depend on.</h2>
        </div>
      </div>

      <div class="features">
        <article class="feature">
          <div class="kicker">01 — Speed</div>
          <h3>Fast by design</h3>
          <p>Mobile-first builds that load quickly and pass performance checks.</p>
        </article>

        <article class="feature">
          <div class="kicker">02 — Structure</div>
          <h3>Pages that make sense</h3>
          <p>Logical headings, links and URLs. Easy for visitors and search engines.</p>
        </article>

        <article class="feature">
          <div class="kicker">03 — Code</div>
          <h3>Clean technical foundations</h3>
          <p>Metadata, indexing, redirects and structured data handled in the build.</p>
        </article>

        <article class="feature">
          <div class="kicker">04 — Content</div>
          <h3>Written for real searches</h3>
          <p>Every page answers what people actually look for. No keyword stuffing.</p>
        </article>
      </div>

    </div>
  </section>

  <!-- 6. AFTER LAUNCH -->
  <section class="section band" id="story">
    <div class="container story-layout">

      <span class="story-number" aria-hidden="true">∞</span>

      <div class="story-content">
        <div class="kicker">After launch</div>

        <h2>Launch is where SEO starts.</h2>

        <p>Search keeps changing. So does your business. We stay on after launch: tracking what ranks, fixing what slips and adding what's missing.</p>

        <p><strong>Same team. Same website. Better every month.</strong></p>
      </div>

    </div>
  </section>

  <!-- 7. STARTING POINTS -->
  <section class="section" id="packages">
    <div class="container">

      <div class="feature-head">
        <div>
          <div class="kicker">Where are you starting from?</div>
          <h2 class="!text-heading">Whatever your starting point, the website comes first.</h2>
          <p>Not sure which fits? Start with a free review.</p>
        </div>
      </div>

      <div class="pricing-grid">

        <article class="price-card">
          <div class="kicker">New website</div>
          <h3>Build it SEO-ready</h3>
          <p>Search planned before design.</p>
          <ul>
            <li>Research before design</li>
            <li>Fast, well-structured build</li>
            <li>Launch checks included</li>
          </ul>
          <a class="btn primary" href={enquiryLink}>Plan my new site ↗</a>
        </article>

        <article class="price-card price-popular">
          <div class="kicker">Existing website</div>
          <h3>Fix the foundations</h3>
          <p>Find what's holding it back.</p>
          <ul>
            <li>Speed, structure and technical review</li>
            <li>Content and on-page fixes</li>
            <li>Fixed by developers, not just reported</li>
          </ul>
          <a class="btn primary" href={enquiryLink}>Review my website ↗</a>
        </article>

        <article class="price-card">
          <div class="kicker">Needs a rethink</div>
          <h3>Rebuild with SEO at the core</h3>
          <p>When the site itself is the limit.</p>
          <ul>
            <li>Restructured pages and navigation</li>
            <li>Redesigned for speed and usability</li>
            <li>Redirects and migration handled</li>
          </ul>
          <a class="btn primary" href={enquiryLink}>Talk it through ↗</a>
        </article>

      </div>

    </div>
  </section>

  <!-- 8. CTA -->
  <section id="contact" class="cta">
    <div class="wrap">
      <div class="cta-box">
        <div>
          <div class="kicker">Let's talk</div>
          <h2>Rethink your SEO strategy.</h2>
          <p>
            No giant proposal. Tell us about your website and your goals. We'll show you what to fix first.
          </p>
        </div>
        <a class="button primary justify-self-start" href={enquiryLink}>Book a free consultation ↗</a>
      </div>
    </div>
  </section>

</Layout>
