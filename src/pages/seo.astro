
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'SEO Services | Top League Technologies',
  description: 'SEO-led website development and practical search optimisation to help your business get found, understood and chosen.',
};

const enquiryLink = 'mailto:hello@topleaguetech.com?subject=SEO%20Services%20Enquiry';

---

<Layout metadata={metadata} pageClass="product-description-page">

  <!-- SECTION 1: HERO -->
  <section class="hero">
    <div class="container">
      <div class="eyebrow"><span class="dot"></span> SEO for website development</div>
      <h1>A Good Website Isn't Enough. <span>It Needs SEO Built In.</span></h1>
      <p>We build SEO into your website from the planning stage. Already have a website? We'll identify what's holding it back and help put it right.</p>
      <div class="actions">
        <a class="btn primary" href={enquiryLink}>Free consultation ↗</a>
        <a class="btn ghost" href="#process">See how we do it ↓</a>
      </div>
    </div>
  </section>

  <!-- SECTION 2: THE SEO REALITY -->
  <section class="section" id="story">
    <div class="container story-layout">
      <span class="story-number" aria-hidden="true">02</span>
      <div class="story-content">
        <div class="kicker">The SEO reality</div>
        <h2>Poor SEO affecting your website?</h2>
        <p>Your website may look great, but poor SEO can make it harder for potential customers to find you, understand what you offer and take action.</p>

        <div class="process-list">
          <article class="step">
            <span>01</span>
            <div>
              <h3>Hard to find</h3>
              <p>Weak keyword targeting, poor indexing and technical issues can keep your pages out of relevant search results.</p>
            </div>
          </article>
          <article class="step">
            <span>02</span>
            <div>
              <h3>Hard to understand</h3>
              <p>Poor page structure, unclear service descriptions and weak internal links make it harder for visitors and search engines to understand your business.</p>
            </div>
          </article>
          <article class="step">
            <span>03</span>
            <div>
              <h3>Hard to convert</h3>
              <p>Even when visitors arrive, weak content, poor user experience and misplaced calls to action can cost you enquiries.</p>
            </div>
          </article>
        </div>
        <p><strong>And these problems aren't always visible on the surface.</strong></p>
      </div>
    </div>
  </section>

  <!-- SECTION 3: OUR APPROACH -->
  <section class="section" id="process">
    <div class="container">
      <div class="process">
        <div class="feature-head">
          <div>
            <div class="kicker">Our approach</div>
            <h2 style="color: #16202a;">SEO starts before your website goes live.</h2>
            <p>A website shouldn't be built first and optimised as an afterthought. We bring SEO into the decisions that shape it — from what your pages say to how the whole site is put together.</p>
          </div>
        </div>

        <div class="process-list">
          <article class="step">
            <span>01</span>
            <div>
              <h3>Research before design</h3>
              <p>We learn what your customers search for, what they need to know and which pages your business actually needs.</p>
            </div>
          </article>
          <article class="step">
            <span>02</span>
            <div>
              <h3>Plan pages with purpose</h3>
              <p>We map services, topics, keywords and search intent into a clear page structure, navigation and URL plan.</p>
            </div>
          </article>
          <article class="step">
            <span>03</span>
            <div>
              <h3>Build on solid foundations</h3>
              <p>We develop a fast, mobile-friendly site with clean structure, useful content, sensible internal links and technical SEO essentials.</p>
            </div>
          </article>
          <article class="step">
            <span>04</span>
            <div>
              <h3>Check before launch</h3>
              <p>We review key pages, metadata, links, indexing settings, redirects and performance before the site is ready to meet the world.</p>
            </div>
          </article>
        </div>
      </div>

      <div class="mt-10 border-y border-slate-200 py-6 dark:border-slate-700">
        <div class="kicker">Then the website goes live</div>
        <p class="mt-2 text-muted">Launch is the starting line, not the finish.</p>
      </div>

      <div class="mt-6 rounded-xl bg-slate-900 p-7 text-white dark:bg-slate-800 md:grid md:grid-cols-2 md:items-center md:gap-8">
        <div>
          <div class="kicker">After launch</div>
          <h3 class="mt-2 text-2xl font-semibold">Keep learning. Keep improving.</h3>
        </div>
        <p class="mt-4 text-slate-300 md:mt-0">We monitor how the site performs, identify opportunities and refine content and SEO over time — because search visibility grows through ongoing work, not a one-off launch checklist.</p>
      </div>
      <p class="mt-6 text-sm text-muted">The right starting point depends on your business, your audience and the website you need.</p>
    </div>
  </section>

</Layout>
