---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'AstroWindy — SEO Content Writing',
  description:
    'Strategic, search-aware content that helps your business get found, build trust and turn attention into action.',
};
---

<Layout metadata={metadata} pageClass="astrowindy-home">
  <div class="astrowindy-home">

  <!-- ANNOUNCEMENT -->
  <div class="announcement">
    <div class="wrap">
      <strong>Content that earns attention.</strong>
      <span>
        SEO-aware writing for businesses that want to be found, understood and chosen.
      </span>
    </div>
  </div>

  <!-- HEADER -->
  <header class="site-header">
    <div class="wrap">
      <nav>
        <a class="brand" href="/">Astro<span>Windy</span></a>

        <div class="navlinks">
          <a href="#services">Services</a>
          <a href="#approach">Approach</a>
          <a href="#proof">Why us</a>
          <a href="#articles">Insights</a>
          <a class="nav-cta" href="#contact">Start a project →</a>
        </div>

        <button class="mobile-btn" aria-label="Menu">☰</button>
      </nav>
    </div>
  </header>

  <main>

    <!-- HERO -->
    <section class="hero">
      <div class="wrap">
        <div class="eyebrow">SEO content writing</div>

        <h1>Turn better words into better business.</h1>

        <div class="hero-copy">
          <div>
            <div class="lead">
              Strategic, search-aware content that helps your business get found,
              build trust and turn attention into action.
            </div>

            <div class="actions">
              <a class="btn primary" href="#services">
                Explore our services →
              </a>

              <a class="btn secondary" href="#contact">
                Tell us what you need
              </a>
            </div>
          </div>

          <div class="hero-side">
            From SEO articles to product descriptions and website copy, we combine
            research, clarity and persuasive writing to create content with a job
            to do.
          </div>
        </div>

        <div class="microproof">
          <span><i class="dot"></i> Research based</span>
          <span><i class="dot"></i> Human edited</span>
          <span><i class="dot"></i> Search aware</span>
          <span><i class="dot"></i> Original writing</span>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services">
      <div class="wrap">

        <div class="section-head">
          <div class="kicker">01 / What we do</div>

          <div>
            <h2>Content designed to do more than fill a page.</h2>

            <p class="section-intro">
              From search-focused articles to persuasive product and website
              copy, we create content around what your audience needs and what
              your business wants to achieve.
            </p>
          </div>
        </div>

        <div class="services">

          <article class="card">
            <div class="num">01</div>

            <h3>SEO Article Writing</h3>

            <p>
              Publish useful, search-aware articles that answer real questions,
              demonstrate expertise and give your website a stronger chance of
              being discovered.
            </p>

            <a class="arrow" href="/seo-content-writing">
              Explore service →
            </a>
          </article>

          <article class="card">
            <div class="num">02</div>

            <h3>Product Description Writing</h3>

            <p>
              Turn browsers into buyers with concise, persuasive descriptions
              that make your products easier to understand, easier to find and
              easier to choose.
            </p>

            <a class="arrow" href="/product">
              Explore service →
            </a>
          </article>

          <article class="card">
            <div class="num">03</div>

            <h3>Website Content Writing</h3>

            <p>
              Make every page work harder with clear, compelling website copy
              that communicates your value and moves visitors naturally toward
              action.
            </p>

            <a class="arrow" href="/website-content-writing">
              Explore service →
            </a>
          </article>

        </div>
      </div>
    </section>

    <!-- APPROACH -->
    <section id="approach">
      <div class="wrap">

        <div class="section-head">
          <div class="kicker">02 / The approach</div>

          <div>
            <h2>The point isn't more words. It's better content.</h2>

            <p class="section-intro">
              We don't start by filling a template. We start by understanding
              the audience, the offer and the search intent. Then we write.
            </p>
          </div>
        </div>

        <div class="feature-grid">

          <article class="feature">
            <div class="num">01</div>
            <div>
              <h3>Audience first.</h3>
              <p>
                We write for real people first—what they need to know, what they
                care about and what might stop them from taking action.
              </p>
            </div>
          </article>

          <article class="feature">
            <div class="num">02</div>
            <div>
              <h3>Search-aware.</h3>
              <p>
                Relevant keywords and search language are built into the writing
                naturally, without turning useful content into keyword stuffing.
              </p>
            </div>
          </article>

          <article class="feature">
            <div class="num">03</div>
            <div>
              <h3>Useful, not padded.</h3>
              <p>
                Every paragraph earns its place. We favour clarity, substance
                and momentum over filler written simply to hit a word count.
              </p>
            </div>
          </article>

          <article class="feature">
            <div class="num">04</div>
            <div>
              <h3>Human-edited.</h3>
              <p>
                Every piece gets an editorial pass for accuracy, readability,
                consistency and the details that make copy feel genuinely
                considered.
              </p>
            </div>
          </article>

          <article class="feature">
            <div class="num">05</div>
            <div>
              <h3>Original work.</h3>
              <p>
                Your content is written for your business, your audience and
                your brief—not recycled from generic templates.
              </p>
            </div>
          </article>

          <article class="feature">
            <div class="num">06</div>
            <div>
              <h3>Built to publish.</h3>
              <p>
                Clean structure, clear headings and practical formatting make
                the finished content easier for your team to review and put live.
              </p>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- STATEMENT -->
    <section>
      <div class="wrap">

        <div class="statement">

          <div>
            <div class="kicker">03 / What good content does</div>

            <h2>
              It gets found. Then it gives people a reason to stay.
            </h2>
          </div>

          <p>
            Traffic is only useful when the page does something with it. We
            create content that connects search intent with a clear business
            purpose—whether that means earning a click, building trust,
            explaining a product or creating the next step toward a sale.
          </p>

        </div>

      </div>
    </section>

    <!-- WHY ASTROWINDY -->
    <section id="proof">
      <div class="wrap">

        <div class="section-head">
          <div class="kicker">04 / Why AstroWindy</div>

          <div>
            <h2>Six reasons to make your next piece count.</h2>

            <p class="section-intro">
              A straightforward writing process, without the agency theatre.
            </p>
          </div>
        </div>

        <div class="feature-grid">

          <article class="feature">
            <div class="num">01</div>
            <div>
              <h3>Targeted content</h3>
              <p>
                We research the audience and the subject before writing so the
                finished piece has a clear point of view and purpose.
              </p>
            </div>
          </article>

          <article class="feature">
            <div class="num">02</div>
            <div>
              <h3>Specialist proofreading</h3>
              <p>
                Every delivery is reviewed for clarity, grammar, consistency
                and polish before it reaches you.
              </p>
            </div>
          </article>

          <article class="feature">
            <div class="num">03</div>
            <div>
              <h3>Risk-free sampling</h3>
              <p>
                Where applicable, start with a complimentary sample and judge
                the writing before committing to a larger project.
              </p>
            </div>
          </article>

          <article class="feature">
            <div class="num">04</div>
            <div>
              <h3>Originality checked</h3>
              <p>
                Content is checked for originality so your site can publish
                with confidence.
              </p>
            </div>
          </article>

          <article class="feature">
            <div class="num">05</div>
            <div>
              <h3>Unlimited revisions</h3>
              <p>
                We work with you until the copy is right for the brief, the
                brand and the page it needs to serve.
              </p>
            </div>
          </article>

          <article class="feature">
            <div class="num">06</div>
            <div>
              <h3>Bulk-friendly pricing</h3>
              <p>
                Have a larger catalogue or content plan? Volume work can unlock
                better per-piece value.
              </p>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section>
      <div class="wrap">

        <div class="section-head">
          <div class="kicker">05 / How it works</div>

          <div>
            <h2>Good content starts with good questions.</h2>

            <p class="section-intro">
              A simple four-step process designed to keep the work focused and
              the handoffs painless.
            </p>
          </div>
        </div>

        <div class="process">

          <article class="step">
            <div class="big">01</div>
            <h3>Understand</h3>
            <p>
              We learn about your business, audience, offer, goals and the job
              the content needs to do.
            </p>
          </article>

          <article class="step">
            <div class="big">02</div>
            <h3>Research</h3>
            <p>
              We investigate the topic, competitors and relevant search
              language before a word is written.
            </p>
          </article>

          <article class="step">
            <div class="big">03</div>
            <h3>Write</h3>
            <p>
              We turn the research into useful, persuasive copy with structure,
              clarity and intent built in.
            </p>
          </article>

          <article class="step">
            <div class="big">04</div>
            <h3>Refine</h3>
            <p>
              You review the draft. We incorporate feedback, polish the final
              version and prepare it for publishing.
            </p>
          </article>

        </div>
      </div>
    </section>

    <!-- SOCIAL PROOF -->
    <section>
      <div class="wrap">

        <div class="section-head">
          <div class="kicker">06 / Social proof</div>

          <div>
            <h2>Let the work speak for itself.</h2>

            <p class="section-intro">
              This section is intentionally ready for real customer stories—
              not invented testimonials. Replace the placeholders with verified
              quotes, names and roles.
            </p>
          </div>
        </div>

        <div class="social">

          <article class="quote">
            <blockquote>
              “[Add a one-sentence quote describing the problem, the work
              delivered and the result.]”
            </blockquote>
            <div class="who">Customer name · Role, company</div>
          </article>

          <article class="quote">
            <blockquote>
              “[Add a quote that answers a common objection—quality, turnaround,
              price or trust.]”
            </blockquote>
            <div class="who">Customer name · Role, company</div>
          </article>

          <article class="quote">
            <blockquote>
              “[Add a short, specific customer quote. A measurable result is
              ideal.]”
            </blockquote>
            <div class="who">Customer name · Role, company</div>
          </article>

        </div>
      </div>
    </section>

    <!-- INSIGHTS -->
    <section id="articles">
      <div class="wrap">

        <div class="section-head">
          <div class="kicker">07 / Latest insights</div>

          <div>
            <h2>Practical ideas for better content.</h2>

            <p class="section-intro">
              Search, writing and website content advice without the fluff.
            </p>
          </div>
        </div>

        <div class="articles">

          <article class="article">
            <div class="date">26 Sept 2026</div>
            <div class="tag">SEO</div>

            <h3>
              How to Choose Phrases for Internal Linking
            </h3>

            <p>
              Make internal links more useful for readers and search engines by
              choosing anchor text with context and intent in mind.
            </p>

            <a href="/blog/how-to-choose-phrases-for-internal-linking">
              Read more →
            </a>
          </article>

          <article class="article">
            <div class="date">25 Sept 2026</div>
            <div class="tag">Tutorials</div>

            <h3>
              Build a Website with an AI Coding Assistant and Astro
            </h3>

            <a href="/blog">
              Read more →
            </a>
          </article>

          <article class="article">
            <div class="date">24 Aug 2026</div>
            <div class="tag">Tutorials</div>

            <h3>
              Get started with AstroWind and Tailwind CSS
            </h3>

            <a href="/blog">
              Read more →
            </a>
          </article>

        </div>

        <div class="actions" style="margin-top:30px">
          <a class="btn secondary" href="/blog">
            View all posts →
          </a>
        </div>

      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final" id="contact">
      <div class="wrap">

        <div class="final-inner">

          <div>
            <div class="eyebrow">Ready when you are</div>

            <h2>Have a page that needs better words?</h2>
          </div>

          <div>
            <p>
              Tell us what you're trying to achieve, what you're selling and
              where the content will live. We'll help you work out the right
              place to start.
            </p>

            <div class="actions">
              <a class="btn primary" href="mailto:hello@astrowindy.com">
                Start a conversation →
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer>
    <div class="wrap">

      <div class="footer-grid">

        <div class="footer-brand">
          <div class="brand">Astro<span>Windy</span></div>

          <p>
            SEO-aware content for businesses that want to be found,
            understood and chosen.
          </p>
        </div>

        <div>
          <h4>Services</h4>
          <a href="#services">SEO articles</a>
          <a href="#services">Product descriptions</a>
          <a href="#services">Website content</a>
        </div>

        <div>
          <h4>Company</h4>
          <a href="/about">About</a>
          <a href="#contact">Contact</a>
          <a href="/blog">Blog</a>
        </div>

        <div>
          <h4>Legal</h4>
          <a href="/terms">Terms</a>
          <a href="/privacy">Privacy policy</a>
        </div>

      </div>

      <div class="copyright">
        © 2026 AstroWindy. All rights reserved.
      </div>

    </div>
  </footer>

 </div>
</Layout>

<style>
  .astrowindy-home {
    --ink: #0b0d10;
    --muted: #5e6670;
    --line: #e6e8eb;
    --soft: #f6f7f8;
    --blue: #0161ef;
    --blue-dark: #0054cf;
    --max: 1180px;
    --radius: 20px;

    color: var(--ink);
    background: #fff;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Arial,
      sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  .astrowindy-home *,
  .astrowindy-home *::before,
  .astrowindy-home *::after {
    box-sizing: border-box;
  }

  .astrowindy-home a {
    color: inherit;
    text-decoration: none;
  }

  .astrowindy-home .wrap {
    width: min(calc(100% - 40px), var(--max));
    margin: auto;
  }

  .astrowindy-home .announcement {
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
    padding: 11px 0;
  }

  .astrowindy-home .announcement .wrap {
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  .astrowindy-home .announcement strong {
    color: var(--ink);
  }

  .astrowindy-home .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(230, 232, 235, 0.9);
  }

  .astrowindy-home nav {
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .astrowindy-home .brand {
    font-weight: 760;
    letter-spacing: -0.04em;
    font-size: 19px;
  }

  .astrowindy-home .brand span {
    color: var(--blue);
  }

  .astrowindy-home .navlinks {
    display: flex;
    gap: 28px;
    align-items: center;
    font-size: 14px;
    color: #3f4650;
  }

  .astrowindy-home .navlinks a:hover {
    color: var(--blue);
  }

  .astrowindy-home .nav-cta {
    padding: 10px 15px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
    font-weight: 650;
  }

  .astrowindy-home .mobile-btn {
    display: none;
    border: 0;
    background: none;
    font-size: 24px;
  }

  .astrowindy-home .hero {
    padding: 104px 0 92px;
    border-bottom: 1px solid var(--line);
  }

  .astrowindy-home .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    font-weight: 750;
    color: var(--blue);
    margin-bottom: 24px;
  }

  .astrowindy-home .eyebrow::before {
    content: "";
    width: 24px;
    height: 1px;
    background: var(--blue);
  }

  .astrowindy-home h1 {
    max-width: 960px;
    margin: 0;
    font-size: clamp(50px, 7.5vw, 94px);
    line-height: 0.96;
    letter-spacing: -0.065em;
    font-weight: 760;
  }

  .astrowindy-home .hero-copy {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    margin-top: 42px;
    align-items: end;
  }

  .astrowindy-home .lead {
    font-size: 22px;
    line-height: 1.45;
    letter-spacing: -0.025em;
    max-width: 620px;
  }

  .astrowindy-home .hero-side {
    justify-self: end;
    max-width: 360px;
    color: var(--muted);
    line-height: 1.65;
    font-size: 15px;
  }

  .astrowindy-home .actions {
    display: flex;
    gap: 12px;
    margin-top: 25px;
    flex-wrap: wrap;
  }

  .astrowindy-home .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 13px 18px;
    border-radius: 999px;
    border: 1px solid var(--ink);
    font-weight: 680;
    font-size: 14px;
  }

  .astrowindy-home .btn.primary {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }

  .astrowindy-home .btn.primary:hover {
    background: var(--blue-dark);
  }

  .astrowindy-home .btn.secondary {
    background: #fff;
  }

  .astrowindy-home .microproof {
    margin-top: 55px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 13px;
  }

  .astrowindy-home .microproof span {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .astrowindy-home .dot {
    width: 5px;
    height: 5px;
    background: var(--blue);
    border-radius: 50%;
  }

  .astrowindy-home main > section {
    padding: 104px 0;
    border-bottom: 1px solid var(--line);
  }

  .astrowindy-home .section-head {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 60px;
    margin-bottom: 56px;
  }

  .astrowindy-home .kicker {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 760;
    color: var(--muted);
  }

  .astrowindy-home h2 {
    font-size: clamp(38px, 5vw, 62px);
    line-height: 1;
    letter-spacing: -0.055em;
    margin: 0;
    max-width: 820px;
  }

  .astrowindy-home .section-intro {
    margin-top: 18px;
    color: var(--muted);
    font-size: 18px;
    line-height: 1.55;
    max-width: 720px;
  }

  .astrowindy-home .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .astrowindy-home .card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 30px;
    min-height: 350px;
    display: flex;
    flex-direction: column;
    transition: 0.2s ease;
  }

  .astrowindy-home .card:hover {
    transform: translateY(-3px);
    border-color: #cdd2d8;
    box-shadow: 0 14px 35px rgba(10, 20, 30, 0.06);
  }

  .astrowindy-home .num {
    font-size: 12px;
    color: var(--blue);
    font-weight: 760;
    letter-spacing: 0.08em;
  }

  .astrowindy-home .card h3 {
    font-size: 27px;
    letter-spacing: -0.035em;
    margin: 70px 0 14px;
  }

  .astrowindy-home .card p {
    color: var(--muted);
    line-height: 1.62;
    font-size: 15px;
    margin: 0;
  }

  .astrowindy-home .arrow {
    margin-top: auto;
    padding-top: 25px;
    font-size: 14px;
    font-weight: 700;
    color: var(--blue);
  }

  .astrowindy-home .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line);
  }

  .astrowindy-home .feature {
    padding: 32px 22px 34px 0;
    border-bottom: 1px solid var(--line);
    display: grid;
    grid-template-columns: 54px 1fr;
    gap: 18px;
  }

  .astrowindy-home .feature:nth-child(odd) {
    border-right: 1px solid var(--line);
    padding-right: 38px;
  }

  .astrowindy-home .feature:nth-child(even) {
    padding-left: 38px;
  }

  .astrowindy-home .feature .num {
    padding-top: 4px;
  }

  .astrowindy-home .feature h3 {
    font-size: 21px;
    letter-spacing: -0.025em;
    margin: 0 0 8px;
  }

  .astrowindy-home .feature p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
    font-size: 15px;
  }

  .astrowindy-home .statement {
    background: var(--soft);
    border-radius: 28px;
    padding: 60px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: end;
  }

  .astrowindy-home .statement h2 {
    font-size: clamp(38px, 5vw, 65px);
  }

  .astrowindy-home .statement p {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
    max-width: 500px;
  }

  .astrowindy-home .process {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--line);
  }

  .astrowindy-home .step {
    padding: 28px 26px 10px 0;
    border-right: 1px solid var(--line);
    min-height: 240px;
  }

  .astrowindy-home .step:not(:first-child) {
    padding-left: 25px;
  }

  .astrowindy-home .step:last-child {
    border-right: 0;
