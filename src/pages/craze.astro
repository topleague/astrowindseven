---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';
import StructuredData from '~/components/common/StructuredData.astro';

import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'Top League — Build Your Online Presence, Not Just Another Website',
  ignoreTitleTemplate: true,
  description:
    'Top League helps small businesses build and manage their online presence with websites, content, SEO, social media, analytics and ongoing support.',
};

const organizationId = `${SITE?.site}/#organization`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle
      ? {
          sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`],
        }
      : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- HERO ********************************************************************** -->

  <Hero
    tagline="Digital partner for small businesses"
    title="Build Your Online Presence, Not Just Another Website."
    subtitle="A website is a means to an end. We help you build the presence around it — and stay involved after launch."
    callToAction={{
      variant: 'primary',
      text: 'Tell us what you need',
      href: '#contact',
      icon: 'tabler:arrow-right',
    }}
    callToAction2={{
      text: 'See how we work',
      href: '#handled',
    }}
  />

  <!-- QUIET PROOF *************************************************************** -->

  <SocialProof
    id="proof"
    items={[
      {
        value: '16 yrs',
        label: 'in business since 2010',
        icon: 'tabler:calendar-check',
        color: 'text-sky-500',
      },
      {
        value: '20',
        label: 'websites maintained today',
        icon: 'tabler:heart-handshake',
        color: 'text-emerald-500',
      },
      {
        value: '10',
        label: 'countries with clients',
        icon: 'tabler:world',
        color: 'text-amber-500',
      },
      {
        value: '4–8 hrs',
        label: 'typical email response',
        icon: 'tabler:clock-bolt',
        color: 'text-violet-500',
      },
    ]}
  />

  <!-- OWNERSHIP **************************************************************** -->

  <Features2
    id="handled"
    tagline="What having someone own it means"
    title="You ask. We handle it."
    subtitle="The website is only one part of the job. The useful part is having someone who keeps the whole thing moving."
    columns={3}
    items={[
      {
        title: '“Here’s our new blog post. Please publish it.”',
        description:
          'We format it, optimise it, publish it and send you the link.',
        icon: 'tabler:article',
      },
      {
        title: '“We have a campaign next month.”',
        description:
          'We create the landing page and get it ready to use, usually within a few days.',
        icon: 'tabler:rocket',
      },
      {
        title: '“Here’s some raw content. Make it social.”',
        description:
          'We turn it into posts, graphics or reels and help get it published.',
        icon: 'tabler:brand-instagram',
      },
      {
        title: '“Our domain is expiring.”',
        description:
          'Domains, hosting, plugins, updates and the technical details stay on our radar.',
        icon: 'tabler:shield-check',
      },
      {
        title: '“What’s happening with our SEO?”',
        description:
          'You get understandable reporting and a clear explanation of what is happening.',
        icon: 'tabler:chart-line',
      },
      {
        title: '“We need a website.”',
        description:
          'Most WordPress sites are ready in 10–14 days. Serious custom work takes longer.',
        icon: 'tabler:world-www',
      },
    ]}
  />

  <!-- CLIENT FEELING *********************************************************** -->

  <Note
    title="The feeling we aim for:"
    description="“I don’t have to worry about anything anymore.”"
  />

  <!-- WHY A WEBSITE ALONE IS NOT ENOUGH *************************************** -->

  <Content
    tagline="Start with the business"
    title="A website is a means to an end, not an end in itself."
    items={[
      {
        title: 'Your domain affects your brand',
        description:
          'A rushed domain choice can create branding problems later. We think about the name, positioning and practical implications before everything is locked in.',
      },
      {
        title: 'Your website needs a job',
        description:
          'Is it supposed to generate enquiries, explain your services, support sales, attract search traffic or establish credibility? The answer shapes what we build.',
      },
      {
        title: 'Your online presence has more than one moving part',
        description:
          'Website, content, search, social and measurement should support the same business objective instead of becoming disconnected activities.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1556761175-b413da4baf72?auto=format&fit=crop&w=1600&q=80',
      alt: 'People discussing a business project',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Think beyond the website.
      </h3>
      <p>
        We start by understanding the business, audience, goals and budget.
        Then we work out what the digital presence actually needs.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- THE REAL STORY *********************************************************** -->

  <Content
    isReversed
    tagline="A lesson we learned with a client"
    title="The expensive mistake can happen before the website goes live."
    items={[
      {
        title: 'The domain and logo looked right',
        description:
          'The client had chosen the name and identity they wanted and the website was built around them.',
      },
      {
        title: 'Then came a trademark problem',
        description:
          'After launch, they received notice that the name conflicted with an existing trademark.',
      },
      {
        title: 'The brand had to change',
        description:
          'The domain and logo had to be abandoned, creating unnecessary cost, work and confusion.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&w=1600&q=80',
      alt: 'Business documents and planning',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Good digital work starts before the pixels.
      </h3>
      <p>
        The point is not to make every decision complicated. It is to make the
        important decisions early, when changing them is still easy.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- HOW WE WORK ************************************************************* -->

  <Steps
    id="how"
    tagline="How it starts"
    title="From idea to online, without the runaround."
    subtitle="You stay in the driver's seat. We do the work and explain what matters."
    items={[
      {
        title: 'Step 1: <span class="font-medium">Tell us the business, goal and budget</span>',
        description:
          'We ask the questions that matter instead of starting with a giant technical proposal.',
        icon: 'tabler:message-circle',
      },
      {
        title: 'Step 2: <span class="font-medium">We shape what you actually need</span>',
        description:
          'Website, content, SEO, social or ongoing support — only the pieces that make sense for the business.',
        icon: 'tabler:package',
      },
      {
        title: 'Step 3: <span class="font-medium">We build and publish</span>',
        description:
          'Most WordPress websites are live in 10–14 days when feedback keeps pace.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Step 4: <span class="font-medium">We stay involved</span>',
        description:
          'Maintenance, publishing, SEO, campaigns, analytics and the inevitable small fixes continue when you need them.',
        icon: 'tabler:refresh',
      },
    ]}
  />

  <!-- CAPABILITIES ************************************************************ -->

  <Features
    id="capabilities"
    tagline="What sits behind the work"
    title="The skills that make “handled” possible."
    subtitle="You do not have to hire a separate person for every part of your online presence."
    columns={4}
    items={[
      {
        title: 'Websites',
        description:
          'WordPress websites built to be useful, maintainable and ready to grow.',
        icon: 'tabler:layout-dashboard',
      },
      {
        title: 'Content',
        description:
          'More than 1,000 pieces of website content written across different businesses and markets.',
        icon: 'tabler:pencil',
      },
      {
        title: 'SEO',
        description:
          'Long experience adapting to how search works. One site returned from page four to page one in about two weeks.',
        icon: 'tabler:search',
      },
      {
        title: 'Social & reporting',
        description:
          'Campaigns across Facebook, Instagram and X, with analytics explained in plain language.',
        icon: 'tabler:chart-bar',
      },
    ]}
  />

  <!-- OWNERSHIP NOTE ********************************************************** -->

  <Note
    title="One team. One point of responsibility."
    description="You should not have to figure out which vendor is responsible for the thing that went wrong."
  />

  <!-- EXPERIENCE **************************************************************** -->

  <Stats
    id="experience"
    tagline="Experience, in numbers"
    title="Sixteen years of doing the work."
    subtitle="The strongest proof is that clients keep coming back."
    countUp
    stats={[
      {
        amount: '16 yrs',
        title: 'in business since 2010',
      },
      {
        amount: '30+',
        title: 'websites built in recent years',
      },
      {
        amount: '20',
        title: 'websites currently maintained',
      },
      {
        amount: '7 yrs',
        title: 'with our longest-serving client',
      },
    ]}
  />

  <!-- CLIENT WORDS ************************************************************ -->

  <Content
    tagline="What clients notice"
    title="Good work is useful. Good support is memorable."
    items={[
      {
        title: '“They understood what I was trying to do.”',
        description:
          'Understanding the business before building the website is part of the work.',
      },
      {
        title: '“You guys respond incredibly quickly.”',
        description:
          'Most emails get a response within 4–8 hours.',
      },
      {
        title: '“The website was delivered surprisingly quickly.”',
        description:
          'Speed matters when you are trying to get a business online and moving.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=1600&q=80',
      alt: 'Business team working together',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Personal service is not a slogan.
      </h3>
      <p>
        It means the people you speak to understand the work, know the context
        and are still around when the site has been live for years.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- FAQ ************************************************************************ -->

  <FAQs
    id="faqs"
    tagline="Fair questions"
    title="What founders usually want to know."
    subtitle="Straight answers before you decide whether we are the right fit."
    schema
    items={[
      {
        title: 'Will I have to chase you?',
        description:
          'Most emails get a response within 4–8 hours. If we need something from you, we will tell you clearly.',
      },
      {
        title: 'What if I only need a website?',
        description:
          'That is fine. We will build the website. You can add maintenance, content, SEO or other support later if it makes sense.',
      },
      {
        title: 'Do you disappear after launch?',
        description:
          'No. We currently maintain about 20 websites, and our longest client relationship has lasted seven years.',
      },
      {
        title: 'Can you handle domains, hosting and updates?',
        description:
          'Yes. Domain renewals, hosting, plugin updates, maintenance and fixes can all be handled by us.',
      },
      {
        title: 'Are you a large agency?',
        description:
          'No. We are deliberately lean. That means direct communication, founder involvement and fewer layers between you and the work.',
      },
      {
        title: 'How do I know what is working?',
        description:
          'We provide straightforward reporting and can explain the numbers rather than simply sending a dashboard full of jargon.',
      },
    ]}
  />

  <!-- FINAL CTA **************************************************************** -->

  <CallToAction
    id="contact"
    layout="banner"
    title="Tell us what you need. We’ll tell you what makes sense."
    subtitle="Start with your business, your goal and your budget. We’ll reply within a few hours."
    actions={[
      {
        variant: 'primary',
        text: 'Start a conversation',
        href: 'mailto:hello@topleaguetech.com',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
