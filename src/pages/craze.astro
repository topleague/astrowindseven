---
import Layout from '~/layouts/PageLayout.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'Top League Technologies — Build Your Online Presence, Not Just Another Website',
  description:
    'Top League helps small businesses build and manage their online presence through websites, content, SEO, social media and ongoing support.',
};

const organizationId = `${SITE?.site}/#organization`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle
      ? {
          sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`],
        }
      : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- HERO ******************************************************************** -->

  <section class="hero">
    <div class="container">
      <div class="eyebrow">
        <span class="dot"></span>
        Digital partner for small businesses
      </div>

      <h1>
        Build Your Online Presence,
        <span>Not Just Another Website.</span>
      </h1>

      <p>
        Your website, content, SEO and social presence should work together.
        We help you plan it, build it and keep it moving — with one team
        taking responsibility for the whole thing.
      </p>

      <div class="actions">
        <a class="btn primary" href="#contact">
          Tell us what you're building
        </a>

        <a class="btn ghost" href="#work">
          See our work
        </a>
      </div>

      <div class="hero-note">
        Founder-led · WordPress · Ongoing support · 16 years in digital
      </div>
    </div>
  </section>

  <!-- PROOF BAR **************************************************************** -->

  <div class="proofbar">
    <div class="wrap proofgrid">
      <div class="proof">
        <strong>16 years</strong>
        <span>in digital</span>
      </div>

      <div class="proof">
        <strong>30+</strong>
        <span>websites built recently</span>
      </div>

      <div class="proof">
        <strong>20</strong>
        <span>websites maintained</span>
      </div>

      <div class="proof">
        <strong>10 countries</strong>
        <span>clients served</span>
      </div>
    </div>
  </div>

  <!-- THE OUTCOME ************************************************************* -->

  <Note
    title="The goal isn't to give you another thing to manage."
    description="It's to get your online presence working — and give you someone you can turn to when something needs to be done."
  />

  <!-- WHAT THAT ACTUALLY LOOKS LIKE ******************************************* -->

  <Features
    id="ownership"
    tagline="What ownership looks like"
    title="You shouldn't have to worry about your online presence."
    subtitle="Send us the request. We figure out what needs to happen and take it from there."
    items={[
      {
        title: '“We have a new blog post.”',
        description: 'Send it over. We publish it and make sure it is properly presented.',
        icon: 'tabler:article',
      },
      {
        title: '“We need a landing page.”',
        description: 'Tell us what the campaign is about. We build the page around it.',
        icon: 'tabler:layout-landing',
      },
      {
        title: '“What is happening with our SEO?”',
        description: 'We look at the data, explain what matters and tell you what to do next.',
        icon: 'tabler:chart-line',
      },
      {
        title: '“Our domain is expiring.”',
        description: 'You shouldn't have to remember. We handle the important details.',
        icon: 'tabler:world-www',
      },
    ]}
  />

  <!-- THE PROBLEM ************************************************************* -->

  <Content
    id="why"
    tagline="Before you build"
    title="A website is a means to an end, not an end in itself."
    items={[
      {
        title: 'The decisions start before the website does.',
        description:
          'Your domain, hosting, brand, content, search terms and social presence all influence what you build — and how much it costs to change later.',
      },
      {
        title: 'We start with the business.',
        description:
          'We talk about what you do, who you want to reach, what you are trying to achieve and what makes sense for your budget.',
      },
      {
        title: 'Then we build accordingly.',
        description:
          'You understand where the money is going and why. You stay in the driver’s seat; we take care of the execution.',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Start with the business. Not the website.
      </h3>

      <p>
        The earlier you think about the whole online presence, the fewer
        expensive decisions you have to undo later.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- THE STORY **************************************************************** -->

  <Content
    isReversed
    tagline="A real example"
    title="One client learned this the hard way."
    items={[
      {
        title: 'The website was ready. Then came the problem.',
        description:
          'The client had chosen a domain and logo before we built the website. After launch, they received a trademark violation notice.',
      },
      {
        title: 'The domain and logo had to go.',
        description:
          'The website itself was not the issue. But an early branding decision meant starting over with the domain and identity.',
      },
      {
        title: 'The lesson?',
        description:
          'Some digital decisions are expensive to undo. Thinking about the whole presence first can save a lot of trouble later.',
      },
    ]}
    image={{
      src: 'https://lh3.googleusercontent.com/pw/AP1GczMZPdz6rBhGolu4Sup_uaM-RQEmY71hy9A5NZ95vMCW3bVWe1RJnjCbV1uuNGDa3u12FEwkVCno33Jk4ePoZoN9WSONXsFiE5vta479W1em0XrGM6DVQ9_iFsosElqYgPwC9k2OznU4hK_rCFMIl3vH=w1100-h1280-s-no?authuser=2',
      alt: 'Website designed and developed by Top League',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Good digital work starts before the first line of code.
      </h3>

      <p>
        That is why we look at the bigger picture before recommending a
        particular platform, theme, domain or approach.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- WORK ******************************************************************** -->

  <Content
    id="work"
    isAfterContent
    tagline="Recent work"
    title="Built around the business. Not around a template."
    items={[
      {
        title: 'Purbaghat Masala',
        description:
          'A custom WordPress child theme built around the brand, with close page-by-page collaboration and carefully selected imagery.',
      },
      {
        title: 'A digital presence that feels like the business.',
        description:
          'The objective was not simply to fill a template. It was to create a website that represented the business properly and gave it room to grow.',
      },
    ]}
    image={{
      src: 'https://lh3.googleusercontent.com/pw/AP1GczO2mF7OkWlBFsndCMBQPCNfaNwbaDcRPSllAoTBgjFix7Ri07eXyPEcZz06baPwopTQ2MzbjaApAlmDAgXMcMhSULVSEc0tRLmpjlfJlfzdjy7HocnspeX4inLoyuNtIjE1hyOSVafxCGeOczwoMVBl=w2055-h2332-s-no?authuser=2',
      alt: 'Purbaghat Masala website designed by Top League',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        See more of our work
      </h3>

      <a
        href="https://topleague.website/work/"
        class="font-semibold hover:underline"
        target="_blank"
        rel="noopener noreferrer"
      >
        Browse our website portfolio →
      </a>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- WHAT WE HANDLE ********************************************************** -->

  <Features
    tagline="What we handle"
    title="One team across the pieces."
    subtitle="You don't need to coordinate a web developer, content writer, SEO person and social media manager. We can handle the connected work."
    items={[
      {
        title: 'Website',
        description:
          'WordPress websites and landing pages built around your goals, audience and brand.',
        icon: 'tabler:world-www',
      },
      {
        title: 'Content',
        description:
          'Website copy, blog content and social content that sounds like your business.',
        icon: 'tabler:writing',
      },
      {
        title: 'SEO',
        description:
          'From keyword strategy and on-page work to ongoing improvement and reporting.',
        icon: 'tabler:search',
      },
      {
        title: 'Social',
        description:
          'Content and campaigns across the social channels that matter to your audience.',
        icon: 'tabler:brand-instagram',
      },
      {
        title: 'Analytics',
        description:
          'Clear reporting that helps you understand what is happening and what to do next.',
        icon: 'tabler:chart-dots',
      },
      {
        title: 'Ongoing support',
        description:
          'Hosting, domains, maintenance, updates, publishing and the everyday things that keep it moving.',
        icon: 'tabler:headset',
      },
    ]}
  />

  <!-- TESTIMONIALS ************************************************************ -->

  <Note
    title="“I've been incredibly impressed with Top League's website development services.”"
    description="“They were affordable, professional, and delivered exactly what I needed. They also provided excellent support throughout the entire process, and I continue to rely on them for ongoing maintenance.”"
  />

  <Note
    title="“What distinguishes them is their rapid support.”"
    description="“Any inquiries or challenges we encountered were promptly resolved, keeping our project on schedule. We wholeheartedly recommend Top League to anyone seeking to enhance their online presence with a skilled and attentive team.”"
  />

  <!-- PROOF / RESULTS ********************************************************* -->

  <Stats
    id="results"
    stats={[
      { title: 'Years in digital', amount: '16' },
      { title: 'Websites built recently', amount: '30+' },
      { title: 'Websites maintained', amount: '20' },
      { title: 'Countries served', amount: '10' },
    ]}
  />

  <Content
    isReversed
    tagline="Results"
    title="When something needs fixing, we stay with it."
    items={[
      {
        title: 'Page 4 → Page 1',
        description:
          'One website that had dropped to Google page 4 returned to page 1 in about two weeks through focused SEO work.',
      },
      {
        title: 'Long-term relationships',
        description:
          'Our oldest continuing client relationship is seven years — and many clients stay because they know there is someone to call.',
      },
      {
        title: 'Fast answers',
        description:
          'Typical email response time is 4–8 hours. When something needs attention, you should not have to chase us.',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        The real value is what happens after launch.
      </h3>

      <p>
        A website can be launched in a few weeks. Your online presence needs
        someone looking after it for much longer.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- FOUNDER / RELATIONSHIP ************************************************** -->

  <Note
    title="Founder-led. Personally involved."
    description="Top League is a lean, founder-led team. That means the people involved in understanding your business are close to the work, the decisions and the communication — not hidden behind layers of account management."
  />

  <!-- FAQ ********************************************************************* -->

  <FAQs
    id="faqs"
    title="Questions before you start"
    subtitle="A few practical answers for business owners considering a new website or a broader online presence."
    tagline="FAQs"
    schema
    items={[
      {
        title: 'How long does a typical website take?',
        description:
          'A typical WordPress website takes around 10–14 days. More serious custom work can take around a month. A focused landing page can usually be completed in 3–5 days when feedback is timely.',
      },
      {
        title: 'Do you only build websites?',
        description:
          'No. The website is one part of what we do. We also work across content, SEO, social media, analytics and ongoing maintenance so the different parts of your online presence can work together.',
      },
      {
        title: 'Do you provide ongoing support?',
        description:
          'Yes. Clients can rely on us for things such as domain renewal, hosting, plugin maintenance, publishing blog posts, graphics and social posts, SEO, campaigns and analytics reporting.',
      },
      {
        title: 'Who do you typically work with?',
        description:
          'We primarily work with small businesses, founders, entrepreneurs, professionals, NGOs and educational or professional institutions — especially where the owner or founder is directly involved in the decision.',
      },
      {
        title: 'Do I need to know exactly what I want before contacting you?',
        description:
          'No. Tell us what you are trying to achieve, what you already have and what you are unsure about. We can help you work out what actually needs to be built.',
      },
      {
        title: 'How quickly do you respond?',
        description:
          'Our typical email response time is 4–8 hours. Response time can vary depending on the request, but you should not have to wait days to hear from us.',
      },
    ]}
  />

  <!-- CTA ********************************************************************* -->

  <CallToAction id="contact">
    <Fragment slot="title">
      Have an idea?<br class="block sm:hidden" />
      <span class="sm:whitespace-nowrap">Tell us what you're building.</span>
    </Fragment>

    <Fragment slot="subtitle">
      Tell us what you are trying to achieve. We'll tell you what we'd do —
      and what we wouldn't. <br class="hidden md:inline" />
      Typical response within 4–8 hours.
    </Fragment>

    <Fragment slot="actions">
      <a
        href="/contact/"
        class="btn primary"
      >
        Tell us about your project
      </a>
    </Fragment>
  </CallToAction>
</Layout>
