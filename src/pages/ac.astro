---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About us',
  description:
    'About Top League Technologies: a small, hands-on team in Bhubaneswar, India, crafting content and websites for clients across the globe.',
};

const contactLink = 'https://topleaguetech.com/contact/';

const stats = [
  { n: 16, l: 'years in digital' },
  { n: 30, s: '+', l: 'websites built recently' },
  { n: 20, l: 'websites currently maintained' },
  { n: 10, l: 'countries, clients served' },
];

const journey = [
  { dot: '2006', k: 'Industry experience', t: 'Where it began', d: 'Working with business content starts.' },
  { dot: '2010', k: 'Top League', t: 'A small, scrappy team', d: 'Set up in Bhubaneswar, India, with one goal: content that ranks and resonates.' },
  { dot: 'Now', k: 'Today', t: 'Tight-knit, worldwide', d: 'A two-person team working with clients from across the globe.' },
  { dot: '∞', k: 'Always', t: 'Every word counts', d: 'Every word we write, every idea we shape, every client we help grow.' },
];

const people = [
  {
    name: 'Susanta',
    role: 'Founder / Chief Blogger',
    bio: 'He’s worked with small businesses, translating their ideas into content.',
    img: 'https://topleaguetech.com/wp-content/uploads/2021/09/Untitled-drawing-2.png',
  },
  {
    name: 'Meera',
    role: 'Senior Content Writer',
    bio: 'She creates well-researched, SEO-friendly articles that rank high.',
    img: 'https://topleaguetech.com/wp-content/uploads/2022/08/Untitled-design-1.png',
  },
];

const quotes = [
  {
    t: 'Accomplished Great Results!',
    q: 'If you are in search of good SEO articles, look no further. At Top League you will find the best team of content writers in the internet. I have been using their services for over a year and have accomplished great results in my online marketing campaign.',
    name: 'Roberto',
    job: 'Founder / Polo Mercantile',
  },
  {
    t: 'Always the Best!',
    q: 'Top League have been excellent at presenting their work and work very hard to ensure that the quality of their work is always the best! Thank you Top League! I look forward to continuing our business together.',
    name: 'Michael',
    job: 'Founder / Idea Bubble',
  },
  {
    t: 'Very Professional!',
    q: 'Top League is the only company I use for my article writing needs. They are very professional and work with you throughout the project with constant updates. I recommend their services to anyone considering outsourcing their content writing.',
    name: 'Daniel',
    job: 'Founder / Future Success',
  },
  {
    t: 'Readily Available!',
    q: 'Top League did a great job writing content for our website. They followed our direction very closely and were readily available for every stage of the project. I would highly recommend their writing skills and will be utilizing their services again. Great Job!',
    name: 'Jason Hamblin',
    job: 'Sr. Executive / L2T Media',
  },
  {
    t: 'Over Delivered!',
    q: 'Top League over delivered on the articles we asked for. They were well written, concise & well optimized for search. We will continue to utilize their services.',
    name: 'Sean',
    job: 'Founder / Acquisition Engine',
  },
  {
    t: 'An Excellent Job!',
    q: 'The team did an excellent job on content creation for our appliance repair website. They must have done a thorough research on this topic because everything was written very professionally.',
    name: 'Alex Garayev',
    job: 'Founder / SD Appliances',
  },
];

const initials = (name: string) =>
  name
    .trim()
    .split(/\s+/)
    .map((w) => w[0])
    .slice(0, 2)
    .join('')
    .toUpperCase();

const marquee = ['Storytelling', 'Content', 'Search', 'Websites', 'Results'].join(' ✦ ') + ' ✦ ';

// Scattered "client" dots for the hero map (x, y, twinkle delay)
const dots = [
  [64, 88, 0], [128, 168, 1.2], [92, 300, 2.1], [168, 392, 0.6], [214, 70, 2.8], [380, 60, 1.5],
  [462, 132, 0.3], [492, 262, 2.4], [440, 366, 1.1], [330, 420, 3.1], [88, 232, 3.4], [352, 150, 0.9],
  [196, 336, 1.9], [420, 238, 2.7],
];
const links = [dots[1], dots[5], dots[7], dots[8], dots[2]];
---

<Layout metadata={metadata} pageClass="product-description-page">

  <script is:inline>
    document.documentElement.classList.add('sx-js');
    // Safety net: if the page script ever fails to start, show everything.
    setTimeout(function () {
      if (!document.querySelector('.sx-page[data-sx-ready]')) document.documentElement.classList.remove('sx-js');
    }, 4000);
  </script>

  <div class="sx-page">
    <div class="sx-progress" aria-hidden="true"><span></span></div>

    <!-- 1. HERO -->
    <section class="sx-hero">
      <div class="sx-wrap sx-hero-grid">
        <div class="sx-hero-copy">
          <div class="sx-pill"><span class="sx-dot"></span> About us</div>

          <h1>
            Crafting Words that
            <span>Drive Results</span>
          </h1>

          <p>Customer-focused approach to deliver the best results possible.</p>

          <div class="sx-actions">
            <a class="sx-btn sx-btn-primary" href={contactLink}>Contact us <i>↗</i></a>
            <a class="sx-btn sx-btn-ghost" href="#team">Meet the team <i>↓</i></a>
          </div>

          <div class="sx-note">Bhubaneswar, India · Clients across the globe</div>
        </div>

        <div
          class="sx-stage"
          role="img"
          aria-label="Illustration: a glowing point for Bhubaneswar, India, with lines reaching out to clients around the world."
        >
          <svg viewBox="0 0 540 460" aria-hidden="true">
            <circle class="sx-rip" cx="270" cy="240" r="210" style="--d:0s" />
            <circle class="sx-rip" cx="270" cy="240" r="210" style="--d:2s" />
            <circle class="sx-rip" cx="270" cy="240" r="210" style="--d:4s" />
            <circle class="sx-ring2" cx="270" cy="240" r="170" />

            {links.map(([x, y]) => <line class="sx-link" x1="270" y1="240" x2={x} y2={y} />)}
            {dots.map(([x, y, d]) => <circle class="sx-dotc" cx={x} cy={y} r="3.5" style={`--d:${d}s`} />)}

            <g class="sx-spin" style="--ox:270px;--oy:240px;--t:18s">
              <circle class="sx-spark2" cx="270" cy="70" r="6" />
            </g>

            <circle class="sx-origin" cx="270" cy="240" r="9" />
            <text class="sx-svgt-s" x="270" y="278">BHUBANESWAR, INDIA</text>
          </svg>

          <span class="sx-pin" style="left:0;top:6%"><b>2006</b> Industry experience</span>
          <span class="sx-pin" style="right:0;top:44%"><b>2010</b> Top League begins</span>
          <span class="sx-pin" style="left:4%;bottom:4%"><b>2</b> people, worldwide clients</span>
        </div>
      </div>
    </section>

    <!-- 2. NUMBERS -->
    <section class="sx-proof">
      <div class="sx-wrap sx-proof-grid">
        <div class="sx-proof-lead sx-reveal">A small team.<br />A long track record.</div>
        <div class="sx-stats">
          {stats.map((s, i) => (
            <div class="sx-stat sx-reveal" style={`--d:${i * 0.08}s`}>
              <div class="sx-num"><span data-sx-count={s.n}>{s.n}</span>{s.s}</div>
              <div class="sx-stat-l">{s.l}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. THE STORY -->
    <section class="sx-section sx-story" id="story">
      <span class="sx-bignum" aria-hidden="true">2010</span>
      <div class="sx-wrap sx-story-grid">

        <div class="sx-sticky">
          <div class="sx-kicker sx-reveal">About us</div>
          <h2 class="sx-h2 sx-reveal">Every great story starts with a spark of inspiration.</h2>
          <blockquote class="sx-pull sx-reveal">
            For us, that spark was simple: a love for storytelling and a desire to help businesses find their voice online.
          </blockquote>
        </div>

        <div class="sx-copy">
          <p class="sx-reveal">
            Back in 2010, when content was just beginning to rule the digital world, we set out to craft words that could make an impact. Armed with passion (and a whole lot of coffee), we started as a small, scrappy team in Bhubaneswar, India, driven by one goal: to create content that <strong>not only ranks but also resonates.</strong>
          </p>
          <p class="sx-reveal" style="--d:.1s">
            What started as a solo venture has since grown into a <strong>tight-knit, two-person team</strong> that works with clients from across the globe, helping businesses tell their unique stories and get the attention they deserve.
          </p>
          <p class="sx-reveal" style="--d:.2s">
            Whether it’s an SEO-friendly blog post or a carefully crafted social media campaign, we take pride in every word we write, every idea we shape, and every client we help grow.
          </p>
        </div>

      </div>
    </section>

    <!-- 4. HOW WE GOT HERE -->
    <section class="sx-section sx-alt" id="journey">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">How we got here</div>
          <h2 class="sx-h2 sx-reveal">From a spark in Bhubaneswar to clients across the globe.</h2>
        </div>

        <ol class="sx-tl sx-watch" style={`--n:${journey.length}`}>
          {journey.map((s) => (
            <li>
              <span class="sx-tl-dot">{s.dot}</span>
              <div class="sx-tl-k">{s.k}</div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5. THE TEAM -->
    <section class="sx-section" id="team">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">The people</div>
          <h2 class="sx-h2 sx-reveal">Meet the team</h2>
        </div>

        <div class="sx-people">
          {people.map((p, i) => (
            <article class="sx-pcard sx-reveal" style={`--d:${i * 0.1}s`}>
              <div class="sx-photo">
                <img src={p.img} alt={p.name} width="360" height="360" loading="lazy" decoding="async" />
              </div>
              <div>
                <h3 class="sx-pname">{p.name}</h3>
                <div class="sx-prole">{p.role}</div>
                <p>{p.bio}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. CLIENT WORDS -->
    <section class="sx-section sx-night" id="proof">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">Client feedback</div>
          <h2 class="sx-h2 sx-reveal">Words from real customers</h2>
        </div>

        <div class="sx-quotes">
          {quotes.map((q, i) => (
            <article class="sx-quote sx-reveal" style={`--d:${i * 0.08}s`}>
              <div class="sx-stars" role="img" aria-label="5 out of 5 stars">★★★★★</div>
              <div class="sx-quote-t">{q.t}</div>
              <p>“{q.q}”</p>
              <div class="sx-person">
                <span class="sx-av" aria-hidden="true">{initials(q.name)}</span>
                <div class="sx-who">
                  <b>{q.name}</b>
                  <span>{q.job}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. MARQUEE -->
    <div class="sx-marquee" aria-hidden="true">
      <div class="sx-marquee-track">
        <span>{marquee}</span>
        <span>{marquee}</span>
        <span>{marquee}</span>
        <span>{marquee}</span>
      </div>
    </div>

    <!-- 8. CTA -->
    <section class="sx-cta" id="contact">
      <div class="sx-wrap">
        <div class="sx-cta-card sx-reveal">
          <div>
            <div class="sx-kicker sx-kicker-lime">Let's talk</div>
            <h2>Have a story to tell?</h2>
            <p>Whether it’s an SEO-friendly blog post or a carefully crafted social media campaign, we take pride in every word we write.</p>
          </div>
          <a class="sx-btn sx-btn-primary sx-btn-lg" href={contactLink}>Contact us <i>↗</i></a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style is:global>
.sx-page {
    --bg: #fff; --alt: #f1f4f2; --ink: #16202a; --muted: #566470; --line: #dfe5e8; --card: #fff;
    --red: #b34a43; --green: #1f5f55; --lime: #d9ff43; --night: #17242b; --night-2: #0f1a1f;
    color: var(--ink); background: var(--bg); overflow-x: clip; position: relative;
  }
.dark .sx-page {
    --bg: #1e293b; --alt: #172033; --ink: #f8fafc; --muted: #cbd5e1; --line: #334155; --card: #243247;
  }
.sx-page p { color: var(--muted); }
.sx-page .sx-wrap { max-width: 1180px; margin-inline: auto; padding-inline: 20px; }
.sx-page .sx-section { padding: clamp(72px, 9vw, 120px) 0; background: var(--bg); position: relative; }
.sx-page .sx-alt { background: var(--alt); border-block: 1px solid var(--line); }
.sx-page .sx-progress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 70; pointer-events: none; }
.sx-page .sx-progress span { display: block; height: 100%; background: var(--lime); transform: scaleX(0); transform-origin: 0 50%; }
.sx-js .sx-page .sx-reveal:not(.is-in) { opacity: 0; transform: translateY(22px); }
.sx-page .sx-reveal { transition: opacity .7s ease, transform .7s cubic-bezier(.2, .8, .2, 1); transition-delay: var(--d, 0s); }
.sx-page .sx-kicker { font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--red); margin-bottom: 18px; }
.sx-page .sx-kicker-lime { color: var(--lime); }
.sx-page .sx-h2 { font-size: clamp(34px, 4.6vw, 60px); line-height: 1.04; margin: 0 0 20px; color: var(--ink); max-width: 16ch; }
.sx-page .sx-head .sx-h2 { max-width: 20ch; }
.sx-page .sx-head { margin-bottom: 56px; max-width: 760px; }
.sx-page .sx-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 15px 24px; border-radius: 999px;
    font-weight: 700; font-size: 15px; text-decoration: none; transition: transform .25s ease, background .25s ease, box-shadow .25s ease;
    border: 1px solid transparent; line-height: 1.2; cursor: pointer;
  }
.sx-page .sx-btn i { font-style: normal; display: inline-block; transition: transform .25s ease; }
.sx-page .sx-btn:hover i { transform: translate(3px, -3px); }
.sx-page .sx-btn:hover { transform: translateY(-2px); }
.sx-page .sx-btn-primary { background: var(--lime); color: #17242b; box-shadow: 0 10px 30px -10px rgba(217, 255, 67, .55); }
.sx-page .sx-btn-primary:hover { box-shadow: 0 16px 36px -10px rgba(217, 255, 67, .75); }
.sx-page .sx-btn-ghost { color: #fff; border-color: rgba(255, 255, 255, .35); }
.sx-page .sx-btn-ghost:hover { background: rgba(255, 255, 255, .08); }
.sx-page .sx-btn-lg { padding: 18px 30px; font-size: 16px; white-space: nowrap; }
.sx-page .sx-hero {
    position: relative; overflow: hidden; color: #fff; padding: 150px 0 90px;
    background:
      radial-gradient(900px 520px at 88% 8%, rgba(217, 255, 67, .13), transparent 60%),
      radial-gradient(700px 520px at 0% 100%, rgba(179, 74, 67, .25), transparent 60%),
      linear-gradient(120deg, #0f1a1f, #17242b 55%, #1f3038);
  }
.sx-page .sx-hero::before {
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background-image: linear-gradient(rgba(255, 255, 255, .06) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .06) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse at 60% 40%, #000 10%, transparent 70%);
    mask-image: radial-gradient(ellipse at 60% 40%, #000 10%, transparent 70%);
  }
.sx-page .sx-hero-grid { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; gap: 40px; align-items: center; }
.sx-page .sx-pill {
    display: inline-flex; align-items: center; gap: 10px; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; font-weight: 700;
    padding: 8px 14px; border-radius: 999px; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .16); margin-bottom: 28px;
  }
.sx-page .sx-dot { width: 8px; height: 8px; border-radius: 50%; background: #b9db1c; box-shadow: 0 0 0 0 rgba(185, 219, 28, .7); animation: sx-ping 2s infinite; }
.sx-page .sx-hero h1 {
    font-size: clamp(46px, 6.4vw, 92px); line-height: 1; letter-spacing: -.045em; margin: 0 0 26px; color: #fff; max-width: 11ch;
  }
.sx-page .sx-hero h1 span {
    display: block; color: var(--lime);
    background: linear-gradient(transparent 82%, rgba(217, 255, 67, .22) 82%); width: fit-content;
  }
.sx-page .sx-hero p { font-size: clamp(18px, 1.7vw, 21px); line-height: 1.55; color: rgba(255, 255, 255, .8); max-width: 34em; margin: 0 0 34px; }
.sx-page .sx-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.sx-page .sx-note { margin-top: 26px; font-size: 13px; color: rgba(255, 255, 255, .6); }
.sx-page .sx-proof { background: #0f1a1f; color: #fff; padding: 64px 0; border-top: 1px solid rgba(255, 255, 255, .08); }
.sx-page .sx-proof-grid { display: grid; grid-template-columns: 1fr 1.7fr; gap: 48px; align-items: center; }
.sx-page .sx-proof-lead { font-size: clamp(24px, 2.8vw, 36px); line-height: 1.15; letter-spacing: -.03em; font-weight: 700; font-family: 'Mona Bold', 'Mona Reg', sans-serif; }
.sx-page .sx-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.sx-page .sx-stat { border-left: 1px solid rgba(255, 255, 255, .16); padding-left: 18px; }
.sx-page .sx-num { font-family: 'Mona Bold Pro Max', 'Mona Bold', sans-serif; font-size: clamp(38px, 4.4vw, 58px); line-height: 1; color: var(--lime); letter-spacing: -.04em; }
.sx-page .sx-stat-l { margin-top: 10px; font-size: 13px; line-height: 1.4; color: rgba(255, 255, 255, .65); }
.sx-page .sx-night { background: linear-gradient(150deg, #0f1a1f, #17242b 60%, #1a2d33); color: #fff; overflow: hidden; }
.sx-page .sx-night::before { content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5; background-image: radial-gradient(rgba(255, 255, 255, .1) 1px, transparent 1px); background-size: 22px 22px; -webkit-mask-image: radial-gradient(ellipse at 20% 50%, #000, transparent 70%); mask-image: radial-gradient(ellipse at 20% 50%, #000, transparent 70%); }
.sx-page .sx-night .sx-wrap { position: relative; }
.sx-page .sx-night .sx-h2 { color: #fff; }
.sx-page .sx-night .sx-lead { color: rgba(255, 255, 255, .75); }
.sx-page .sx-night .sx-p-t { color: #fff; }
.sx-page .sx-night .sx-p-d { color: rgba(255, 255, 255, .7); }
.sx-page .sx-path .sx-btn { margin-top: auto; align-self: flex-start; }
.sx-page .sx-marquee { background: var(--lime); color: #17242b; overflow: hidden; border-block: 1px solid rgba(23, 36, 43, .2); padding: 18px 0; white-space: nowrap; }
.sx-page .sx-marquee-track { display: inline-flex; animation: sx-marquee 34s linear infinite; }
.sx-page .sx-marquee span { font-family: 'Mona Bold Pro Max', 'Mona Bold', sans-serif; font-size: clamp(36px, 6vw, 76px); line-height: 1; letter-spacing: -.04em; text-transform: uppercase; padding-right: .4em; }
.sx-page .sx-marquee:hover .sx-marquee-track { animation-play-state: paused; }
.sx-page .sx-cta { background: var(--night); padding: clamp(60px, 8vw, 110px) 0; }
.sx-page .sx-cta-card {
    position: relative; overflow: hidden; border-radius: 32px; padding: clamp(34px, 6vw, 80px); color: #fff; display: grid; grid-template-columns: 1.5fr auto; gap: 40px; align-items: end;
    background: radial-gradient(600px 300px at 100% 0%, rgba(217, 255, 67, .16), transparent 60%), #0f1a1f; border: 1px solid rgba(255, 255, 255, .1);
  }
.sx-page .sx-cta-card::after { content: ""; position: absolute; width: 360px; height: 360px; right: -100px; top: -130px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, .14); box-shadow: 0 0 0 60px rgba(255, 255, 255, .035), 0 0 0 120px rgba(255, 255, 255, .025); pointer-events: none; }
.sx-page .sx-cta-card > * { position: relative; z-index: 1; }
.sx-page .sx-cta h2 { font-size: clamp(40px, 6vw, 80px); line-height: .98; letter-spacing: -.05em; margin: 0 0 22px; color: #fff; max-width: 12ch; }
.sx-page .sx-cta p { color: rgba(255, 255, 255, .75); font-size: 19px; line-height: 1.55; max-width: 34em; margin: 0; }
@media (max-width: 980px) {
.sx-page .sx-hero { padding: 120px 0 70px; }
.sx-page .sx-hero-grid,
.sx-page .sx-two,
.sx-page .sx-two-loop,
.sx-page .sx-proof-grid { grid-template-columns: 1fr; }
.sx-page .sx-stats { grid-template-columns: repeat(2, 1fr); row-gap: 28px; }
.sx-page .sx-cta-card { grid-template-columns: 1fr; align-items: start; }
.sx-page .sx-h2,
.sx-page .sx-head .sx-h2 { max-width: none; }
}
@media (prefers-reduced-motion: reduce) {
.sx-page *,
.sx-page *::before,
.sx-page *::after { animation: none !important; transition: none !important; }
.sx-js .sx-page .sx-reveal:not(.is-in) { opacity: 1; transform: none; }
}
.sx-page section[id] { scroll-margin-top: 84px; }
.sx-page .sx-night .sx-kicker { color: var(--lime); }
.sx-page .sx-night .sx-bigq { color: #fff; }
.sx-page .sx-night p { color: rgba(255, 255, 255, .74); }
.sx-page .sx-stage { position: relative; width: 100%; max-width: 560px; margin-inline: auto; }
.sx-page .sx-stage::before {
  content: ""; position: absolute; inset: 6% -6% -4% -6%; z-index: 0; pointer-events: none;
  background: radial-gradient(closest-side, rgba(217, 255, 67, .2), transparent 72%); filter: blur(10px);
}
.sx-page .sx-stage > :not(.sx-pin) { position: relative; z-index: 1; }
.sx-page .sx-stage svg { width: 100%; height: auto; display: block; overflow: visible; }
.sx-page .sx-pin {
  position: absolute; z-index: 3; display: inline-flex; align-items: center; gap: 8px; max-width: calc(100% - 8px); font-size: 12.5px; font-weight: 700;
  line-height: 1.2; color: #fff; padding: 6px 12px 6px 6px; border-radius: 999px; background: rgba(15, 26, 31, .88); white-space: nowrap;
  border: 1px solid rgba(255, 255, 255, .22); backdrop-filter: blur(6px); box-shadow: 0 14px 30px -14px rgba(0, 0, 0, .6);
}
