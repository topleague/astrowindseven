@keyframes sx-spin { to { transform: rotate(360deg); } }
@keyframes sx-marquee { to { transform: translateX(-50%); } }
@keyframes sx-rip { 0% { transform: scale(.12); opacity: .85; } 100% { transform: scale(1); opacity: 0; } }
