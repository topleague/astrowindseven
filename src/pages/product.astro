---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Product Description Writing',
  description:
    'Keyword-optimized, persuasive product descriptions designed to help e-commerce brands attract visitors and turn them into customers.',
};
---

<Layout metadata={metadata} pageClass="product-description-writing">
  <div id="top">

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="eyebrow">Product Description Writing</div>

        <h1>
          Product descriptions that
          <span>make buying easier.</span>
        </h1>

        <p>
          Clear, persuasive and keyword-aware product descriptions written
          to help shoppers understand your products, find them in search,
          and feel confident buying them.
        </p>

        <div class="actions">
          <a class="btn primary" href="#packages">
            Explore packages
          </a>

          <a class="btn ghost" href="#benefits">
            See what's included
          </a>
        </div>

        <div class="hero-note">
          Original writing · Keyword-aware · Conversion-focused · Human-edited
        </div>

      </div>
    </section>


    <!-- OVERVIEW -->
    <section class="section" id="overview">
      <div class="container intro">

        <div>
          <div class="kicker">The point isn't more words</div>

          <h2>
            It's better product copy,
            <span>made to sell.</span>
          </h2>
        </div>

        <div class="intro-copy">

          <p>
            In e-commerce, your product description often has to do the job
            of a salesperson.
          </p>

          <p>
            It needs to explain what the product is, communicate why it
            matters, answer the questions standing between interest and
            purchase, and give the visitor a reason to choose you over
            the competition.
          </p>

          <p>
            <strong>That's where we come in.</strong>
            With years of content-writing experience and hundreds of product
            descriptions across different industries, we combine product
            research, customer understanding and SEO thinking to create copy
            that works harder.
          </p>

        </div>

      </div>
    </section>


    <!-- BENEFITS -->
    <section class="section band" id="benefits">
      <div class="container">

        <div class="feature-head">

          <div>
            <div class="kicker">What you get</div>

            <h2 class="section-title">
              Six ways we make your
              <span>product copy work harder.</span>
            </h2>
          </div>

          <p>
            Product descriptions should do more than describe a product.
            They should help people discover it, understand it and feel
            ready to buy it.
          </p>

        </div>


        <div class="features">

          <article class="feature">
            <div class="num">01 / Persuasion</div>

            <h3>
              Written to persuade naturally.
            </h3>

            <p>
              We turn product features into meaningful benefits and write
              descriptions that guide visitors toward a purchase without
              sounding forced or overly promotional.
            </p>
          </article>


          <article class="feature">
            <div class="num">02 / Search</div>

            <h3>
              Keyword optimized.
            </h3>

            <p>
              Every description is written around the keywords and language
              your customers are likely to use when searching for products
              like yours.
            </p>
          </article>


          <article class="feature">
            <div class="num">03 / SEO</div>

            <h3>
              SEO titles & descriptions.
            </h3>

            <p>
              We provide SEO titles and meta descriptions along with your
              product copy at no additional cost.
            </p>
          </article>


          <article class="feature">
            <div class="num">04 / Scale</div>

            <h3>
              Better value on bulk orders.
            </h3>

            <p>
              Have a large catalogue to cover? Bulk orders can qualify for
              discounts of up to 50%, making it easier to scale your product
              content without scaling your costs at the same rate.
            </p>
          </article>


          <article class="feature">
            <div class="num">05 / Confidence</div>

            <h3>
              Try us before you commit.
            </h3>

            <p>
              You can order up to three free samples before choosing one of
              our packages, giving you a chance to evaluate the writing first.
            </p>
          </article>


          <article class="feature">
            <div class="num">06 / Support</div>

            <h3>
              We can help with publishing too.
            </h3>

            <p>
              If you don't want to handle the uploads yourself, we can add
              the finished descriptions directly to your live website for
              an additional cost.
            </p>
          </article>


          <article class="feature wide">
            <div class="num">07 / Experience</div>

            <h3>
              Research before writing.
            </h3>

            <p>
              We don't start by filling a template. We first understand the
              product, the audience and the information a customer needs.
              That research becomes the foundation for the copy.
            </p>
          </article>

        </div>
      </div>
    </section>


    <!-- PROCESS -->
    <section class="section" id="process">
      <div class="container process">

        <div>
          <div class="kicker">How it works</div>

          <h2 class="section-title">
            Good product copy
            <span>starts with research.</span>
          </h2>

          <p class="process-intro">
            The words come later. First, we need to understand what we're
            writing about and who we're writing it for.
          </p>
        </div>


        <div class="process-list">

          <div class="step">
            <span>01</span>

            <div>
              <h3>Understand the product</h3>

              <p>
                We look at the product's features, specifications, uses,
                differentiators and the information customers need before
                making a decision.
              </p>
            </div>
          </div>


          <div class="step">
            <span>02</span>

            <div>
              <h3>Understand the customer</h3>

              <p>
                We consider who is likely to buy the product, what they care
                about and what questions or objections may stand between
                interest and purchase.
              </p>
            </div>
          </div>


          <div class="step">
            <span>03</span>

            <div>
              <h3>Research the search</h3>

              <p>
                We identify the relevant keyword and search language so the
                description can speak naturally to both customers and search
                engines.
              </p>
            </div>
          </div>


          <div class="step">
            <span>04</span>

            <div>
              <h3>Write & refine</h3>

              <p>
                We turn everything we've learned into concise, informative
                and persuasive product copy, followed by a final editorial
                review before delivery.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>


    <!-- PACKAGES -->
    <section class="section pricing" id="packages">
      <div class="container">

        <div class="pricing-intro">

          <div>
            <div class="kicker">Packages</div>

            <h2 class="section-title">
              A package for every
              <span>catalogue size.</span>
            </h2>
          </div>

          <p>
            Start with a small trial or order at scale. The larger the
            catalogue, the more you save.
          </p>

        </div>


        <div class="packages">

          <!-- BASIC -->
          <article class="package">

            <div class="tag">
              For testing the waters
            </div>

            <h3>Basic</h3>

            <p class="desc">
              A straightforward way to test our product-description writing
              before committing to a larger order.
            </p>

            <div class="price">
              <small>₹</small>499
            </div>

            <ul>
              <li>100 descriptions</li>
              <li>50 words each</li>
              <li>2 business days</li>
              <li>Trial package</li>
            </ul>

            <a class="btn" href="#contact">
              Order Now →
            </a>

          </article>


          <!-- STANDARD -->
          <article class="package featured">

            <div class="tag">
              Best value
            </div>

            <h3>Standard</h3>

            <p class="desc">
              A larger batch for stores ready to improve a meaningful part
              of their product catalogue.
            </p>

            <div class="price">
              <small>₹</small>799
            </div>

            <ul>
              <li>300 descriptions</li>
              <li>50 words each</li>
              <li>5 business days</li>
              <li>Save 20%</li>
            </ul>

            <a class="btn" href="#contact">
              Order Now →
            </a>

          </article>


          <!-- PREMIUM -->
          <article class="package">

            <div class="tag">
              For larger catalogues
            </div>

            <h3>Premium</h3>

            <p class="desc">
              The highest-volume package for businesses that need product
              descriptions at scale.
            </p>

            <div class="price">
              <small>₹</small>1199
            </div>

            <ul>
              <li>400 descriptions</li>
              <li>50 words each</li>
              <li>10 business days</li>
              <li>Save 40%</li>
            </ul>

            <a class="btn" href="#contact">
              Order Now →
            </a>

          </article>

        </div>


        <div class="package-note">
          <strong>Need more?</strong>
          Larger bulk orders can qualify for discounts of up to 50%.
          Contact us to discuss your catalogue.
        </div>

      </div>
    </section>


    <!-- PROOF / POSITIONING -->
    <section class="section" id="proof">
      <div class="container proof">

        <div>

          <div class="kicker">The difference</div>

          <p class="quote">
            Your product may be great.
            <span>Your description has to make that obvious.</span>

            <small>
              Good product copy doesn't overwhelm the buyer with information.
              It gives them the right information at the right moment.
            </small>
          </p>

        </div>


        <div class="proofcards">

          <article class="proofcard">
            <div class="proof-number">01</div>

            <h3>Concise</h3>

            <p>
              Enough information to make the product clear without burying
              the important details under unnecessary words.
            </p>
          </article>


          <article class="proofcard">
            <div class="proof-number">02</div>

            <h3>Informative</h3>

            <p>
              The features, benefits and practical details customers need
              to make a more confident buying decision.
            </p>
          </article>


          <article class="proofcard">
            <div class="proof-number">03</div>

            <h3>Captivating</h3>

            <p>
              Copy that gives visitors a reason to keep reading rather than
              treating the product page like a specification sheet.
            </p>
          </article>


          <article class="proofcard">
            <div class="proof-number">04</div>

            <h3>Search-aware</h3>

            <p>
              Product language built around relevant search terms without
              turning the description into obvious keyword stuffing.
            </p>
          </article>

        </div>

      </div>
    </section>


    <!-- CTA -->
    <section class="cta" id="contact">
      <div class="container cta-inner">

        <div>

          <div class="kicker">
            Ready when you are
          </div>

          <h2>
            Give your products
            <span>better words to sell with.</span>
          </h2>

        </div>


        <div>

          <p>
            Tell us how many products you need written, and we'll help you
            choose the right package for your catalogue.
          </p>

          <a class="btn" href="/contact/">
            Start a conversation →
          </a>

        </div>

      </div>
    </section>

  </div>


  <style>
    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');

    :global(html) {
      scroll-behavior: smooth;
    }

    .product-description-writing {
      --service-bg: var(--aw-color-bg-page);
      --service-text: var(--aw-color-text-default);
      --service-heading: var(--aw-color-text-heading);
      --service-muted: var(--aw-color-text-muted);

      --service-line: rgb(128 128 128 / 22%);
      --service-soft: rgb(128 128 128 / 8%);

      --service-accent: rgb(31 95 85);
      --service-accent-soft: rgb(220 235 229);

      --service-dark: rgb(23 36 43);
      --service-dark-text: rgb(255 255 255);
      --service-dark-muted: rgb(255 255 255 / 68%);

      --service-max: 1180px;
    }

    .dark .product-description-writing {
      --service-line: rgb(255 255 255 / 16%);
      --service-soft: rgb(255 255 255 / 5%);

      --service-accent: rgb(120 190 174);
      --service-accent-soft: rgb(35 70 62);

      --service-dark: rgb(18 24 27);
      --service-dark-text: rgb(247 248 248);
      --service-dark-muted: rgb(229 236 246 / 70%);
    }

    .container {
      width: 100%;
      max-width: var(--service-max);
      margin-inline: auto;
      padding-inline: 28px;
    }

    .hero {
      position: relative;
      min-height: 690px;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      color: #fff;
      background:
        linear-gradient(
          90deg,
          rgb(9 18 22 / 94%) 0%,
          rgb(9 18 22 / 78%) 43%,
          rgb(9 18 22 / 48%) 72%,
          rgb(9 18 22 / 24%) 100%
        ),
        url('/hero.avif') center / cover;
    }

    /*
      Keep the same editorial hero treatment as Lab.
      Dark mode only changes the overlay strength slightly;
      the photograph remains consistent across both modes.
    */

    .dark .hero {
      background:
        linear-gradient(
          90deg,
          rgb(3 7 9 / 96%) 0%,
          rgb(3 7 9 / 84%) 48%,
          rgb(3 7 9 / 56%) 78%,
          rgb(3 7 9 / 30%) 100%
        ),
        url('/hero.avif') center / cover;
    }

    .hero .container {
      position: relative;
      padding-top: 110px;
      padding-bottom: 78px;
    }

    .eyebrow {
      margin-bottom: 22px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .16em;
      text-transform: uppercase;
      opacity: .8;
    }

    .hero h1 {
      max-width: 900px;
      margin: 0 0 28px;
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(54px, 7vw, 92px);
      line-height: .96;
      letter-spacing: -.055em;
    }

    .hero h1 span {
      display: block;
      color: rgb(220 235 229);
    }

    .dark .hero h1 span {
      color: rgb(145 211 195);
    }

    .hero p {
      max-width: 680px;
      margin: 0 0 34px;
      color: rgb(255 255 255 / 86%);
      font-size: 20px;
      line-height: 1.5;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px 21px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
      transition:
        transform .2s ease,
        background-color .2s ease,
        border-color .2s ease;
    }

    .btn:hover {
      transform: translateY(-1px);
    }

    .btn.primary {
      color: rgb(22 32 42);
      background: #fff;
    }

    .btn.ghost {
      color: #fff;
      border: 1px solid rgb(255 255 255 / 35%);
      background: transparent;
    }

    .btn.ghost:hover {
      border-color: rgb(255 255 255 / 60%);
    }

    .hero-note {
      margin-top: 46px;
      color: rgb(255 255 255 / 68%);
      font-size: 13px;
    }


    /* GENERAL SECTIONS */

    .section {
      padding: 105px 0;
      color: var(--service-text);
      background: var(--service-bg);
    }

    .kicker {
      color: var(--service-accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .14em;
      text-transform: uppercase;
    }

    .intro {
      display: grid;
      grid-template-columns: 1fr 1.35fr;
      gap: 80px;
      align-items: start;
    }

    .intro h2,
    .section-title {
      margin: 12px 0 0;
      color: var(--service-heading);
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(38px, 4.5vw, 60px);
      line-height: 1.02;
      letter-spacing: -.045em;
    }

    .intro h2 span,
    .section-title span {
      color: var(--service-accent);
    }

    .intro-copy {
      max-width: 680px;
      color: var(--service-muted);
      font-size: 20px;
    }

    .intro-copy p + p {
      margin-top: 20px;
    }

    .intro-copy strong {
      color: var(--service-heading);
    }


    /* BENEFITS */

    .band {
      background: var(--service-soft);
      border-top: 1px solid var(--service-line);
      border-bottom: 1px solid var(--service-line);
    }

    .feature-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 40px;
      margin-bottom: 52px;
    }

    .feature-head p {
      max-width: 430px;
      margin: 0;
      color: var(--service-muted);
    }

    .features {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 1px;
      overflow: hidden;
      background: var(--service-line);
      border: 1px solid var(--service-line);
    }

    .feature {
      min-height: 245px;
      padding: 34px;
      background: var(--service-bg);
    }

    .feature:nth-child(1) {
      grid-column: span 7;
    }

    .feature:nth-child(2) {
      grid-column: span 5;
    }

    .feature:nth-child(3),
    .feature:nth-child(4),
    .feature:nth-child(5) {
      grid-column: span 4;
    }

    .feature:nth-child(6),
    .feature:nth-child(7) {
      grid-column: span 6;
    }

    .num {
      color: var(--service-accent);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 13px;
      font-weight: 700;
    }

    .feature h3 {
      margin: 45px 0 10px;
      color: var(--service-heading);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 25px;
      letter-spacing: -.03em;
    }

    .feature p {
      margin: 0;
      color: var(--service-muted);
      font-size: 15px;
    }


    /* PROCESS */

    .process {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: 80px;
    }

    .process-intro {
      max-width: 480px;
      margin-top: 28px;
      color: var(--service-muted);
      font-size: 16px;
    }

    .process-list {
      border-top: 1px solid var(--service-line);
    }

    .step {
      display: grid;
      grid-template-columns: 70px 1fr;
      gap: 20px;
      padding: 28px 0;
      border-bottom: 1px solid var(--service-line);
    }

    .step > span {
      color: var(--service-accent);
      font-size: 13px;
      font-weight: 700;
    }

    .step h3 {
      margin: 0 0 5px;
      color: var(--service-heading);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 23px;
    }

    .step p {
      margin: 0;
      color: var(--service-muted);
    }


    /* PRICING */

    .pricing {
      color: var(--service-dark-text);
      background: var(--service-dark);
    }

    .pricing .kicker {
      color: var(--service-accent);
    }

    .pricing .section-title {
      color: var(--service-dark-text);
    }

    .pricing-intro {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 40px;
      margin-bottom: 48px;
    }

    .pricing-intro p {
      max-width: 440px;
      margin: 0;
      color: var(--service-dark-muted);
    }

    .packages {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .package {
      display: flex;
      min-height: 420px;
      flex-direction: column;
      padding: 34px;
      color: var(--service-heading);
      background: var(--service-bg);
      border: 1px solid var(--service-line);
      border-radius: 2px;
    }

    .package.featured {
      background: var(--service-accent-soft);
    }

    .package .tag {
      color: var(--service-accent);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .13em;
      text-transform: uppercase;
    }

    .package h3 {
      margin: 14px 0 6px;
      color: var(--service-heading);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 30px;
    }

    .package .desc {
      min-height: 65px;
      color: var(--service-muted);
      font-size: 14px;
    }

    .price {
      margin: 15px 0;
      color: var(--service-heading);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 44px;
      letter-spacing: -.04em;
    }

    .price small {
      font-size: 24px;
    }

    .package ul {
      display: grid;
      gap: 10px;
      margin: 0 0 24px;
      padding: 0;
      color: var(--service-muted);
      font-size: 14px;
      list-style: none;
    }

    .package li::before {
      margin-right: 8px;
      color: var(--service-accent);
      font-weight: 700;
      content: '✓';
    }

    .package .btn {
      margin-top: auto;
      color: #fff;
      background: var(--service-heading);
    }

    .dark .package .btn {
      color: rgb(8 9 10);
      background: rgb(247 248 248);
    }

    .package-note {
      margin-top: 28px;
      color: var(--service-dark-muted);
      font-size: 14px;
    }

    .package-note strong {
      color: var(--service-dark-text);
    }


    /* PROOF */

    .proof {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 90px;
    }

    .quote {
      max-width: 620px;
      margin: 0;
      color: var(--service-heading);
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(30px, 3.5vw, 48px);
      line-height: 1.08;
      letter-spacing: -.04em;
    }

    .quote > span {
      color: var(--service-accent);
    }

    .quote small {
      display: block;
      margin-top: 28px;
      color: var(--service-muted);
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      line-height: 1.5;
      letter-spacing: 0;
    }

    .proofcards {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .proofcard {
      padding: 27px;
      background: var(--service-soft);
      border: 1px solid var(--service-line);
    }

    .proof-number {
      color: var(--service-accent);
      font-size: 13px;
      font-weight: 700;
    }

    .proofcard h3 {
      margin-top: 22px;
      color: var(--service-heading);
      font-family: 'Space Grotesk', sans-serif;
      font-size: 23px;
    }

    .proofcard p {
      margin-top: 12px;
      color: var(--service-muted);
      font-size: 14px;
    }


    /* CTA */

    .cta {
      padding: 95px 0 110px;
      color: #fff;
      background: var(--service-accent);
    }

    .cta-inner {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 60px;
    }

    .cta .kicker {
      color: rgb(220 235 229);
    }

    .cta h2 {
      max-width: 720px;
      margin: 10px 0 0;
      color: #fff;
      font-family: 'Space Grotesk', sans-serif;
      font-size: clamp(42px, 5vw, 68px);
      line-height: .98;
      letter-spacing: -.05em;
    }

    .cta h2 span {
      color: rgb(220 235 229);
    }

    .cta p {
      max-width: 440px;
      color: rgb(255 255 255 / 72%);
    }

    .cta .btn {
      margin-top: 22px;
      color: rgb(22 32 42);
      background: #fff;
    }


    /* RESPONSIVE */

    @media (max-width: 850px) {

      .hero {
        min-height: 620px;
      }

      .hero h1 {
        font-size: 52px;
      }

