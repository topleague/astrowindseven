---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Product Description Writing Services | Top League',
  description:
    'Product descriptions written to make products easier to find, easier to understand, and harder to ignore.',
};
---

<Layout metadata={metadata} pageClass="product-description-writing">
  <div class="product-description-page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-inner">
        <div class="eyebrow">PRODUCT DESCRIPTION WRITING</div>

        <h1>
          Product descriptions that
          <em>make buying easier.</em>
        </h1>

        <p class="hero-copy">
          Your product has seconds to make its case. We turn features,
          specifications and search terms into clear, persuasive copy
          that helps visitors understand the product—and want it.
        </p>

        <div class="hero-actions">
          <a href="#packages" class="btn btn-primary">View packages</a>
          <a href="#approach" class="text-link">See how we write <span>↓</span></a>
        </div>
      </div>

      <div class="hero-note">
        <span>01</span>
        <p>Built for e-commerce brands that need product copy to do more than fill a page.</p>
      </div>
    </section>


    <!-- INTRO -->
    <section class="intro section" id="approach">
      <div class="section-label">THE REAL JOB</div>

      <div class="intro-grid">
        <h2>
          A product description
          <em>should sell without sounding like a sales pitch.</em>
        </h2>

        <div class="intro-copy">
          <p class="lead">
            A visitor doesn't need more words. They need the right words.
          </p>

          <p>
            Great product descriptions answer the questions that stand between
            curiosity and purchase. What is it? Why does it matter? What makes
            it different? And is it right for me?
          </p>

          <p>
            We research your products, understand the audience you're trying
            to reach, and turn the raw information into concise, useful and
            persuasive product copy.
          </p>
        </div>
      </div>
    </section>


    <!-- BENEFITS -->
    <section class="section soft-section" id="benefits">
      <div class="section-heading">
        <div class="section-label">WHAT YOU GET</div>

        <h2>
          Copy with a job
          <em>to do.</em>
        </h2>

        <p>
          Every description is written to balance three things:
          discoverability, clarity and conversion.
        </p>
      </div>

      <div class="feature-grid">

        <article class="feature-card">
          <span class="feature-number">01</span>
          <h3>Persuasive descriptions</h3>
          <p>
            We turn product features into customer-focused benefits,
            giving visitors a clear reason to keep reading—and consider buying.
          </p>
        </article>

        <article class="feature-card">
          <span class="feature-number">02</span>
          <h3>Keyword-aware copy</h3>
          <p>
            Each description is written around the language your customers
            actually use when searching for products like yours.
          </p>
        </article>

        <article class="feature-card">
          <span class="feature-number">03</span>
          <h3>SEO titles & descriptions</h3>
          <p>
            We can provide search-friendly SEO titles and meta descriptions
            alongside your product copy, at no additional charge.
          </p>
        </article>

        <article class="feature-card">
          <span class="feature-number">04</span>
          <h3>Consistent at scale</h3>
          <p>
            Ordering hundreds of descriptions? We maintain a consistent
            voice, structure and standard across your entire catalogue.
          </p>
        </article>

        <article class="feature-card">
          <span class="feature-number">05</span>
          <h3>Bulk-order savings</h3>
          <p>
            Larger catalogues get better economics, with discounts available
            when you order product descriptions in bulk.
          </p>
        </article>

        <article class="feature-card">
          <span class="feature-number">06</span>
          <h3>Free samples</h3>
          <p>
            Not ready to commit? Request up to three free samples and
            evaluate the writing before choosing a package.
          </p>
        </article>

        <article class="feature-card feature-card-wide">
          <span class="feature-number">07</span>
          <h3>Need help publishing?</h3>
          <p>
            We can also add finished product descriptions directly to your
            live website for an additional cost, so your team doesn't have
            to handle every upload manually.
          </p>
        </article>

      </div>
    </section>


    <!-- PROCESS -->
    <section class="section process-section" id="process">
      <div class="process-intro">
        <div class="section-label">OUR APPROACH</div>

        <h2>
          Research first.
          <em>Write second.</em>
        </h2>

        <p>
          The strongest product copy doesn't begin with a clever sentence.
          It begins with understanding the product and the person who is
          considering buying it.
        </p>
      </div>

      <div class="process-list">

        <div class="process-item">
          <div class="process-number">01</div>
          <div>
            <h3>Understand the product</h3>
            <p>
              We study the product, its specifications, differentiators,
              use cases and the information customers need before purchasing.
            </p>
          </div>
        </div>

        <div class="process-item">
          <div class="process-number">02</div>
          <div>
            <h3>Understand the search</h3>
            <p>
              We identify the terminology and keyword opportunities that
              help your products communicate with both shoppers and search engines.
            </p>
          </div>
        </div>

        <div class="process-item">
          <div class="process-number">03</div>
          <div>
            <h3>Write for the buyer</h3>
            <p>
              Features become meaningful benefits. Technical information
              becomes easier to understand. The copy stays concise without
              becoming generic.
            </p>
          </div>
        </div>

        <div class="process-item">
          <div class="process-number">04</div>
          <div>
            <h3>Deliver at scale</h3>
            <p>
              Whether you need a small batch or hundreds of descriptions,
              we keep the voice, structure and quality consistent throughout.
            </p>
          </div>
        </div>

      </div>
    </section>


    <!-- PACKAGES -->
    <section class="section packages-section" id="packages">
      <div class="section-heading centered">
        <div class="section-label">PACKAGES</div>

        <h2>
          Start small.
          <em>Scale when you're ready.</em>
        </h2>

        <p>
          Choose a package based on the size of your catalogue and the
          turnaround you need.
        </p>
      </div>

      <div class="packages-grid">

        <article class="package-card">
          <div class="package-top">
            <span class="package-label">BASIC</span>
            <h3>Test the waters.</h3>
            <p>
              A smaller package for brands that want to experience
              our writing before scaling up.
            </p>
          </div>

          <div class="price">
            <span class="currency">₹</span>499
          </div>

          <ul>
            <li>100 descriptions</li>
            <li>50 words each</li>
            <li>2 business days</li>
            <li>Trial package</li>
          </ul>

          <a href="#contact" class="package-btn">Order now <span>→</span></a>
        </article>


        <article class="package-card featured">
          <div class="package-badge">POPULAR</div>

          <div class="package-top">
            <span class="package-label">STANDARD</span>
            <h3>For growing catalogues.</h3>
            <p>
              More products, better value and enough volume to make
              a real difference to your store.
            </p>
          </div>

          <div class="price">
            <span class="currency">₹</span>799
          </div>

          <ul>
            <li>300 descriptions</li>
            <li>50 words each</li>
            <li>5 business days</li>
            <li>Save 20%</li>
          </ul>

          <a href="#contact" class="package-btn">Order now <span>→</span></a>
        </article>


        <article class="package-card">
          <div class="package-top">
            <span class="package-label">PREMIUM</span>
            <h3>For serious scale.</h3>
            <p>
              A high-volume option for established stores with
              larger product catalogues.
            </p>
          </div>

          <div class="price">
            <span class="currency">₹</span>1199
          </div>

          <ul>
            <li>400 descriptions</li>
            <li>50 words each</li>
            <li>10 business days</li>
            <li>Save 40%</li>
          </ul>

          <a href="#contact" class="package-btn">Order now <span>→</span></a>
        </article>

      </div>
    </section>


    <!-- VALUE / PROOF -->
    <section class="section proof-section" id="proof">
      <div class="proof-grid">

        <div class="proof-statement">
          <div class="section-label">WHY IT MATTERS</div>

          <h2>
            Your product may be
            <em>great.</em>
            Your description has to make that obvious.
          </h2>
        </div>

        <div class="proof-copy">
          <p>
            Online shoppers can't pick up your product, examine it from
            every angle or ask a salesperson a question. Your product page
            has to bridge that gap.
          </p>

          <p>
            A strong description removes uncertainty. It explains the
            product clearly, highlights what matters and gives the visitor
            enough confidence to take the next step.
          </p>

          <div class="proof-points">
            <div>
              <strong>Clear</strong>
              <span>No unnecessary fluff.</span>
            </div>

            <div>
              <strong>Useful</strong>
              <span>Information buyers actually need.</span>
            </div>

            <div>
              <strong>Persuasive</strong>
              <span>Benefits that give people a reason to buy.</span>
            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- CTA -->
    <section class="cta-section" id="contact">
      <div class="cta-inner">

        <div class="section-label">READY WHEN YOU ARE</div>

        <h2>
          Give your products
          <em>better words to sell with.</em>
        </h2>

        <p>
          Tell us what you're selling, how many products you have,
          and what you need written. We'll take it from there.
        </p>

        <a href="/contact/" class="btn btn-light">
          Start a conversation <span>→</span>
        </a>

      </div>
    </section>

  </div>

  <style>
    :global(html) {
      scroll-behavior: smooth;
    }

    .product-description-page {
      --ink: #16202a;
      --muted: #64717d;
      --line: #dfe5e8;
      --paper: #fbfaf7;
      --soft: #f1f4f2;
      --accent: #1f5f55;
      --accent-dark: #17483f;
      --accent2: #dcebe5;
      --white: #ffffff;
      --max: 1180px;

      color: var(--ink);
      background: var(--paper);
      font-family:
        'DM Sans',
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        'Segoe UI',
        sans-serif;
      line-height: 1.65;
    }

    .product-description-page *,
    .product-description-page *::before,
    .product-description-page *::after {
      box-sizing: border-box;
    }

    .product-description-page h1,
    .product-description-page h2,
    .product-description-page h3 {
      margin: 0;
      font-family:
        'Space Grotesk',
        system-ui,
        sans-serif;
      line-height: 1.05;
      letter-spacing: -0.04em;
    }

    .product-description-page p {
      margin: 0;
    }

    .product-description-page a {
      text-decoration: none;
    }

    .section {
      max-width: var(--max);
      margin: 0 auto;
      padding: 110px 28px;
    }

    .section-label,
    .eyebrow {
      color: var(--accent);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .hero {
      position: relative;
      min-height: 690px;
      display: flex;
      align-items: center;
      background:
        linear-gradient(
          90deg,
          rgba(251, 250, 247, 0.98) 0%,
          rgba(251, 250, 247, 0.93) 44%,
          rgba(251, 250, 247, 0.45) 75%,
          rgba(251, 250, 247, 0.15) 100%
        ),
        url('/hero.avif') center / cover;
      border-bottom: 1px solid var(--line);
    }

    .hero-inner {
      width: min(var(--max), 100%);
      margin: 0 auto;
      padding: 90px 28px;
    }

    .hero h1 {
      max-width: 820px;
      margin-top: 24px;
      font-size: clamp(48px, 7vw, 86px);
    }

    .hero h1 em,
    .intro h2 em,
    .section-heading h2 em,
    .process-intro h2 em,
    .proof-statement h2 em,
    .cta-section h2 em {
      color: var(--accent);
      font-style: normal;
    }

    .hero-copy {
      max-width: 650px;
      margin-top: 30px;
      color: var(--muted);
      font-size: 19px;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 28px;
      margin-top: 38px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 15px 23px;
      border-radius: 3px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.03em;
      transition: 0.2s ease;
    }

    .btn-primary {
      color: var(--white);
      background: var(--accent);
    }

    .btn-primary:hover {
      background: var(--accent-dark);
      transform: translateY(-1px);
    }

    .text-link {
      color: var(--ink);
      font-size: 14px;
      font-weight: 600;
    }

    .text-link span {
      color: var(--accent);
      margin-left: 6px;
    }

    .hero-note {
      position: absolute;
      right: max(28px, calc((100vw - var(--max)) / 2));
      bottom: 32px;
      display: flex;
      gap: 16px;
      max-width: 270px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.5;
    }

    .hero-note span {
      color: var(--accent);
      font-weight: 700;
    }

    .intro-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 100px;
      margin-top: 24px;
      align-items: start;
    }

    .intro h2,
    .section-heading h2,
    .process-intro h2,
    .proof-statement h2 {
      font-size: clamp(42px, 5vw, 66px);
    }

    .intro-copy {
      padding-top: 10px;
    }

    .intro-copy .lead {
      margin-bottom: 22px;
      color: var(--ink);
      font-size: 23px;
      line-height: 1.35;
    }

    .intro-copy p + p {
      margin-top: 18px;
      color: var(--muted);
    }

    .soft-section {
      max-width: none;
      padding-left: max(28px, calc((100vw - var(--max)) / 2));
      padding-right: max(28px, calc((100vw - var(--max)) / 2));
      background: var(--soft);
    }

    .section-heading {
      max-width: 760px;
    }

    .section-heading h2 {
      margin-top: 20px;
    }

    .section-heading > p {
      max-width: 590px;
      margin-top: 22px;
      color: var(--muted);
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      margin-top: 65px;
      border-top: 1px solid var(--line);
      border-left: 1px solid var(--line);
    }

    .feature-card {
      min-height: 250px;
      padding: 30px;
      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.3);
    }

    .feature-card-wide {
      grid-column: span 3;
      min-height: auto;
    }

    .feature-number,
    .process-number {
      display: block;
      color: var(--accent);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.1em;
    }

    .feature-card h3 {
      margin-top: 55px;
      font-size: 24px;
      letter-spacing: -0.025em;
    }

    .feature-card p {
      margin-top: 14px;
      color: var(--muted);
      font-size: 15px;
    }

    .process-section {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 110px;
    }

    .process-intro {
      position: sticky;
      top: 120px;
      align-self: start;
    }

    .process-intro h2 {
      margin-top: 20px;
    }

    .process-intro > p {
      margin-top: 25px;
      color: var(--muted);
    }

    .process-list {
      border-top: 1px solid var(--line);
    }

    .process-item {
      display: grid;
      grid-template-columns: 55px 1fr;
      gap: 25px;
      padding: 34px 0;
      border-bottom: 1px solid var(--line);
    }

    .process-item h3 {
      font-size: 24px;
    }

    .process-item p {
      max-width: 580px;
      margin-top: 12px;
      color: var(--muted);
      font-size: 15px;
    }

    .centered {
      margin-left: auto;
      margin-right: auto;
      text-align: center;
    }

    .centered > p {
      margin-left: auto;
      margin-right: auto;
    }

    .packages-section {
      max-width: none;
      padding-left: max(28px, calc((100vw - var(--max)) / 2));
      padding-right: max(28px, calc((100vw - var(--max)) / 2));
      background: var(--soft);
    }

    .packages-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin-top: 65px;
    }

    .package-card {
      position: relative;
      display: flex;
      flex-direction: column;
      padding: 38px;
      border: 1px solid var(--line);
      background: var(--white);
    }

    .package-card.featured {
      border-color: var(--accent);
      box-shadow: 0 18px 45px rgba(22, 32, 42, 0.08);
    }

    .package-badge {
      position: absolute;
      top: 0;
      right: 0;
      padding: 7px 12px;
      color: var(--white);
      background: var(--accent);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.12em;
    }

    .package-label {
      color: var(--accent);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.15em;
    }

    .package-top h3 {
      margin-top: 20px;
      font-size: 29px;
    }

    .package-top p {
      min-height: 72px;
      margin-top: 15px;
      color: var(--muted);
      font-size: 14px;
    }

    .price {
      margin-top: 28px;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 58px;
      font-weight: 700;
      letter-spacing: -0.05em;
    }

    .currency {
      margin-right: 3px;
      font-size: 28px;
      vertical-align: top;
    }

    .package-card ul {
      margin: 25px 0 0;
      padding: 25px 0 30px;
      border-top: 1px solid var(--line);
      list-style: none;
    }

    .package-card li {
      position: relative;
      padding-left: 18px;
      color: var(--muted);
      font-size: 14px;
    }

    .package-card li + li {
      margin-top: 11px;
    }

    .package-card li::before {
      content: '—';
      position: absolute;
      left: 0;
      color: var(--accent);
    }

    .package-btn {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: auto;
      padding-top: 17px;
      border-top: 1px solid var(--line);
      color: var(--ink);
      font-size: 13px;
      font-weight: 700;
    }

    .package-btn span {
      color: var(--accent);
      font-size: 18px;
    }

    .proof-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 110px;
      align-items: start;
    }

    .proof-statement h2 {
      margin-top: 22px;
    }

    .proof-copy {
      padding-top: 12px;
    }

    .proof-copy > p {
      color: var(--muted);
      font-size: 17px;
    }

    .proof-copy > p + p {
      margin-top: 20px;
    }

    .proof-points {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 45px;
      padding-top: 25px;
      border-top: 1px solid var(--line);
    }

    .proof-points strong {
      display: block;
      font-family: 'Space Grotesk', sans-serif;
      font-size: 18px;
    }

    .proof-points span {
      display: block;
      margin-top: 7px;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.45;
    }

    .cta-section {
      padding: 120px 28px;
      color: var(--white);
      background: var(--accent);
    }

    .cta-inner {
      max-width: 850px;
      margin: 0 auto;
      text-align: center;
    }

    .cta-section .section-label {
      color: var(--accent2);
    }

    .cta-section h2 {
      margin-top: 22px;
      font-size: clamp(44px, 6vw, 72px);
    }

    .cta-section h2 em {
      color: var(--accent2);
    }

    .cta-section p {
      max-width: 600px;
      margin: 28px auto 0;
      color: rgba(255, 255, 255, 0.78);
      font-size: 17px;
    }

    .btn-light {
      margin-top: 34px;
      color: var(--accent);
      background: var(--white);
    }

    .btn-light:hover {
      transform: translateY(-1px);
    }

    @media (max-width: 900px) {
      .hero {
        min-height: 620px;
      }

      .hero-note {
        display: none;
      }

      .intro-grid,
      .process-section,
      .proof-grid {
        grid-template-columns: 1fr;
        gap: 55px;
      }

      .process-intro {
        position: static;
      }

      .feature-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .feature-card-wide {
        grid-column: span 2;
      }

      .packages-grid {
        grid-template-columns: 1fr;
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
      }
    }

    @media (max-width: 640px) {
      .section {
        padding-top: 75px;
        padding-bottom: 75px;
      }

      .hero-inner {
        padding-top: 70px;
        padding-bottom: 70px;
      }

      .hero h1 {
        font-size: 49px;
      }

      .hero-copy {
        font-size: 17px;
      }

      .hero-actions {
        align-items: flex-start;
        flex-direction: column;
        gap: 20px;
      }

      .feature-grid {
        grid-template-columns: 1fr;
      }

      .feature-card-wide {
        grid-column: auto;
      }

      .feature-card h3 {
        margin-top: 35px;
      }

      .proof-points {
        grid-template-columns: 1fr;
      }

      .package-card {
        padding: 30px;
      }

      .cta-section {
        padding-top: 85px;
        padding-bottom: 85px;
      }
    }
  </style>
</Layout>
