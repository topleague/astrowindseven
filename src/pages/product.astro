---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Product Description Writing',
  description:
    'Keyword-optimized, persuasive product descriptions designed to help e-commerce brands attract visitors and turn them into customers.',
};
---

<Layout metadata={metadata} pageClass="product-description-writing">
  <div id="top">

    <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="eyebrow">Product Description Writing</div>

        <h1>
          Product descriptions that
          <span>make buying easier.</span>
        </h1>

        <p>
          Clear, persuasive and keyword-aware product descriptions written
          to help shoppers understand your products, find them in search,
          and feel confident buying them.
        </p>

        <div class="actions">
          <a class="btn primary" href="#packages">
            Explore packages
          </a>

          <a class="btn ghost" href="#benefits">
            See what's included
          </a>
        </div>

        <div class="hero-note">
          Original writing · Keyword-aware · Conversion-focused · Human-edited
        </div>

      </div>
    </section>


    <!-- OVERVIEW -->
    <section class="section" id="overview">
      <div class="container intro">

        <div>
          <div class="kicker">The point isn't more words</div>

          <h2>
            It's better product copy,
            made to sell.
          </h2>
        </div>

        <div class="intro-copy">

          <p>
            In e-commerce, your product description often has to do the job
            of a salesperson.
          </p>

          <p>
            It needs to explain what the product is, communicate why it
            matters, answer the questions standing between interest and
            purchase, and give the visitor a reason to choose you over
            the competition.
          </p>

          <p>
            That's where we come in.
            With years of content-writing experience and hundreds of product
            descriptions across different industries, we combine product
            research, customer understanding and SEO thinking to create copy
            that works harder.
          </p>

        </div>

      </div>
    </section>


    <!-- BENEFITS -->
    <section class="section band" id="benefits">
      <div class="container">

        <div class="feature-head">

          <div>
            <div class="kicker">What you get</div>

            <h2 class="section-title">
              Six ways we make your
              product copy work harder.
            </h2>
          </div>

          <p>
            Product descriptions should do more than describe a product.
            They should help people discover it, understand it and feel
            ready to buy it.
          </p>

        </div>


        <div class="features">

          <article class="feature">
            <div class="num">01 / Persuasion</div>

            <h3>
              Written to persuade naturally.
            </h3>

            <p>
              We turn product features into meaningful benefits and write
              descriptions that guide visitors toward a purchase without
              sounding forced or overly promotional.
            </p>
          </article>


          <article class="feature">
            <div class="num">02 / Search</div>

            <h3>
              Keyword optimized.
            </h3>

            <p>
              Every description is written around the keywords and language
              your customers are likely to use when searching for products
              like yours.
            </p>
          </article>


          <article class="feature">
            <div class="num">03 / SEO</div>

            <h3>
              SEO titles & descriptions.
            </h3>

            <p>
              We provide SEO titles and meta descriptions along with your
              product copy at no additional cost.
            </p>
          </article>


          <article class="feature">
            <div class="num">04 / Scale</div>

            <h3>
              Better value on bulk orders.
            </h3>

            <p>
              Have a large catalogue to cover? Bulk orders can qualify for
              discounts of up to 50%, making it easier to scale your product
              content without scaling your costs at the same rate.
            </p>
          </article>


          <article class="feature">
            <div class="num">05 / Confidence</div>

            <h3>
              Try us before you commit.
            </h3>

            <p>
              You can order up to three free samples before choosing one of
              our packages, giving you a chance to evaluate the writing first.
            </p>
          </article>


          <article class="feature">
            <div class="num">06 / Support</div>

            <h3>
              We can help with publishing too.
            </h3>

            <p>
              If you don't want to handle the uploads yourself, we can add
              the finished descriptions directly to your live website for
              an additional cost.
            </p>
          </article>


          <article class="feature wide">
            <div class="num">07 / Experience</div>

            <h3>
              Research before writing.
            </h3>

            <p>
              We don't start by filling a template. We first understand the
              product, the audience and the information a customer needs.
              That research becomes the foundation for the copy.
            </p>
          </article>

        </div>
      </div>
    </section>


    <!-- PROCESS -->
    <section class="section" id="process">
      <div class="container process">

        <div>
          <div class="kicker">How it works</div>

          <h2 class="section-title">
            Good product copy
            starts with research.
          </h2>

          <p class="process-intro">
            The words come later. First, we need to understand what we're
            writing about and who we're writing it for.
          </p>
        </div>


        <div class="process-list">

          <div class="step">
            <span>01</span>

            <div>
              <h3>Understand the product</h3>

              <p>
                We look at the product's features, specifications, uses,
                differentiators and the information customers need before
                making a decision.
              </p>
            </div>
          </div>


          <div class="step">
            <span>02</span>

            <div>
              <h3>Understand the customer</h3>

              <p>
                We consider who is likely to buy the product, what they care
                about and what questions or objections may stand between
                interest and purchase.
              </p>
            </div>
          </div>


          <div class="step">
            <span>03</span>

            <div>
              <h3>Research the search</h3>

              <p>
                We identify the relevant keyword and search language so the
                description can speak naturally to both customers and search
                engines.
              </p>
            </div>
          </div>


          <div class="step">
            <span>04</span>

            <div>
              <h3>Write & refine</h3>

              <p>
                We turn everything we've learned into concise, informative
                and persuasive product copy, followed by a final editorial
                review before delivery.
              </p>
            </div>
          </div>

        </div>
      </div>
    </section>


    <!-- PACKAGES -->
    <section class="section pricing" id="packages">
      <div class="container">

        <div class="pricing-intro">

          <div>
            <div class="kicker">Packages</div>

            <h2 class="section-title">
              A package for every
              catalogue size.
            </h2>
          </div>

          <p>
            Start with a small trial or order at scale. The larger the
            catalogue, the more you save.
          </p>

        </div>


        <div class="packages">

          <!-- BASIC -->
          <article class="package">

            <div class="tag">
              For testing the waters
            </div>

            <h3>Basic</h3>

            <p class="desc">
              A straightforward way to test our product-description writing
              before committing to a larger order.
            </p>

            <div class="price">
              <small>₹</small>499
            </div>

            <ul>
              <li>100 descriptions</li>
              <li>50 words each</li>
              <li>2 business days</li>
              <li>Trial package</li>
            </ul>

            <a class="btn" href="#contact">
              Order Now →
            </a>

          </article>


          <!-- STANDARD -->
          <article class="package featured">

            <div class="tag">
              Best value
            </div>

            <h3>Standard</h3>

            <p class="desc">
              A larger batch for stores ready to improve a meaningful part
              of their product catalogue.
            </p>

            <div class="price">
              <small>₹</small>799
            </div>

            <ul>
              <li>300 descriptions</li>
              <li>50 words each</li>
              <li>5 business days</li>
              <li>Save 20%</li>
            </ul>

            <a class="btn" href="#contact">
              Order Now →
            </a>

          </article>


          <!-- PREMIUM -->
          <article class="package">

            <div class="tag">
              For larger catalogues
            </div>

            <h3>Premium</h3>

            <p class="desc">
              The highest-volume package for businesses that need product
              descriptions at scale.
            </p>

            <div class="price">
              <small>₹</small>1199
            </div>

            <ul>
              <li>400 descriptions</li>
              <li>50 words each</li>
              <li>10 business days</li>
              <li>Save 40%</li>
            </ul>

            <a class="btn" href="#contact">
              Order Now →
            </a>

          </article>

        </div>


        <div class="package-note">
          <strong>Need more?</strong>
          Larger bulk orders can qualify for discounts of up to 50%.
          Contact us to discuss your catalogue.
        </div>

      </div>
    </section>


    <!-- PROOF / POSITIONING -->
    <section class="section" id="proof">
      <div class="container proof">

        <div>

          <div class="kicker">The difference</div>

          <p class="quote">
            Your product may be great.
            <span>Your description has to make that obvious.</span>

            <small>
              Good product copy doesn't overwhelm the buyer with information.
              It gives them the right information at the right moment.
            </small>
          </p>

        </div>


        <div class="proofcards">

          <article class="proofcard">
            <div class="proof-number">01</div>

            <h3>Concise</h3>

            <p>
              Enough information to make the product clear without burying
              the important details under unnecessary words.
            </p>
          </article>


          <article class="proofcard">
            <div class="proof-number">02</div>

            <h3>Informative</h3>

            <p>
              The features, benefits and practical details customers need
              to make a more confident buying decision.
            </p>
          </article>


          <article class="proofcard">
            <div class="proof-number">03</div>

            <h3>Captivating</h3>

            <p>
              Copy that gives visitors a reason to keep reading rather than
              treating the product page like a specification sheet.
            </p>
          </article>


          <article class="proofcard">
            <div class="proof-number">04</div>

            <h3>Search-aware</h3>

            <p>
              Product language built around relevant search terms without
              turning the description into obvious keyword stuffing.
            </p>
          </article>

        </div>

      </div>
    </section>


    <!-- CTA -->
    <section class="cta" id="contact">
      <div class="wrap">
        <div class="cta-box">

          <div>
            <div class="eyebrow" style="color:#8ad0bf">
              Ready when you are
            </div>

            <h2>
              Give your content calendar something worth publishing.
            </h2>

            <p>
              Start with a sample, choose a package, or tell us what you're
              trying to rank for. We'll help shape the brief.
            </p>
          </div>

          <a class="btn" href="#packages">
            Explore article packages →
          </a>

        </div>
      </div>
    </section>

  </div>
</Layout>
