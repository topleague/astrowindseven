
---
import Layout from '~/layouts/PageLayout.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import FeatureTabs from '~/components/widgets/FeatureTabs.astro';

import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'Website Development & Digital Services | Top League Technologies',
  description:
    'We build websites shaped by business goals, SEO and useful content. A practical digital partner for small businesses.',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle
      ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] }
      : {}),
  },
];

// THE USUAL WAY VS THE TOP LEAGUE APPROACH
const usualWay = [
  {
    title: 'Start with the website',
    description:
      'The first question is “What kind of website do you want?”. A list of pages and features becomes the plan, and the business comes second.',
  },
  {
    title: 'Treat requirements as the strategy',
    description:
      'A quote follows the feature list. The real budget surfaces later, usually as a compromise.',
  },
  {
    title: 'Choose what is familiar',
    description:
      'Domain, hosting and platform are picked by habit, convenience or the lowest price.',
  },
  {
    title: 'Build first, think about SEO later',
    description:
      'Pages are designed and written first. Search intent and site structure are considered afterwards.',
  },
  {
    title: 'Fill the pages at the end',
    description:
      'Copy and images arrive late and get squeezed into whatever space the design left.',
  },
  {
    title: 'Launch and move on',
    description:
      'Speed, security, social presence and fresh content become somebody else’s problem.',
  },
];

const topLeagueWay = [
  {
    title: 'Start with the business',
    description:
      'We begin with your audience, your goals and what success means to you. Only then do we decide which pages and features earn a place.',
  },
  {
    title: 'Plan around the real budget',
    description:
      'Budget is part of the first conversation, so the plan is practical rather than padded.',
  },
  {
    title: 'Choose foundations deliberately',
    description:
      'Domain, hosting and CMS, platform or framework follow your requirements, not whatever we happen to use.',
  },
  {
    title: 'Map SEO before building pages',
    description:
      'Search intent, keywords, structure and the pages you need to compete are decided before the build begins.',
  },
  {
    title: 'Create content around the plan',
    description:
      'Content and visuals are prepared with your audience and search goals in mind, before the pages are assembled.',
  },
  {
    title: 'Plan for life after launch',
    description:
      'We build for speed and security from the start, and can continue supporting your website with updates, analytics and new content.',
  },
];

const comparison = (usual, top) => `
  <div class="difference-panel">
    <div class="difference-usual">
      <div class="difference-label difference-label-usual">
        <span class="difference-icon difference-icon-usual">×</span>
        The Usual Way
      </div>
      <h3>${usual.title}</h3>
      <p>${usual.description}</p>
    </div>
    <div class="difference-top">
      <div class="difference-label difference-label-top">
        <span class="difference-icon difference-icon-top">✓</span>
        The Top League Approach
      </div>
      <h3>${top.title}</h3>
      <p>${top.description}</p>
    </div>
  </div>
`;
---

<Layout metadata={metadata} pageClass="home-draft">
  <StructuredData slot="head" schema={structuredData} />

  <!-- 1. HERO -->
  <section class="hero">
    <div class="container">

      <div class="eyebrow">
        <span class="dot"></span>
        Digital partner for small businesses
      </div>

      <h1>
        Build Your Online Presence,
        <span>Not Just a Website.</span>
      </h1>

      <p>
        We build thoughtful websites shaped by your business goals, SEO and
        useful content — so your online presence has a stronger foundation
        from day one.
      </p>

      <div class="actions">
        <a class="btn primary" href="/contact/">Let's talk ↗</a>
        <a class="btn ghost" href="#approach">How we work ↓</a>
      </div>

      <div class="hero-note">
        Website development · SEO · Content · Ongoing support
      </div>

    </div>
  </section>


  <!-- 2. PROOF BAR -->
  <section class="proofbar">
    <div class="wrap proofgrid">
      <div class="proof">
        <strong>16 years</strong>
        <span>as an incorporated company</span>
      </div>

      <div class="proof">
        <strong>300+</strong>
        <span>clients worked with</span>
      </div>

      <div class="proof">
        <strong>20</strong>
        <span>websites currently maintained</span>
      </div>

      <div class="proof">
        <strong>10 countries</strong>
        <span>clients served</span>
      </div>
    </div>
  </section>


  <!-- 3. THE BIGGER PICTURE -->
  <section class="section band" id="coming">
    <div class="container">

      <div class="feature-head">
        <div>
          <div class="kicker">Why it matters</div>
          <h2>Your website is only one part of your online presence.</h2>
        </div>

        <p>
          Your domain, website, content, search visibility and social presence
          all shape how people discover and experience your business.
        </p>
      </div>

      <Features2
        classes={{
          container: 'coming-section',
          headline: { container: 'max-w-3xl !mx-0 !text-left' },
        }}
        columns={3}
        items={[
          {
            title: 'The right foundations',
            description:
              'Your domain, hosting and technology choices can affect your brand and your options long after the website launches.',
            icon: 'tabler:building-community',
          },
          {
            title: 'A connected presence',
            description:
              'Your website should work with your content and social channels — not sit apart from the rest of your marketing.',
            icon: 'tabler:hierarchy-2',
          },
          {
            title: 'Visibility that grows',
            description:
              'SEO, useful content, analytics and ongoing improvements help keep your online presence relevant after launch.',
            icon: 'tabler:route',
          },
        ]}
      />

    </div>
  </section>


  <!-- 4. A REAL CLIENT STORY -->
  <section class="section" id="reality">
    <div class="container">

      <div class="process">
        <div>
          <div class="kicker">Based on a real client story</div>
          <h2>What an expensive mistake can look like.</h2>
        </div>

        <div class="story-content">
          <p>
            A client came to us with a domain name and logo already chosen.
            After the website was ready, a trademark conflict forced a change
            of name, domain and logo.
          </p>

          <p>
            Work that should have been settled before the website began had
            to be revisited. The result was avoidable time, effort and
            expense.
          </p>

          <p>
            <strong>
              A website project needs more than a design brief. It needs the
              right questions asked at the beginning.
            </strong>
          </p>
        </div>
      </div>

      <div class="mt-10 border-y border-slate-200 py-6 dark:border-slate-700">
        <div class="kicker">The lesson</div>
        <p class="mt-2 text-muted">
          Think through the business decisions before committing to the
          website decisions.
        </p>
      </div>

    </div>
  </section>


  <!-- 5. THE TOP LEAGUE DIFFERENCE -->
  <section class="section band" id="difference">
    <div class="container">

      <div class="feature-head">
        <div>
          <div class="kicker">The Top League difference</div>
          <h2>A website is only as good as the thinking behind it.</h2>
        </div>

        <p>
          Here's what we do differently before we build, while we build and
          after we launch.
        </p>
      </div>

      <FeatureTabs
        items={[
          ['Starting point', 'tabler:flag'],
          ['Budget', 'tabler:coin'],
          ['Foundations', 'tabler:stack-2'],
          ['SEO', 'tabler:search'],
          ['Content', 'tabler:writing'],
          ['After launch', 'tabler:rocket'],
        ].map(([title, icon], i) => ({
          title,
          icon,
          image: comparison(usualWay[i], topLeagueWay[i]),
        }))}
      />

    </div>
  </section>


  <!-- 6. HOW WE WORK -->
  <section class="section" id="approach">
    <div class="container">

      <div class="feature-head">
        <div>
          <div class="kicker">How we work</div>
          <h2>From a business idea to a stronger online presence.</h2>
        </div>

        <p>
          We bring website development, content and search expertise together
          so the pieces work towards the same business goals.
        </p>
      </div>

      <div class="process">
        <div>
          <p>
            Not every business needs the same combination of services. We
            start by understanding what you need, then build a practical plan
            around it.
          </p>
        </div>

        <div class="process-list">

          <article class="step">
            <span>01</span>
            <div>
              <h3>Website development</h3>
              <p>
                Thoughtful, responsive websites built around your business,
                your audience and the experience you want to create.
              </p>
            </div>
          </article>

          <article class="step">
            <span>02</span>
            <div>
              <h3>Content that communicates</h3>
              <p>
                Clear, useful website content that explains what you offer,
                speaks to your customers and supports your search goals.
              </p>
            </div>
          </article>

          <article class="step">
            <span>03</span>
            <div>
              <h3>SEO and social visibility</h3>
              <p>
                Search optimisation and social media support to help your
                business reach the people looking for what you offer.
              </p>
            </div>
          </article>

          <article class="step">
            <span>04</span>
            <div>
              <h3>Ongoing care and improvement</h3>
              <p>
                Website maintenance, analytics and content improvements to
                keep your digital presence useful beyond launch day.
              </p>
            </div>
          </article>

        </div>
      </div>

    </div>
  </section>


  <!-- 7. FAQs -->
  <section class="section band" id="faqs">
    <div class="container">

      <div class="feature-head">
        <div>
          <div class="kicker">FAQs</div>
          <h2>A few things you may want to know.</h2>
        </div>

        <p>
          Every project is different. Here are a few things worth knowing
          before we start a conversation.
        </p>
      </div>

      <FAQs
        schema
        items={[
          {
            title: 'What kind of businesses do you work with?',
            description:
              'We work with small businesses and growing organisations that want a more effective online presence. The right approach depends on your goals, audience and requirements.',
          },
          {
            title: 'Do you only build new websites?',
            description:
              'No. We can also review existing websites, identify what needs improvement and recommend targeted changes or a more substantial rebuild when appropriate.',
          },
          {
            title: 'Can you help with website content and SEO?',
            description:
              'Yes. Content and SEO are important parts of our experience. We bring them into website planning and development, and can also help improve an existing website.',
          },
          {
            title: 'Do you provide support after launch?',
            description:
              'Yes. We can help with website maintenance, updates, analytics and ongoing content or SEO improvements, depending on what your business needs.',
          },
          {
            title: 'How do we get started?',
            description:
              'Start with a conversation about your business, what you want to achieve and the budget you have in mind. We can then discuss a practical way forward.',
          },
        ]}
      />

    </div>
  </section>


  <!-- 8. FINAL CTA -->
  <section id="contact" class="cta">
    <div class="wrap">
      <div class="kicker">Let's talk</div>

      <h2>
        Your business deserves more than just a website.
      </h2>

      <p>
        Start with the business, the goal and the budget. We'll work out the
        digital plan from there.
      </p>

      <a class="btn primary" href="mailto:hello@topleaguetech.com">
        Start a conversation ↗
      </a>
    </div>
  </section>

</Layout>
