---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import { Image } from 'astro:assets';
import purbaghatShot from '~/assets/images/work/purbaghat-masala.webp';
import decyphrShot from '~/assets/images/work/decyphr.webp';

const metadata = {
  title: 'Website Design & Development in Bhubaneswar | Top League',
  description: 'Get a website planned around your business, audience and budget, with content, SEO and ongoing support from Top League Technologies.',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];

const services = [
  { n: '01', title: 'Website design & development', text: 'A fast, mobile-friendly WordPress website shaped around your business, your customers and what you need the site to achieve.', href: '/website-development/', link: 'Explore website development' },
  { n: '02', title: 'Content writing', text: 'Useful website copy, articles and product descriptions that give visitors a reason to stay, understand and act.', href: '/seo-article-writing/', link: 'Explore content writing' },
  { n: '03', title: 'SEO & social media', text: 'A considered approach to search visibility and social activity, so the right people can discover your business.', href: '/seo-services/', link: 'Explore SEO services' },
  { n: '04', title: 'Website maintenance', text: 'Updates, backups, security checks and practical support to keep your website healthy after launch.', href: '/contact/', link: 'Ask about maintenance' },
];

const steps = [
  { n: '01', title: 'Understand', text: 'We discuss your business, audience, goals and budget before recommending a solution.' },
  { n: '02', title: 'Plan', text: 'We map the pages, content, search intent and technical foundations your website needs.' },
  { n: '03', title: 'Build', text: 'Design, content and development come together as one planned project.' },
  { n: '04', title: 'Support', text: 'After launch, you can continue with maintenance, SEO and fresh content.' },
];

const projects = [
  { name: 'Purbaghat Masala', kind: 'Custom WordPress child theme', url: 'https://asnagrofoods.com/', image: purbaghatShot, alt: 'Purbaghat Masala website home page' },
  { name: 'Decyphr', kind: 'IT consultancy website', url: 'https://decyphr.com/', image: decyphrShot, alt: 'Decyphr website home page' },
];

const plans = [
  { name: 'Starter', price: '₹30,000', line: 'I need a website.', detail: 'A one-time project to get your business online with the essentials set up properly.', features: ['Up to 3 pages with content', 'Standard design with your brand colours', 'Basic keyword research and on-page SEO', 'Analytics, Search Console and Business Profile setup', '1 SEO blog article'], href: '/contact/' },
  { name: 'Growth', price: '₹50,000', line: 'I need a website that attracts customers.', detail: 'A research-led website, with content and SEO built in and three months of ongoing work.', features: ['Everything in Starter', 'Tailored design and a second mockup', 'In-depth keyword and competitor research', 'Up to 4 pages with content', '5 blog articles in total', '3 months of support, maintenance and SEO tune-ups'], href: '/contact/', featured: true },
  { name: 'Prime', price: '₹65,000', line: 'I need help managing my online presence.', detail: 'A custom website and six months of continued content, social and website support.', features: ['Everything in Growth', 'Custom design built around your brand', 'Up to 5 pages with content', '7 blog articles in total', '6 months of support, maintenance and SEO tune-ups', '10 social posts a month across 5 platforms'], href: '/contact/' },
];
---

<Layout metadata={metadata} pageClass="home-concept-page">
  <StructuredData slot="head" schema={structuredData} />

  <main class="hc-page">
    <!-- HERO: lead with the visitor's desired outcome, not our capabilities. -->
    <section class="hc-hero">
      <div class="hc-wrap hc-hero-grid">
        <div class="hc-hero-copy">
          <p class="hc-eyebrow"><span></span> Website design &amp; development · Bhubaneswar, India</p>
          <h1>Your business deserves more than <em>just a website.</em></h1>
          <p class="hc-intro">You need an online presence that helps the right people understand what you offer, trust your business and take the next step.</p>
          <p class="hc-support">We plan and build websites around your business, with the content, SEO and support that help them work.</p>
          <div class="hc-actions">
            <a class="hc-button hc-button-primary" href="/contact/">Let's discuss your website <span aria-hidden="true">↗</span></a>
            <a class="hc-text-link" href="#approach">See how we work <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hc-location-note">Based in Bhubaneswar. Working with small businesses across India and worldwide.</p>
        </div>

        <div class="hc-hero-visual" aria-label="A website connected to its essential parts: clear content, search visibility and ongoing support.">
          <div class="hc-browser">
            <div class="hc-browser-bar"><span></span><span></span><span></span><small>yourbusiness.in</small></div>
            <div class="hc-browser-body">
              <div class="hc-mini-nav"><b>YOUR BRAND</b><span>About&nbsp;&nbsp; Services&nbsp;&nbsp; Contact</span></div>
              <div class="hc-mini-content">
                <div class="hc-mini-copy"><i></i><b>A clearer way<br />to grow your business.</b><span></span><span></span><span></span><strong>Explore what we do&nbsp; ↗</strong></div>
                <div class="hc-mini-art"><div class="hc-art-card hc-art-back"></div><div class="hc-art-card hc-art-front"><i></i><b></b><span></span><span></span></div></div>
              </div>
              <div class="hc-mini-foot"><span>CONTENT</span><span>SEARCH</span><span>SUPPORT</span></div>
            </div>
          </div>
          <div class="hc-visual-caption"><span class="hc-caption-mark">✓</span><span><b>Planned around your business</b><small>Not assembled from a feature checklist.</small></span></div>
        </div>
      </div>
    </section>

    <!-- THE PROBLEM: make the villain a poor process, not another agency. -->
    <section class="hc-problem" id="why-it-matters">
      <div class="hc-wrap hc-problem-grid">
        <div>
          <p class="hc-eyebrow">The problem with “just build me a website”</p>
          <h2>A good-looking website can still be the <em>wrong starting point.</em></h2>
        </div>
        <div class="hc-problem-copy">
          <p>When the conversation starts with colours, pages and features, the important questions can get missed.</p>
          <ul class="hc-check-list">
            <li>Who are you trying to reach?</li>
            <li>What do those people need to know before they choose you?</li>
            <li>How will they find your website?</li>
            <li>What should happen after the site goes live?</li>
          </ul>
          <p class="hc-emphasis">Without those answers, even a polished website can struggle to do its job.</p>
        </div>
      </div>
    </section>

    <!-- A REAL EXAMPLE: use the existing client story as proof of why planning matters. -->
    <section class="hc-story">
      <div class="hc-wrap hc-story-grid">
        <div class="hc-story-label"><p class="hc-eyebrow">A real-world lesson</p><span>Planning matters<br />before design begins.</span></div>
        <div class="hc-story-main">
          <h2>One decision made too early can mean <em>starting over.</em></h2>
          <p>A client had already chosen a domain and logo before the website was planned. After the website was ready, a trademark conflict forced a change of name, domain and logo.</p>
          <div class="hc-story-sequence">
            <div><b>01</b><strong>Domain + logo</strong><span>Chosen before the website was planned.</span></div>
            <div><b>02</b><strong>Trademark conflict</strong><span>Discovered after the website was ready.</span></div>
            <div><b>03</b><strong>Start again</strong><span>Name, domain and logo had to change.</span></div>
          </div>
          <p class="hc-story-takeaway">The lesson: get the foundations right before investing in the build.</p>
        </div>
      </div>
    </section>

    <!-- THE GUIDE: explain the approach in plain language. -->
    <section class="hc-approach" id="approach">
      <div class="hc-wrap">
        <div class="hc-section-heading hc-heading-narrow">
          <p class="hc-eyebrow">A more considered approach</p>
          <h2>Start with your business.<br /><em>Then build the website.</em></h2>
          <p>We help you make the decisions in the right order, so your website has a clear purpose before a page is designed.</p>
        </div>
        <div class="hc-principles">
          <article><span>01</span><h3>Understand first</h3><p>Your audience, goals and budget shape the project. Not a pre-set list of features.</p></article>
          <article><span>02</span><h3>Plan the whole picture</h3><p>Domain, structure, content and search are considered together, before development begins.</p></article>
          <article><span>03</span><h3>Think beyond launch</h3><p>Your website needs to stay secure, useful and up to date after it goes live.</p></article>
        </div>
      </div>
    </section>

    <!-- SERVICES: show the parts of the solution without turning them into a feature maze. -->
    <section class="hc-services" id="services">
      <div class="hc-wrap">
        <div class="hc-section-heading hc-heading-row">
          <div><p class="hc-eyebrow">What we can help with</p><h2>The pieces of your online presence, <em>working together.</em></h2></div>
          <p>Choose the support you need now. Bring the other pieces in when your business is ready.</p>
        </div>
        <div class="hc-service-list">
          {services.map((service) => (
            <article class="hc-service">
              <span class="hc-service-number">{service.n}</span>
              <div><h3>{service.title}</h3><p>{service.text}</p></div>
              <a href={service.href}>{service.link} <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- PROCESS: give the visitor a simple plan. -->
    <section class="hc-process">
      <div class="hc-wrap">
        <div class="hc-section-heading hc-heading-narrow">
          <p class="hc-eyebrow">A straightforward process</p>
          <h2>Know what happens <em>at every step.</em></h2>
          <p>No mystery process. We agree what needs to be done, why it matters and what comes next.</p>
        </div>
        <ol class="hc-steps">
          {steps.map((step) => <li><span>{step.n}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}
        </ol>
      </div>
    </section>

    <!-- PROOF: use actual work and existing client feedback. -->
    <section class="hc-work" id="work">
      <div class="hc-wrap">
        <div class="hc-section-heading hc-heading-row">
          <div><p class="hc-eyebrow">A little of our work</p><h2>Built for real businesses. <em>Made to do a job.</em></h2></div>
          <p>Examples of websites we've built and continue to support.</p>
        </div>
        <div class="hc-projects">
          {projects.map((project) => (
            <a class="hc-project" href={project.url} target="_blank" rel="noopener noreferrer">
              <div class="hc-project-image"><Image src={project.image} alt={project.alt} loading="lazy" /></div>
              <div class="hc-project-meta"><span><b>{project.name}</b><small>{project.kind}</small></span><span class="hc-project-link">View website ↗</span></div>
            </a>
          ))}
        </div>
        <div class="hc-quote">
          <span class="hc-quote-mark">“</span>
          <blockquote>They were affordable, professional, and delivered exactly what I needed.</blockquote>
          <div><b>Arup Nayak</b><span>Founder, Purbaghat Masala</span></div>
        </div>
      </div>
    </section>

    <!-- PRICING: retain the established Starter / Growth / Prime offer and visible prices. -->
    <section class="hc-pricing" id="plans">
      <div class="hc-wrap">
        <div class="hc-section-heading hc-heading-narrow">
          <p class="hc-eyebrow">Clear starting points</p>
          <h2>Choose the level of support <em>you need today.</em></h2>
          <p>Each plan starts with a properly built website. The difference is how much research, content and ongoing support you want around it.</p>
        </div>
        <div class="hc-plan-grid">
          {plans.map((plan) => (
            <article class:list={["hc-plan", { "hc-plan-featured": plan.featured }]}>
              {plan.featured && <span class="hc-plan-tag">Most chosen</span>}
              <p class="hc-plan-name">{plan.name}</p>
              <h3>{plan.line}</h3>
              <p class="hc-plan-detail">{plan.detail}</p>
              <p class="hc-plan-price">{plan.price}<small> / project</small></p>
              <ul>{plan.features.map((feature) => <li>{feature}</li>)}</ul>
              <a class="hc-button" href={plan.href}>Discuss {plan.name} <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
        <p class="hc-pricing-note">Not sure which plan fits? Tell us what you're trying to achieve. We'll help you work out what you actually need.</p>
      </div>
    </section>

    <!-- FINAL CTA: invite a low-friction first conversation. -->
    <section class="hc-contact" id="contact">
      <div class="hc-wrap hc-contact-inner">
        <div><p class="hc-eyebrow">Your next step</p><h2>Let's plan a website that <em>works for your business.</em></h2><p>Start with a conversation about your business, your goals and your budget. We'll take it from there.</p></div>
        <a class="hc-button hc-button-primary" href="/contact/">Get a free consultation <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .hc-page{--hc-ink:#172b27;--hc-muted:#65736f;--hc-line:#e2e9e5;--hc-paper:#fff;--hc-soft:#f6f8f6;--hc-green:#176b50;--hc-lime:#c9ef62;color:var(--hc-ink);background:var(--hc-paper);font-family:Inter,ui-sans-serif,system-ui,sans-serif}
  .hc-page *{box-sizing:border-box}.hc-wrap{width:min(1160px,calc(100% - 48px));margin-inline:auto}.hc-page a{color:inherit}.hc-eyebrow{display:flex;align-items:center;gap:10px;margin:0 0 22px;color:var(--hc-green);font-size:12px;font-weight:750;letter-spacing:.13em;text-transform:uppercase}.hc-eyebrow span{width:8px;height:8px;border-radius:50%;background:var(--hc-lime)}
  .hc-hero{padding:clamp(76px,10vw,132px) 0 88px;background:linear-gradient(180deg,#fff 0%,#fbfcfa 100%)}.hc-hero-grid{display:grid;grid-template-columns:1.04fr .96fr;gap:clamp(40px,7vw,92px);align-items:center}.hc-hero h1{max-width:700px;margin:0 0 25px;font-size:clamp(44px,6vw,76px);line-height:1.04;letter-spacing:-.055em;font-weight:760}.hc-hero h1 em,.hc-page h2 em{font-style:normal;color:var(--hc-green)}.hc-intro{max-width:610px;margin:0 0 14px;font-size:clamp(19px,2vw,23px);line-height:1.55;font-weight:550}.hc-support{max-width:590px;margin:0;color:var(--hc-muted);font-size:16px;line-height:1.75}.hc-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin-top:34px}.hc-button{display:inline-flex;justify-content:center;align-items:center;gap:18px;padding:15px 20px;border:1px solid var(--hc-green);border-radius:7px;background:#fff;color:var(--hc-green);font-size:14px;font-weight:750;text-decoration:none;transition:background .2s,color .2s,transform .2s}.hc-button:hover{transform:translateY(-2px);background:var(--hc-green);color:#fff}.hc-button-primary{background:var(--hc-green);color:#fff}.hc-button-primary:hover{background:#104f3b}.hc-text-link{font-size:14px;font-weight:700;text-decoration:none;border-bottom:1px solid #a9b8b1;padding-bottom:5px}.hc-location-note{margin:34px 0 0;color:var(--hc-muted);font-size:12px}
  .hc-hero-visual{position:relative;padding:24px 12px 50px}.hc-browser{overflow:hidden;border:1px solid #dce5df;border-radius:13px;background:#fff;box-shadow:0 28px 75px -45px rgba(19,52,39,.32);transform:rotate(1deg)}.hc-browser-bar{height:42px;display:flex;align-items:center;gap:6px;padding:0 14px;background:#f3f6f3;border-bottom:1px solid var(--hc-line)}.hc-browser-bar>span{width:7px;height:7px;border-radius:50%;background:#c5d0ca}.hc-browser-bar small{margin-left:12px;color:#87948e;font-size:10px}.hc-browser-body{padding:22px 24px 16px}.hc-mini-nav{display:flex;justify-content:space-between;gap:12px;padding-bottom:22px;border-bottom:1px solid #edf1ed;font-size:8px;color:#77847e}.hc-mini-nav b{color:var(--hc-ink);letter-spacing:.08em}.hc-mini-content{display:grid;grid-template-columns:1fr .85fr;gap:18px;align-items:center;min-height:245px}.hc-mini-copy i{display:block;width:35px;height:4px;margin-bottom:15px;border-radius:4px;background:var(--hc-lime)}.hc-mini-copy>b{display:block;font-size:clamp(17px,2vw,26px);line-height:1.15;letter-spacing:-.04em}.hc-mini-copy>span{display:block;width:90%;height:5px;margin-top:12px;border-radius:5px;background:#e8eeea}.hc-mini-copy>span+span{width:72%;margin-top:7px}.hc-mini-copy>span+span+span{width:52%;margin-top:7px}.hc-mini-copy strong{display:inline-block;margin-top:20px;padding:9px 11px;border-radius:4px;background:var(--hc-green);color:#fff;font-size:8px}.hc-mini-art{position:relative;height:160px}.hc-art-card{position:absolute;border-radius:8px}.hc-art-back{inset:10px 0 0 22px;background:#e6f0e8;transform:rotate(7deg)}.hc-art-front{inset:0 20px 12px 0;padding:18px;background:#d5e5d9;box-shadow:0 14px 25px -20px #173b2b}.hc-art-front i{display:block;width:44px;height:44px;margin-bottom:13px;border-radius:50%;background:var(--hc-lime)}.hc-art-front b{display:block;width:80%;height:7px;margin-bottom:8px;border-radius:6px;background:#668878}.hc-art-front span{display:block;width:90%;height:4px;margin-top:6px;border-radius:5px;background:#9ab3a2}.hc-art-front span+span{width:65%}.hc-mini-foot{display:flex;justify-content:space-between;padding-top:14px;border-top:1px solid #edf1ed;color:#708078;font-size:8px;font-weight:750;letter-spacing:.1em}.hc-visual-caption{position:absolute;right:-5px;bottom:4px;display:flex;align-items:center;gap:11px;padding:13px 17px;border:1px solid var(--hc-line);border-radius:8px;background:#fff;box-shadow:0 12px 30px -24px #193d2d}.hc-caption-mark{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#edf5e8;color:var(--hc-green);font-weight:800}.hc-visual-caption b,.hc-visual-caption small{display:block}.hc-visual-caption b{font-size:11px}.hc-visual-caption small{margin-top:3px;color:var(--hc-muted);font-size:10px}
  .hc-problem{padding:100px 0;background:var(--hc-soft)}.hc-problem-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(40px,9vw,130px)}.hc-page h2{margin:0;font-size:clamp(32px,4vw,49px);line-height:1.12;letter-spacing:-.045em}.hc-problem-copy>p{margin:0 0 20px;color:var(--hc-muted);font-size:17px;line-height:1.75}.hc-check-list{display:grid;gap:12px;margin:24px 0;padding:0;list-style:none}.hc-check-list li{position:relative;padding-left:26px;font-size:15px;line-height:1.55}.hc-check-list li:before{content:'✓';position:absolute;left:0;color:var(--hc-green);font-weight:800}.hc-problem-copy .hc-emphasis{margin-top:24px;color:var(--hc-ink);font-weight:700}
  .hc-story{padding:96px 0;background:#f0f5f0}.hc-story-grid{display:grid;grid-template-columns:.55fr 1.45fr;gap:60px}.hc-story-label>span{display:block;color:var(--hc-muted);font-size:15px;line-height:1.55}.hc-story-main h2{max-width:760px}.hc-story-main>p{max-width:760px;color:var(--hc-muted);font-size:16px;line-height:1.8}.hc-story-sequence{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:34px 0 24px}.hc-story-sequence>div{min-height:140px;padding:18px;border-top:2px solid #a8bcae;background:rgba(255,255,255,.65)}.hc-story-sequence b,.hc-story-sequence strong,.hc-story-sequence span{display:block}.hc-story-sequence b{margin-bottom:20px;color:var(--hc-green);font-size:11px}.hc-story-sequence strong{margin-bottom:7px;font-size:14px}.hc-story-sequence span{color:var(--hc-muted);font-size:12px;line-height:1.55}.hc-story-main .hc-story-takeaway{color:var(--hc-green);font-weight:750}
  .hc-approach{padding:104px 0 112px}.hc-section-heading{margin-bottom:45px}.hc-heading-narrow{max-width:760px}.hc-section-heading>p:not(.hc-eyebrow){max-width:650px;margin:18px 0 0;color:var(--hc-muted);font-size:16px;line-height:1.75}.hc-principles{display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.hc-principles article{padding:26px 0 0;border-top:1px solid var(--hc-line)}.hc-principles article>span{color:var(--hc-green);font-size:12px;font-weight:800}.hc-principles h3{margin:18px 0 9px;font-size:20px;letter-spacing:-.02em}.hc-principles p{max-width:330px;margin:0;color:var(--hc-muted);font-size:14px;line-height:1.75}
