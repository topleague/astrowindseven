---
import Layout from '~/layouts/PageLayout.astro';
import SxEffects from '~/components/sx/SxEffects.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Website Design & Development Company in Bhubaneswar | Top League',
  description:
    'Need a website for your small business? Top League plans website design, content and SEO around your goals. Based in Bhubaneswar, serving clients worldwide.',
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher (unchanged from the original page).
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];

const contactLink = '/contact/';

const city = 'Bhubaneswar, Odisha, India';

const stats = [
  { n: 16, l: 'years running Top League' },
  { n: 30, s: '+', l: 'websites built recently' },
  { n: 20, l: 'websites currently maintained' },
  { n: 10, l: 'countries with clients served' },
];

// What we do: outcome-led, each card links to a real page.
const services = [
  { icon: 'tabler:layout-dashboard', t: 'Websites', d: 'Fast, mobile-friendly WordPress sites built around your brand, with on-page SEO set up from day one.', links: [{ l: 'Website development', h: '/website-development/' }] },
  { icon: 'tabler:pencil', t: 'Content', d: 'Articles, page copy and product descriptions written for your customers and for search, in your voice.', links: [{ l: 'Article writing', h: '/seo-article-writing/' }, { l: 'Copywriting', h: '/seo-copywriting/' }, { l: 'Product descriptions', h: '/product-description-writing/' }] },
  { icon: 'tabler:chart-line', t: 'SEO + Social', d: 'Search visibility and social activity that point the right people to the site you already have.', links: [{ l: 'SEO services', h: '/seo-services/' }] },
  { icon: 'tabler:shield-check', t: 'Care + Data', d: 'Updates, security, analytics and reporting after launch, so the site stays useful.', links: [{ l: 'Ask about care plans', h: '/contact/' }] },
];

// Journey: planning first, no invented durations.
const journey = [
  { dot: '1', k: 'PLAN', t: 'Understand the business', d: 'Audience, goals, budget, domain and the pages you actually need.' },
  { dot: '2', k: 'BUILD', t: 'Design, write, build', d: 'Content and SEO are mapped before pages are assembled, so nothing is squeezed in at the end.' },
  { dot: '3', k: 'LAUNCH', t: 'Test and go live', d: 'Speed, mobile and basic security are checked before the site is public.' },
  { dot: '4', k: 'CARE', t: 'Keep it working', d: 'Updates, analytics and new content, so the site keeps earning its place.' },
];

// Recent work: descriptions are from the website-development page.
const work = [
  { t: 'Purbaghat Masala', k: 'Custom WordPress child theme', d: 'The client wanted a unique online presence, not a generic template. We built a custom child theme and worked page by page on imagery and colour palette to match the brand.' },
  { t: 'Decyphr', k: 'IT consultancy website', d: 'After a requirements analysis, we built a site focused on speed and performance, and we look after the whole digital presence.' },
];

const faqs = [
  { q: 'How much does a website cost?', a: 'The cost depends on the scope, number of pages, design requirements and content needed. We discuss your goals and budget first, then recommend a practical approach. You can also review the website packages on our website.' },
  { q: 'How long does a website take?', a: 'The timeline depends on the project scope and how quickly the content and other inputs are ready. We agree on the scope and timeline before work begins.' },
  { q: 'Do you only build websites?', a: 'No. We also provide article writing, website copywriting, product descriptions and SEO services. The aim is to make the website and the content and search work around it.' },
  { q: 'Do you work with clients outside Bhubaneswar?', a: 'Yes. Top League is based in Bhubaneswar and has served clients across India and in other countries. Projects can be coordinated remotely.' },
];

const usualWay = [
  { title: 'Start with the website', description: 'The first question is “What kind of website do you want?”. A list of pages and features becomes the plan, and the business comes second.' },
  { title: 'Treat requirements as the strategy', description: 'A quote follows the feature list. The real budget surfaces later, usually as a compromise.' },
  { title: 'Choose what is familiar', description: 'Domain, hosting and platform are picked by habit, convenience or the lowest price.' },
  { title: 'Build first, think about SEO later', description: 'Pages are designed and written first. Search intent and site structure are considered afterwards.' },
  { title: 'Fill the pages at the end', description: 'Copy and images arrive late and get squeezed into whatever space the design left.' },
  { title: 'Launch and move on', description: 'Speed, security, social presence and fresh content become somebody else’s problem.' },
];
const topLeagueWay = [
  { title: 'Start with the business', description: 'We begin with your audience, your goals and what success means to you. Only then do we decide which pages and features earn a place.' },
  { title: 'Plan around the real budget', description: 'Budget is part of the first conversation, so the plan is practical rather than padded.' },
  { title: 'Choose foundations deliberately', description: 'Domain, hosting and CMS, platform or framework follow your requirements, not whatever we happen to use.' },
  { title: 'Map SEO before building pages', description: 'Search intent, keywords, structure and the pages you need to compete are decided before the build begins.' },
  { title: 'Create content around the plan', description: 'Content and visuals are prepared with your audience and search goals in mind, before the pages are assembled.' },
  { title: 'Plan for life after launch', description: 'We build for speed and security from the start, keep social aligned with the site, and stay on for updates, analytics and new content.' },
];
const tabNames = ['Starting point', 'Budget', 'Foundations', 'SEO', 'Content', 'After launch'];

const mistake = [
  { t: 'Domain + logo', d: 'Chosen before the website was planned.' },
  { t: 'Trademark conflict', d: 'Discovered after the website was ready.' },
  { t: 'Domain + logo abandoned', d: 'A change of name, domain and logo.' },
];

const quotes = [
  { t: 'Very Professional!', q: 'Top League is the only company I use for my article writing needs. They are very professional and work with you throughout the project with constant updates. I recommend their services to anyone considering outsourcing their content writing.', name: 'Daniel', job: 'Founder / Future Success' },
  { t: 'Readily Available!', q: 'Top League did a great job writing content for our website. They followed our direction very closely and were readily available for every stage of the project. I would highly recommend their writing skills and will be utilizing their services again. Great Job!', name: 'Jason Hamblin', job: 'Sr. Executive / L2T Media' },
  { t: 'Always the Best!', q: 'Top League have been excellent at presenting their work and work very hard to ensure that the quality of their work is always the best! Thank you Top League! I look forward to continuing our business together.', name: 'Michael', job: 'Founder / Idea Bubble' },
];
const initials = (name) => name.trim().split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();

// Orbit: five layers around the website
const orbit = ['Domain', 'Content', 'SEO', 'Social', 'Care'].map((label, i) => {
  const a = (-90 + i * 72) * Math.PI / 180;
  return { label, i, x: Math.round(270 + 165 * Math.cos(a)), y: Math.round(230 + 165 * Math.sin(a)) };
});

const marquee = ['Business', 'Website', 'Content', 'SEO', 'Social', 'Care'].join(' ✦ ') + ' ✦ ';
---

<Layout metadata={metadata} pageClass="product-description-page">
  <StructuredData slot="head" schema={structuredData} />

  <SxEffects />

  <div class="sx-page">
    <div class="sx-progress" aria-hidden="true"><span></span></div>

    <!-- 1. HERO SECTION -->
    <section class="sx-hero">
      <div class="sx-wrap sx-hero-grid">
        <div class="sx-hero-copy">
          <div class="sx-pill"><span class="sx-dot"></span> Website design &amp; development for small businesses</div>
          <h1>
            Build Your Online Presence,
            <span>Not Just a Website.</span>
          </h1>
          <p>
            Based in Bhubaneswar, we help small businesses across India and worldwide build a useful online presence. We start with your business, goals and budget, then plan the website, content and SEO around them.
          </p>
          <div class="sx-actions">
            <a class="sx-btn sx-btn-primary" href="#contact">Free consultation <i>↗</i></a>
            <a class="sx-btn sx-btn-ghost" href="#difference">See how we work <i>↓</i></a>
          </div>
          <div class="sx-note">Websites · Content · SEO + Social · Care + Data</div>
        </div>

        <div class="sx-stage" role="img" aria-label="Illustration: a website at the centre, connected to the domain, content, SEO, social presence and ongoing care around it.">
          <svg viewBox="0 0 540 460" aria-hidden="true">
            <circle class="sx-rip" cx="270" cy="230" r="215" style="--d:0s" />
            <circle class="sx-rip" cx="270" cy="230" r="215" style="--d:2s" />
            <circle class="sx-rip" cx="270" cy="230" r="215" style="--d:4s" />
            <circle class="sx-ring2" cx="270" cy="230" r="165" />
            {orbit.map((o) => <line class="sx-spoke" x1="270" y1="230" x2={o.x} y2={o.y} />)}
            {orbit.map((o) => (
              <g class="sx-sat" style={`--i:${o.i}`}>
                <circle cx={o.x} cy={o.y} r="40" />
                <text x={o.x} y={o.y + 5}>{o.label}</text>
              </g>
            ))}
            <g class="sx-core">
              <circle class="sx-halo" cx="270" cy="230" r="62" />
              <circle cx="270" cy="230" r="44" />
            </g>
            <text class="sx-svgt" x="270" y="235">Website</text>
          </svg>
          <span class="sx-pin" style="left:0;top:6%"><b>1</b> Domain &amp; brand</span>
          <span class="sx-pin" style="right:0;top:48%"><b>2</b> Content &amp; search</span>
          <span class="sx-pin" style="left:4%;bottom:4%"><b>3</b> Care after launch</span>
        </div>
      </div>
    </section>

    <!-- 2. NUMBERS -->
    <section class="sx-proof">
      <div class="sx-wrap sx-proof-grid">
        <div class="sx-proof-lead sx-reveal">Based in Bhubaneswar.<br />Working with clients across borders.</div>
        <div class="sx-stats">
          {stats.map((s, i) => (
            <div class="sx-stat sx-reveal" style={`--d:${i * 0.08}s`}>
              <div class="sx-num"><span data-sx-count={s.n}>{s.n}</span>{s.s}</div>
              <div class="sx-stat-l">{s.l}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. WHAT WE DO -->
    <section class="sx-section" id="services">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">What we do</div>
          <h2 class="sx-h2 sx-reveal">The pieces of your online presence, working together.</h2>
          <p class="sx-lead sx-reveal">Start with the service you need. We can also help you connect the website, content and search strategy instead of treating them as separate jobs.</p>
        </div>
        <div class="sx-bento">
          {services.map((s, i) => (
            <article class="sx-card sx-glow sx-reveal sx-b6" style={`--d:${i * 0.08}s`}>
              <span class="sx-ico" style="margin:6px 0 18px"><Icon name={s.icon} class="h-5 w-5" /></span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
              <p style="margin-top:14px;display:flex;flex-wrap:wrap;gap:6px 18px">
                {s.links.map((l) => (<a href={l.h} style="font-weight:700;color:var(--ink);text-decoration:underline;text-underline-offset:3px">{l.l}</a>))}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. THE DIFFERENCE (tabs) -->
    <section class="sx-section sx-alt" id="difference">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">The Top League difference</div>
          <h2 class="sx-h2 sx-reveal">A website is only as good as the thinking behind it.</h2>
          <p class="sx-lead sx-reveal">Your domain, brand, content and search visibility all shape what happens after launch. Here’s what we do differently before we build, while we build, and after we launch.</p>
        </div>

        <div data-sx-tabs>
          <div class="sx-tabs" role="tablist" aria-label="Where we do things differently">
            {tabNames.map((n, i) => (
              <button class="sx-tab" role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'}>{n}</button>
            ))}
          </div>
          {tabNames.map((n, i) => (
            <div class="sx-panel" role="tabpanel">
              <div class="sx-panel-t">{n}</div>
              <div class="sx-vs">
                <article class="sx-vs-card sx-vs-old">
                  <div class="sx-vs-k"><span class="sx-x">×</span> The usual way</div>
                  <h3>{usualWay[i].title}</h3>
                  <p>{usualWay[i].description}</p>
                </article>
                <div class="sx-vs-badge" aria-hidden="true">VS</div>
                <article class="sx-vs-card sx-vs-new">
                  <div class="sx-vs-k"><span class="sx-tick">✓</span> The Top League approach</div>
                  <h3>{topLeagueWay[i].title}</h3>
                  <p>{topLeagueWay[i].description}</p>
                </article>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. REAL CLIENT STORY -->
    <section class="sx-section sx-night" id="reality">
      <div class="sx-wrap sx-story-grid">
        <div class="sx-sticky">
          <div class="sx-kicker sx-reveal">Based on a real client story</div>
          <h2 class="sx-h2 sx-reveal" style="max-width:none">What an expensive mistake looks like!</h2>
          <blockquote class="sx-bigq sx-reveal">A trademark conflict forced a change of name, domain and logo. Bummer.</blockquote>
          <div class="sx-copy">
            <p class="sx-reveal">A client came to us with a domain and logo already chosen. After the website was ready, a trademark conflict forced a change of name, domain and logo.</p>
          </div>
        </div>
        <ol class="sx-steps">
          {mistake.map((m, i) => (
            <li class="sx-reveal" style={`--d:${i * 0.1}s`}>
              <span>{i + 1}</span>
              <div>
                <div class="sx-p-t">{m.t}</div>
                <div class="sx-p-d">{m.d}</div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6. JOURNEY -->
    <section class="sx-section" id="howdy">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">How we work</div>
          <h2 class="sx-h2 sx-reveal">From first conversation to a site that keeps working.</h2>
        </div>
        <ol class="sx-tl sx-watch" style={`--n:${journey.length}`}>
          {journey.map((s) => (
            <li>
              <span class="sx-tl-dot">{s.dot}</span>
              <div class="sx-tl-k">{s.k}</div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. RECENT WORK -->
    <section class="sx-section sx-alt" id="work">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">Recent work</div>
          <h2 class="sx-h2 sx-reveal">Websites we’ve built for real businesses.</h2>
        </div>
        <div class="sx-quotes is-two">
          {work.map((w, i) => (
            <article class="sx-quote sx-reveal" style={`--d:${i * 0.08}s`}>
              <div class="sx-card-k" style="margin:0">{w.k}</div>
              <div class="sx-quote-t">{w.t}</div>
              <p>{w.d}</p>
              
            </article>
          ))}
        </div>
        <p class="sx-lead sx-reveal">These examples show website work; the client testimonials below relate to our content-writing services.</p>
      </div>
    </section>

    <!-- 8. CLIENT WORDS -->
    <section class="sx-section sx-night" id="proof">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">Content clients</div>
          <h2 class="sx-h2 sx-reveal">What clients say about working with us.</h2>
        </div>
        <div class="sx-quotes">
          {quotes.map((q, i) => (
            <article class="sx-quote sx-reveal" style={`--d:${i * 0.08}s`}>
              <div class="sx-stars" role="img" aria-label="5 out of 5 stars">★★★★★</div>
              <div class="sx-quote-t">{q.t}</div>
              <p>“{q.q}”</p>
              <div class="sx-person">
                <span class="sx-av" aria-hidden="true">{initials(q.name)}</span>
                <div class="sx-who">
                  <b>{q.name}</b>
                  <span>{q.job}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 9. PROJECT SCOPE -->
    <section class="sx-section" id="project-scope">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">Scope and budget</div>
          <h2 class="sx-h2 sx-reveal">Start with what your business actually needs.</h2>
          <p class="sx-lead sx-reveal">Not every business needs the same website or the same level of support. We discuss your goals and budget first, then work out the pages, content and features that make sense.</p>
        </div>
        <div class="sx-bento">
          <article class="sx-card sx-glow sx-reveal sx-b7">
            <h3>Website packages</h3>
            <p>Review the available website packages and what each includes. If your requirements are different, get in touch to discuss the project.</p>
            <p style="margin-top:14px"><a class="sx-btn sx-btn-dark" href="/website-development/">Explore website packages <i>↗</i></a></p>
          </article>
          <article class="sx-card sx-glow sx-reveal sx-b5" style="--d:.08s">
            <div class="sx-card-k" style="margin-top:0">After launch</div>
            <h3>Support beyond the build</h3>
            <p>Ask us about ongoing website updates, analytics and content support after your site goes live.</p>
            <p style="margin-top:14px"><a href="/contact/" style="font-weight:700;color:var(--ink);text-decoration:underline;text-underline-offset:3px">Discuss ongoing support</a></p>
          </article>
        </div>
      </div>
    </section>

    <!-- 10. FAQ -->
    <section class="sx-section sx-alt" id="faq">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">Questions</div>
          <h2 class="sx-h2 sx-reveal">Common questions.</h2>
        </div>
        <ul class="sx-problems">
          {faqs.map((f) => (
            <li class="sx-reveal">
              <span class="sx-ico" aria-hidden="true">?</span>
              <details style="flex:1">
                <summary class="sx-p-t" style="cursor:pointer;margin:0">{f.q}</summary>
                <div class="sx-p-d" style="margin-top:10px">{f.a}</div>
              </details>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 11. MARQUEE -->
    <div class="sx-marquee" aria-hidden="true">
      <div class="sx-marquee-track">
        <span>{marquee}</span>
        <span>{marquee}</span>
        <span>{marquee}</span>
        <span>{marquee}</span>
      </div>
    </div>

    <!-- 12. CTA -->
    <section class="sx-cta" id="contact">
      <div class="sx-wrap">
        <div class="sx-cta-card sx-reveal">
          <div>
            <div class="sx-kicker sx-kicker-lime">Let's talk</div>
            <h2>Planning a website in Bhubaneswar, or from anywhere?</h2>
            <p>No giant proposal. No unnecessary package. Start with the business, the goal and the budget, and we'll work out the plan from there.</p>
            <p>{city}</p>
          </div>
          <a class="sx-btn sx-btn-primary sx-btn-lg" href={contactLink}>Get a free consultation <i>↗</i></a>
        </div>
      </div>
    </section>
  </div>
</Layout>
