  .testimonial-card blockquote { position: relative; margin: 0 0 30px; font-size: 17px; line-height: 1.75; color: var(--ink); }
  .quote-person { display: flex; align-items: center; gap: 12px; border-top: 1px solid var(--line); padding-top: 18px; }
  .quote-initial { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: var(--night); color: var(--lime); font-weight: 850; }
  .quote-person strong, .quote-person small { display: block; }
  .quote-person strong { font-size: 13px; color: var(--ink); }
  .quote-person small { font-size: 11px; color: var(--muted); margin-top: 3px; }
  @media (max-width: 980px) { .proof-layout { grid-template-columns: 1fr; } }
