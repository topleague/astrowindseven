---
import Layout from '~/layouts/PageLayout.astro';
import SxEffects from '~/components/sx/SxEffects.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Website Design & Development in Bhubaneswar | Top League',
  description:
    'Website design and development in Bhubaneswar, planned around your goals and budget, with content, SEO and maintenance. Clients across India and worldwide.',
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher (unchanged from the original page).
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];

const contactLink = '/contact/';

// ---------------------------------------------------------------------------
// PLACEHOLDERS: every value in [square brackets] below is NOT real yet.
// Search this file for "[" or "TODO" and replace before launch.
// ---------------------------------------------------------------------------
const P = {
  phone: '[phone / WhatsApp number]',            // TODO
  city: 'Bhubaneswar, Odisha, India',            // confirm wording
};

const stats = [
  { n: 16, l: 'years running Top League' },          // TODO confirm: company since 2010, kept separate from the founder's own experience
  { n: 30, s: '+', l: 'websites built recently' },
  { n: 20, l: 'websites currently maintained' },
  { n: 10, l: 'countries with clients served' },
];

// What we do: outcome-led, each card links to a real page.
const services = [
  { icon: 'tabler:layout-dashboard', t: 'Website design & development', d: 'Fast, mobile-friendly WordPress sites built around your brand, with on-page SEO set up from day one.', links: [{ l: 'Website development', h: '/website-development/' }] },
  { icon: 'tabler:pencil', t: 'Content writing', d: 'Articles, page copy and product descriptions written for your customers and for search, in your voice.', links: [{ l: 'Article writing', h: '/seo-article-writing/' }, { l: 'Copywriting', h: '/seo-copywriting/' }, { l: 'Product descriptions', h: '/product-description-writing/' }] },
  { icon: 'tabler:chart-line', t: 'SEO & social media', d: 'Search visibility and social activity that point the right people to the site you already have.', links: [{ l: 'SEO services', h: '/seo-services/' }] },
  { icon: 'tabler:shield-check', t: 'Website maintenance', d: 'Updates, backups, security checks and support after launch, so the site stays safe, current and working.', links: [{ l: 'Ask about maintenance', h: '/contact/' }] },
];

// Journey: planning first, no invented durations.
const journey = [
  { dot: '1', k: 'PLAN', t: 'Understand the business', d: 'Audience, goals, budget, domain and the pages you actually need.' },
  { dot: '2', k: 'BUILD', t: 'Design, write, build', d: 'Content and SEO are mapped before pages are assembled, so nothing is squeezed in at the end.' },
  { dot: '3', k: 'LAUNCH', t: 'Test and go live', d: 'Speed, mobile and basic security are checked before the site is public.' },
  { dot: '4', k: 'MAINTAIN', t: 'Keep it working', d: 'Updates, security checks and new content, so the site keeps earning its place.' },
];

// Client work: website clients. Wording is exactly as supplied; do not edit.
// "pull" is an exact excerpt of the review, shown large; "text" is the full review.
const clientWork = [
  {
    tab: 'Purbaghat Masala',
    pull: 'They were affordable, professional, and delivered exactly what I needed.',
    project: 'Custom WordPress child theme',
    blurb: 'We built a custom child theme and worked page by page on imagery and colour palette to match the brand.',
    text: `I've been incredibly impressed with Top League’s website development services. They were affordable, professional, and delivered exactly what I needed. Their team took the time to understand my requirements and then created a website that is both beautiful and functional. They also provided excellent support throughout the entire process, and I continue to rely on them for ongoing maintenance. I highly recommend Top League to anyone looking for a reliable and affordable WordPress development company.`,
    name: 'Arup Nayak', job: 'Founder, Purbaghat Masala',
  },
  {
    tab: 'Decyphr',
    pull: 'Their web development services are exceptional…',
    project: 'IT consultancy website',
    blurb: 'After a requirements analysis, we built a site focused on speed and performance, and we look after the whole digital presence.',
    text: `Collaborating with Top League has been an enjoyable experience. Their web development services are exceptional, providing a smooth and aesthetically impressive website that surpassed our expectations. What distinguishes them is their rapid support – any inquiries or challenges we encountered were promptly resolved, keeping our project on schedule. We wholeheartedly recommend Top League to anyone seeking to enhance their online presence with a skilled and attentive team!`,
    name: 'Dipan Rout', job: 'Founder, Decyphr Pvt Ltd',
  },
  {
    tab: 'Prof. Uday Damodaran',
    pull: 'Over the last six years, Top League have exceeded my expectations…',
    project: 'Website maintenance',
    blurb: 'Professional and personal websites, looked after by Top League over six years.',
    text: `Over the last six years, Top League have exceeded my expectations and delighted me with their personalized service in maintaining my professional and other websites.`,
    name: 'Prof. Uday Damodaran', job: 'Faculty, IIM Udaipur',
  },
];

const usualWay = [
  { title: 'Start with the website', description: 'The first question is “What kind of website do you want?”. A list of pages and features becomes the plan, and the business comes second.' },
  { title: 'Treat requirements as the strategy', description: 'A quote follows the feature list. The real budget surfaces later, usually as a compromise.' },
  { title: 'Choose what is familiar', description: 'Domain, hosting and platform are picked by habit, convenience or the lowest price.' },
  { title: 'Build first, think about SEO later', description: 'Pages are designed and written first. Search intent and site structure are considered afterwards.' },
  { title: 'Fill the pages at the end', description: 'Copy and images arrive late and get squeezed into whatever space the design left.' },
  { title: 'Launch and move on', description: 'Speed, security, social presence and fresh content become somebody else’s problem.' },
];
const topLeagueWay = [
  { title: 'Start with the business', description: 'We begin with your audience, your goals and what success means to you. Only then do we decide which pages and features earn a place.' },
  { title: 'Plan around the real budget', description: 'Budget is part of the first conversation, so the plan is practical rather than padded.' },
  { title: 'Choose foundations deliberately', description: 'Domain, hosting and CMS, platform or framework follow your requirements, not whatever we happen to use.' },
  { title: 'Map SEO before building pages', description: 'Search intent, keywords, structure and the pages you need to compete are decided before the build begins.' },
  { title: 'Create content around the plan', description: 'Content and visuals are prepared with your audience and search goals in mind, before the pages are assembled.' },
  { title: 'Plan for life after launch', description: 'We build for speed and security from the start, keep social aligned with the site, and stay on for updates, analytics and new content.' },
];
const tabNames = ['Starting point', 'Budget', 'Foundations', 'SEO', 'Content', 'After launch'];

const mistake = [
  { t: 'Domain + logo', d: 'Chosen before the website was planned.' },
  { t: 'Trademark conflict', d: 'Discovered after the website was ready.' },
  { t: 'Domain + logo abandoned', d: 'A change of name, domain and logo.' },
];

const initials = (name) => name.trim().split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();

// Orbit: five layers around the website
const orbit = ['Domain', 'Content', 'SEO', 'Social', 'Support'].map((label, i) => {
  const a = (-90 + i * 72) * Math.PI / 180;
  return { label, i, x: Math.round(270 + 165 * Math.cos(a)), y: Math.round(230 + 165 * Math.sin(a)) };
});

const marquee = ['Business', 'Website', 'Content', 'SEO', 'Social', 'Maintenance'].join(' ✦ ') + ' ✦ ';
---

<Layout metadata={metadata} pageClass="product-description-page">
  <StructuredData slot="head" schema={structuredData} />

  <SxEffects />

  <div class="sx-page">
    <div class="sx-progress" aria-hidden="true"><span></span></div>

    <!-- 1. HERO SECTION -->
    <section class="sx-hero">
      <div class="sx-wrap sx-hero-grid">
        <div class="sx-hero-copy">
          <div class="sx-pill"><span class="sx-dot"></span> Website design &amp; development in Bhubaneswar</div>
          <h1>
            Build Your Online Presence,
            <span>Not Just a Website.</span>
          </h1>
          <p>
            Based in Bhubaneswar, working with small businesses across India and worldwide. We start with your business, goal and budget, then plan the website, content, SEO and maintenance around them.
          </p>
          <div class="sx-actions">
            <a class="sx-btn sx-btn-primary" href="#contact">Free consultation <i>↗</i></a>
            <a class="sx-btn sx-btn-ghost" href="#plans">See plans and prices <i>↓</i></a>
          </div>
          <div class="sx-note">Website design · Content writing · SEO &amp; social media · Maintenance</div>
        </div>

        <div class="sx-stage" role="img" aria-label="Illustration: a website at the centre, connected to the domain, content, SEO, social presence and ongoing support around it.">
          <svg viewBox="0 0 540 460" aria-hidden="true">
            <circle class="sx-rip" cx="270" cy="230" r="215" style="--d:0s" />
            <circle class="sx-rip" cx="270" cy="230" r="215" style="--d:2s" />
            <circle class="sx-rip" cx="270" cy="230" r="215" style="--d:4s" />
            <circle class="sx-ring2" cx="270" cy="230" r="165" />
            {orbit.map((o) => <line class="sx-spoke" x1="270" y1="230" x2={o.x} y2={o.y} />)}
            {orbit.map((o) => (
              <g class="sx-sat" style={`--i:${o.i}`}>
                <circle cx={o.x} cy={o.y} r="40" />
                <text x={o.x} y={o.y + 5}>{o.label}</text>
              </g>
            ))}
            <g class="sx-core">
              <circle class="sx-halo" cx="270" cy="230" r="62" />
              <circle cx="270" cy="230" r="44" />
            </g>
            <text class="sx-svgt" x="270" y="235">Website</text>
          </svg>
          <span class="sx-pin" style="left:0;top:6%"><b>1</b> Domain &amp; brand</span>
          <span class="sx-pin" style="right:0;top:48%"><b>2</b> Content &amp; search</span>
          <span class="sx-pin" style="left:4%;bottom:4%"><b>3</b> Maintenance after launch</span>
        </div>
      </div>
    </section>

    <!-- 2. NUMBERS -->
    <section class="sx-proof">
      <div class="sx-wrap sx-proof-grid">
        <div class="sx-proof-lead sx-reveal">Based in Bhubaneswar.<br />Clients in 10 countries.</div>
        <div class="sx-stats">
          {stats.map((s, i) => (
            <div class="sx-stat sx-reveal" style={`--d:${i * 0.08}s`}>
              <div class="sx-num"><span data-sx-count={s.n}>{s.n}</span>{s.s}</div>
              <div class="sx-stat-l">{s.l}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. WHAT WE DO -->
    <section class="sx-section" id="services">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">What we do</div>
          <h2 class="sx-h2 sx-reveal">Website design, content, SEO and maintenance from one team.</h2>
          <p class="sx-lead sx-reveal">A website works best when the domain, content, search and social presence are planned together. Pick the part you need, or all of it.</p>
        </div>
        <div class="sx-bento">
          {services.map((s, i) => (
            <article class="sx-card sx-glow sx-reveal sx-b6" style={`--d:${i * 0.08}s`}>
              <span class="sx-ico" style="margin:6px 0 18px"><Icon name={s.icon} class="h-5 w-5" /></span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
              <p style="margin-top:14px;display:flex;flex-wrap:wrap;gap:6px 18px">
                {s.links.map((l) => (<a href={l.h} style="font-weight:700;color:var(--ink);text-decoration:underline;text-underline-offset:3px">{l.l}</a>))}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. REAL CLIENT STORY -->
    <section class="sx-section sx-night" id="reality">
      <div class="sx-wrap sx-story-grid">
        <div class="sx-sticky">
          <div class="sx-kicker sx-reveal">Based on a real client story</div>
          <h2 class="sx-h2 sx-reveal" style="max-width:none">What an expensive mistake looks like!</h2>
          <blockquote class="sx-bigq sx-reveal">A trademark conflict forced a change of name, domain and logo. Bummer.</blockquote>
          <div class="sx-copy">
            <p class="sx-reveal">A client came to us with a domain and logo already chosen. After the website was ready, a trademark conflict forced a change of name, domain and logo.</p>
          </div>
        </div>
        <ol class="sx-steps">
          {mistake.map((m, i) => (
            <li class="sx-reveal" style={`--d:${i * 0.1}s`}>
              <span>{i + 1}</span>
              <div>
                <div class="sx-p-t">{m.t}</div>
                <div class="sx-p-d">{m.d}</div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5. THE DIFFERENCE (tabs) -->
    <section class="sx-section sx-alt" id="difference">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">The Top League difference</div>
          <h2 class="sx-h2 sx-reveal">A website is only as good as the thinking behind it.</h2>
          <p class="sx-lead sx-reveal">Your domain, brand, content and search visibility all shape what happens after launch. Here’s what we do differently before we build, while we build, and after we launch.</p>
        </div>

        <div data-sx-tabs>
          <div class="sx-tabs" role="tablist" aria-label="Where we do things differently">
            {tabNames.map((n, i) => (
              <button class="sx-tab" role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'}>{n}</button>
            ))}
          </div>
          {tabNames.map((n, i) => (
            <div class="sx-panel" role="tabpanel">
              <div class="sx-panel-t">{n}</div>
              <div class="sx-vs">
                <article class="sx-vs-card sx-vs-old">
                  <div class="sx-vs-k"><span class="sx-x">×</span> The usual way</div>
                  <h3>{usualWay[i].title}</h3>
                  <p>{usualWay[i].description}</p>
                </article>
                <div class="sx-vs-badge" aria-hidden="true">VS</div>
                <article class="sx-vs-card sx-vs-new">
                  <div class="sx-vs-k"><span class="sx-tick">✓</span> The Top League approach</div>
                  <h3>{topLeagueWay[i].title}</h3>
                  <p>{topLeagueWay[i].description}</p>
                </article>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. JOURNEY -->
    <section class="sx-section" id="howdy">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">How we work</div>
          <h2 class="sx-h2 sx-reveal">From first conversation to a site that keeps working.</h2>
        </div>
        <ol class="sx-tl sx-watch" style={`--n:${journey.length}`}>
          {journey.map((s) => (
            <li>
              <span class="sx-tl-dot">{s.dot}</span>
              <div class="sx-tl-k">{s.k}</div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. PLANS -->
    <section class="sx-section sx-alt" id="plans">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">Plans</div>
          <h2 class="sx-h2 sx-reveal">Start with a website. Grow into a full online presence.</h2>
          <p class="sx-lead sx-reveal">Pick the plan that matches where your business is today. Each one includes a properly built website that you own.</p>
        </div>

        <div class="sx-reveal" style="border:1px solid var(--line);background:var(--card);border-radius:16px;padding:18px 22px;margin-bottom:34px">
          <div class="sx-card-k" style="margin:0 0 10px">In every plan</div>
          <div style="display:flex;flex-wrap:wrap;gap:8px 26px;font-size:15px;color:var(--ink)">
            <span>✓ Domain and hosting guidance</span>
            <span>✓ Responsive WordPress website</span>
            <span>✓ Basic security setup</span>
            <span>✓ Pre-launch testing</span>
            <span>✓ Full handover: you own the site</span>
            <span>✓ Basic training</span>
          </div>
        </div>

        <div class="sx-paths">

          <!-- No Frills -->
          <article class="sx-path sx-glow sx-reveal">
            <div class="sx-card-k">Get Started</div>
            <h3>I need a website.</h3>
            <p>A one-time project to get your business online, with the essentials set up properly.</p>
            <div class="sx-price">₹30,000</div>
            <ul>
              <li><span class="sx-tick">✓</span>Standard design with your logo and colours</li>
              <li><span class="sx-tick">✓</span>Content written for up to 3 pages</li>
              <li><span class="sx-tick">✓</span>Basic keyword research and on-page SEO</li>
              <li><span class="sx-tick">✓</span>Google Analytics, Search Console and Business Profile set up</li>
              <li><span class="sx-tick">✓</span>Facebook, Instagram, X and LinkedIn profiles set up</li>
              <li><span class="sx-tick">✓</span>1 SEO blog article</li>
              <li><span class="sx-tick">✓</span>A report showing which pages were submitted to Google</li>
            </ul>
            <div class="sx-card-k" style="margin:0 0 8px">After launch</div>
            <p style="margin:0 0 22px;font-size:15px">No ongoing services. Maintenance can be added any time. [confirm]</p>
            <a class="sx-btn sx-btn-dark" href={contactLink}>Start with No Frills <i>↗</i></a>
          </article>

          <!-- Growth -->
          <article class="sx-path sx-glow sx-reveal is-feat" style="--d:.1s">
            <span class="sx-badge">Recommended</span>
            <div class="sx-card-k">Growth</div>
            <h3>I need a website that attracts customers.</h3>
            <p>Built on research, with content and SEO behind it, then three months of us working on it with you.</p>
            <div class="sx-price">₹50,000</div>
            <ul>
              <li><span class="sx-tick">✓</span><b>Everything in No Frills, plus:</b></li>
              <li><span class="sx-tick">✓</span>Design tailored to your business, with a second mockup using your real content</li>
              <li><span class="sx-tick">✓</span>In-depth keyword and competitor research</li>
              <li><span class="sx-tick">✓</span>Comprehensive SEO, built into every page</li>
              <li><span class="sx-tick">✓</span>Content written for up to 4 pages</li>
            </ul>
            <div class="sx-card-k" style="margin:0 0 10px">For 3 months after launch</div>
            <ul style="border-top:0;padding-top:0;margin-bottom:28px">
              <li><span class="sx-tick">✓</span>5 blog articles in total</li>
              <li><span class="sx-tick">✓</span>6 social posts a month on 3 platforms</li>
              <li><span class="sx-tick">✓</span>Monthly website maintenance and SEO tune-up</li>
              <li><span class="sx-tick">✓</span>A monthly report</li>
            </ul>
            <a class="sx-btn sx-btn-primary" href={contactLink}>Choose Growth <i>↗</i></a>
          </article>

          <!-- Growth Plus -->
          <article class="sx-path sx-glow sx-reveal" style="--d:.2s">
            <div class="sx-card-k">Growth Plus</div>
            <h3>I need someone to build and manage my online presence.</h3>
            <p>Everything in Growth, a design built around your brand, and six months of us running it with you.</p>
            <div class="sx-price">₹65,000</div>
            <ul>
              <li><span class="sx-tick">✓</span><b>Everything in Growth, plus:</b></li>
              <li><span class="sx-tick">✓</span>Custom design built around your brand</li>
              <li><span class="sx-tick">✓</span>Content written for up to 5 pages</li>
            </ul>
            <div class="sx-card-k" style="margin:0 0 10px">For 6 months after launch</div>
            <ul style="border-top:0;padding-top:0;margin-bottom:28px">
              <li><span class="sx-tick">✓</span>7 blog articles in total</li>
              <li><span class="sx-tick">✓</span>10 social posts a month across 5 platforms</li>
              <li><span class="sx-tick">✓</span>Monthly website maintenance and SEO tune-up</li>
              <li><span class="sx-tick">✓</span>A monthly report</li>
            </ul>
            <a class="sx-btn sx-btn-dark" href={contactLink}>Talk to us <i>↗</i></a>
          </article>
        </div>

        <div class="sx-reveal" style="display:flex;flex-wrap:wrap;gap:18px 40px;justify-content:space-between;align-items:center;margin-top:40px">
          <p style="margin:0;max-width:64ch;font-size:16px;line-height:1.6">
            <b style="color:var(--ink)">When the included period ends,</b> you keep the website. If you'd like us to carry on, we'll agree a plan with you. There is no automatic renewal. 
          </p>
          <div style="display:flex;flex-wrap:wrap;gap:12px">
            <a class="sx-btn sx-btn-ghost" href="#compare" style="color:var(--ink);border-color:var(--ink)">Compare every detail <i>→</i></a>
            <a class="sx-btn sx-btn-ghost" href={contactLink} style="color:var(--ink);border-color:var(--ink)">Need something different? <i>↗</i></a>
          </div>
        </div>
      </div>
    </section>

    <!-- 8. PLAN COMPARISON -->
    <section class="sx-section" id="compare">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">Compare</div>
          <h2 class="sx-h2 sx-reveal">Everything in each plan.</h2>
        </div>
        <div style="overflow-x:auto" class="sx-reveal">
          <table style="width:100%;min-width:640px;border-collapse:collapse;font-size:15px;color:var(--ink)">
            <thead>
              <tr style="text-align:left">
                <th style="padding:14px 12px;border-bottom:2px solid var(--ink)"></th>
                <th style="padding:14px 12px;border-bottom:2px solid var(--ink)">No Frills<br><span style="font-weight:400;color:var(--muted)">₹30,000</span></th>
                <th style="padding:14px 12px;border-bottom:2px solid var(--ink);background:var(--alt)">Growth<br><span style="font-weight:400;color:var(--muted)">₹50,000</span></th>
                <th style="padding:14px 12px;border-bottom:2px solid var(--ink)">Growth Plus<br><span style="font-weight:400;color:var(--muted)">₹65,000</span></th>
              </tr>
            </thead>
            <tbody>
              <tr><th colspan="4" style="text-align:left;padding:22px 12px 8px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--red)">Your website</th></tr>
              <tr><td style="padding:12px;border-bottom:1px solid var(--line)">Design</td><td style="padding:12px;border-bottom:1px solid var(--line)">Standard</td><td style="padding:12px;border-bottom:1px solid var(--line);background:var(--alt)">Tailored</td><td style="padding:12px;border-bottom:1px solid var(--line)">Custom</td></tr>
              <tr><td style="padding:12px;border-bottom:1px solid var(--line)">Second mockup with your real content</td><td style="padding:12px;border-bottom:1px solid var(--line)">–</td><td style="padding:12px;border-bottom:1px solid var(--line);background:var(--alt)">✓</td><td style="padding:12px;border-bottom:1px solid var(--line)">✓</td></tr>
              <tr><td style="padding:12px;border-bottom:1px solid var(--line)">Pages with content written for you</td><td style="padding:12px;border-bottom:1px solid var(--line)">3</td><td style="padding:12px;border-bottom:1px solid var(--line);background:var(--alt)">4</td><td style="padding:12px;border-bottom:1px solid var(--line)">5</td></tr>
