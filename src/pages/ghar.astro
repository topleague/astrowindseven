---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Top League Technologies | Build Your Online Presence, Not Just a Website',
  description:
    'Websites, content, SEO and social, planned around your business, your goals and your budget. Digital partner for small businesses in India and around the world.',
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher (unchanged from the original page).
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];

const contactLink = 'mailto:hello@topleaguetech.com';

const stats = [
  { n: 16, l: 'years in digital' },
  { n: 30, s: '+', l: 'websites built recently' },
  { n: 20, l: 'websites currently maintained' },
  { n: 10, l: 'countries, clients served' },
];

const usualWay = [
  { title: 'Start with the website', description: 'The first question is “What kind of website do you want?”. A list of pages and features becomes the plan, and the business comes second.' },
  { title: 'Treat requirements as the strategy', description: 'A quote follows the feature list. The real budget surfaces later, usually as a compromise.' },
  { title: 'Choose what is familiar', description: 'Domain, hosting and platform are picked by habit, convenience or the lowest price.' },
  { title: 'Build first, think about SEO later', description: 'Pages are designed and written first. Search intent and site structure are considered afterwards.' },
  { title: 'Fill the pages at the end', description: 'Copy and images arrive late and get squeezed into whatever space the design left.' },
  { title: 'Launch and move on', description: 'Speed, security, social presence and fresh content become somebody else’s problem.' },
];
const topLeagueWay = [
  { title: 'Start with the business', description: 'We begin with your audience, your goals and what success means to you. Only then do we decide which pages and features earn a place.' },
  { title: 'Plan around the real budget', description: 'Budget is part of the first conversation, so the plan is practical rather than padded.' },
  { title: 'Choose foundations deliberately', description: 'Domain, hosting and CMS, platform or framework follow your requirements, not whatever we happen to use.' },
  { title: 'Map SEO before building pages', description: 'Search intent, keywords, structure and the pages you need to compete are decided before the build begins.' },
  { title: 'Create content around the plan', description: 'Content and visuals are prepared with your audience and search goals in mind, before the pages are assembled.' },
  { title: 'Plan for life after launch', description: 'We build for speed and security from the start, keep social aligned with the site, and stay on for updates, analytics and new content.' },
];
const tabNames = ['Starting point', 'Budget', 'Foundations', 'SEO', 'Content', 'After launch'];

const why = [
  { icon: 'tabler:world', t: 'Domain Name', d: 'A domain, hosting and technology choices can affect your brand and your future long after the website launches.' },
  { icon: 'tabler:share', t: 'Social Presence', d: 'Your website should work with your content, search and social presence — not sit apart from them.' },
  { icon: 'tabler:chart-line', t: 'SEO Rankings', d: 'Publishing, SEO, campaigns, analytics and maintenance are what keep an online presence useful after launch day.' },
];

const mistake = [
  { t: 'Domain + logo', d: 'Chosen before the website was planned.' },
  { t: 'Trademark conflict', d: 'Discovered after the website was ready.' },
  { t: 'Domain + logo abandoned', d: 'A change of name, domain and logo.' },
];

const steps = [
  { dot: '1', k: 'STEP 1', t: 'Websites', d: 'Fast, thoughtful WordPress builds that are made to perform — not simply launch.' },
  { dot: '2', k: 'STEP 2', t: 'Content', d: 'Clear, useful content shaped around your customers, your voice and your search goals.' },
  { dot: '3', k: 'STEP 3', t: 'SEO + Social', d: 'Search visibility and campaigns that keep your business in front of the people looking for it.' },
  { dot: '4', k: 'STEP 4', t: 'Care + Data', d: 'Maintenance, analytics, reporting and the everyday details that make digital feel effortless.' },
];

const quotes = [
  { t: 'Very Professional!', q: 'Top League is the only company I use for my article writing needs. They are very professional and work with you throughout the project with constant updates. I recommend their services to anyone considering outsourcing their content writing.', name: 'Daniel', job: 'Founder / Future Success' },
  { t: 'Readily Available!', q: 'Top League did a great job writing content for our website. They followed our direction very closely and were readily available for every stage of the project. I would highly recommend their writing skills and will be utilizing their services again. Great Job!', name: 'Jason Hamblin', job: 'Sr. Executive / L2T Media' },
  { t: 'Always the Best!', q: 'Top League have been excellent at presenting their work and work very hard to ensure that the quality of their work is always the best! Thank you Top League! I look forward to continuing our business together.', name: 'Michael', job: 'Founder / Idea Bubble' },
];
const initials = (name) => name.trim().split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();

// Orbit: five layers around the website
const orbit = ['Domain', 'Content', 'SEO', 'Social', 'Care'].map((label, i) => {
  const a = (-90 + i * 72) * Math.PI / 180;
  return { label, i, x: Math.round(270 + 165 * Math.cos(a)), y: Math.round(230 + 165 * Math.sin(a)) };
});

const marquee = ['Business', 'Website', 'Content', 'SEO', 'Social', 'Care'].join(' ✦ ') + ' ✦ ';
---

<Layout metadata={metadata} pageClass="home-draft">
  <StructuredData slot="head" schema={structuredData} />

  <script is:inline>
    document.documentElement.classList.add('sx-js');
    setTimeout(function () {
      if (!document.querySelector('.sx-page[data-sx-ready]')) document.documentElement.classList.remove('sx-js');
    }, 4000);
  </script>

  <div class="sx-page">
    <div class="sx-progress" aria-hidden="true"><span></span></div>

    <!-- 1. HERO -->
    <section class="sx-hero">
      <div class="sx-wrap sx-hero-grid">
        <div class="sx-hero-copy">
          <div class="sx-pill"><span class="sx-dot"></span> Digital partner for small businesses</div>
          <h1>
            Build Your Online Presence,
            <span>Not Just a Website.</span>
          </h1>
          <p>
            We start with the business, the goal and the budget, then work out the digital plan from there.
          </p>
          <div class="sx-actions">
            <a class="sx-btn sx-btn-primary" href="#contact">Free consultation <i>↗</i></a>
            <a class="sx-btn sx-btn-ghost" href="#difference">See what we do differently <i>↓</i></a>
          </div>
          <div class="sx-note">Websites · Content · SEO + Social · Care + Data</div>
        </div>

        <div class="sx-stage" role="img" aria-label="Illustration: a website at the centre, connected to the domain, content, SEO, social presence and ongoing care around it.">
          <svg viewBox="0 0 540 460" aria-hidden="true">
            <circle class="sx-rip" cx="270" cy="230" r="215" style="--d:0s" />
            <circle class="sx-rip" cx="270" cy="230" r="215" style="--d:2s" />
            <circle class="sx-rip" cx="270" cy="230" r="215" style="--d:4s" />
            <circle class="sx-ring2" cx="270" cy="230" r="165" />
            {orbit.map((o) => <line class="sx-spoke" x1="270" y1="230" x2={o.x} y2={o.y} />)}
            {orbit.map((o) => (
              <g class="sx-sat" style={`--i:${o.i}`}>
                <circle cx={o.x} cy={o.y} r="40" />
                <text x={o.x} y={o.y + 5}>{o.label}</text>
              </g>
            ))}
            <g class="sx-core">
              <circle class="sx-halo" cx="270" cy="230" r="62" />
              <circle cx="270" cy="230" r="44" />
            </g>
            <text class="sx-svgt" x="270" y="235">Website</text>
          </svg>
          <span class="sx-pin" style="left:0;top:6%"><b>1</b> Domain &amp; brand</span>
          <span class="sx-pin" style="right:0;top:48%"><b>2</b> Content &amp; search</span>
          <span class="sx-pin" style="left:4%;bottom:4%"><b>3</b> Care after launch</span>
        </div>
      </div>
    </section>

    <!-- 2. NUMBERS -->
    <section class="sx-proof">
      <div class="sx-wrap sx-proof-grid">
        <div class="sx-proof-lead sx-reveal">Websites, content,<br />SEO and care.</div>
        <div class="sx-stats">
          {stats.map((s, i) => (
            <div class="sx-stat sx-reveal" style={`--d:${i * 0.08}s`}>
              <div class="sx-num"><span data-sx-count={s.n}>{s.n}</span>{s.s}</div>
              <div class="sx-stat-l">{s.l}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. WHY IT MATTERS -->
    <section class="sx-section" id="coming">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">Why it matters</div>
          <h2 class="sx-h2 sx-reveal">Your website matters only when everything else is done right.</h2>
          <p class="sx-lead sx-reveal">Your domain, brand, content, search visibility and social presence all shape what happens after the website goes live.</p>
        </div>
        <div class="sx-bento">
          {why.map((w, i) => (
            <article class="sx-card sx-glow sx-reveal sx-b4" style={`--d:${i * 0.08}s`}>
              <span class="sx-ico" style="margin:6px 0 18px"><Icon name={w.icon} class="h-5 w-5" /></span>
              <h3>{w.t}</h3>
              <p>{w.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. REAL CLIENT STORY -->
    <section class="sx-section sx-night" id="reality">
      <div class="sx-wrap sx-story-grid">
        <div class="sx-sticky">
          <div class="sx-kicker sx-reveal">Based on a real client story</div>
          <h2 class="sx-h2 sx-reveal" style="max-width:none">What an expensive mistake looks like!</h2>
          <blockquote class="sx-bigq sx-reveal">A trademark conflict forced a change of name, domain and logo. Bummer.</blockquote>
          <div class="sx-copy">
            <p class="sx-reveal">A client came to us with a domain and logo already chosen. After the website was ready, a trademark conflict forced a change of name, domain and logo.</p>
          </div>
        </div>
        <ol class="sx-steps">
          {mistake.map((m, i) => (
            <li class="sx-reveal" style={`--d:${i * 0.1}s`}>
              <span>{i + 1}</span>
              <div>
                <div class="sx-p-t">{m.t}</div>
                <div class="sx-p-d">{m.d}</div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 5. THE DIFFERENCE (tabs) -->
    <section class="sx-section sx-alt" id="difference">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">The Top League difference</div>
          <h2 class="sx-h2 sx-reveal">A website is only as good as the thinking behind it.</h2>
          <p class="sx-lead sx-reveal">Here’s what we do differently before we build, while we build, and after we launch.</p>
        </div>

        <div data-sx-tabs>
          <div class="sx-tabs" role="tablist" aria-label="Where we do things differently">
            {tabNames.map((n, i) => (
              <button class="sx-tab" role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'}>{n}</button>
            ))}
          </div>
          {tabNames.map((n, i) => (
            <div class="sx-panel" role="tabpanel">
              <div class="sx-panel-t">{n}</div>
              <div class="sx-vs">
                <article class="sx-vs-card sx-vs-old">
                  <div class="sx-vs-k"><span class="sx-x">×</span> The usual way</div>
                  <h3>{usualWay[i].title}</h3>
                  <p>{usualWay[i].description}</p>
                </article>
                <div class="sx-vs-badge" aria-hidden="true">VS</div>
                <article class="sx-vs-card sx-vs-new">
                  <div class="sx-vs-k"><span class="sx-tick">✓</span> The Top League approach</div>
                  <h3>{topLeagueWay[i].title}</h3>
                  <p>{topLeagueWay[i].description}</p>
                </article>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. HOW WE BUILD -->
    <section class="sx-section" id="howdy">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">How we work</div>
          <h2 class="sx-h2 sx-reveal">How we build your brand presence.</h2>
        </div>
        <ol class="sx-tl sx-watch" style={`--n:${steps.length}`}>
          {steps.map((s) => (
            <li>
              <span class="sx-tl-dot">{s.dot}</span>
              <div class="sx-tl-k">{s.k}</div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. CLIENT WORDS -->
    <section class="sx-section sx-night" id="proof">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">Social proof</div>
          <h2 class="sx-h2 sx-reveal">Words from real customers</h2>
        </div>
        <div class="sx-quotes">
          {quotes.map((q, i) => (
            <article class="sx-quote sx-reveal" style={`--d:${i * 0.08}s`}>
              <div class="sx-stars" role="img" aria-label="5 out of 5 stars">★★★★★</div>
              <div class="sx-quote-t">{q.t}</div>
              <p>“{q.q}”</p>
              <div class="sx-person">
                <span class="sx-av" aria-hidden="true">{initials(q.name)}</span>
                <div class="sx-who">
                  <b>{q.name}</b>
                  <span>{q.job}</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 8. MARQUEE -->
    <div class="sx-marquee" aria-hidden="true">
      <div class="sx-marquee-track">
        <span>{marquee}</span>
        <span>{marquee}</span>
        <span>{marquee}</span>
        <span>{marquee}</span>
      </div>
    </div>

    <!-- 9. CTA -->
    <section class="sx-cta" id="contact">
      <div class="sx-wrap">
        <div class="sx-cta-card sx-reveal">
          <div>
            <div class="sx-kicker sx-kicker-lime">Let's talk</div>
            <h2>Contact us for a free consultation</h2>
            <p>No giant proposal. No unnecessary package. Start with the business, the goal and the budget. We'll work out the digital plan from there.</p>
          </div>
          <a class="sx-btn sx-btn-primary sx-btn-lg" href={contactLink}>Start a conversation <i>↗</i></a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style is:global>
.sx-page {
    --bg: #fff; --alt: #f1f4f2; --ink: #16202a; --muted: #566470; --line: #dfe5e8; --card: #fff;
    --red: #b34a43; --green: #1f5f55; --lime: #d9ff43; --night: #17242b; --night-2: #0f1a1f;
    color: var(--ink); background: var(--bg); overflow-x: clip; position: relative;
  }
.dark .sx-page {
    --bg: #1e293b; --alt: #172033; --ink: #f8fafc; --muted: #cbd5e1; --line: #334155; --card: #243247;
  }
.sx-page p { color: var(--muted); }
.sx-page .sx-wrap { max-width: 1180px; margin-inline: auto; padding-inline: 20px; }
.sx-page .sx-section { padding: clamp(72px, 9vw, 120px) 0; background: var(--bg); position: relative; }
.sx-page .sx-alt { background: var(--alt); border-block: 1px solid var(--line); }
.sx-page .sx-progress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 70; pointer-events: none; }
.sx-page .sx-progress span { display: block; height: 100%; background: var(--lime); transform: scaleX(0); transform-origin: 0 50%; }
.sx-js .sx-page .sx-reveal:not(.is-in) { opacity: 0; transform: translateY(22px); }
.sx-page .sx-reveal { transition: opacity .7s ease, transform .7s cubic-bezier(.2, .8, .2, 1); transition-delay: var(--d, 0s); }
.sx-page .sx-kicker { font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--red); margin-bottom: 18px; }
.sx-page .sx-kicker-lime { color: var(--lime); }
.sx-page .sx-h2 { font-size: clamp(34px, 4.6vw, 60px); line-height: 1.04; margin: 0 0 20px; color: var(--ink); max-width: 16ch; }
.sx-page .sx-head .sx-h2 { max-width: 20ch; }
.sx-page .sx-lead { font-size: clamp(17px, 1.6vw, 20px); line-height: 1.55; max-width: 46ch; margin: 0; }
.sx-page .sx-head { margin-bottom: 56px; max-width: 760px; }
.sx-page .sx-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 15px 24px; border-radius: 999px;
    font-weight: 700; font-size: 15px; text-decoration: none; transition: transform .25s ease, background .25s ease, box-shadow .25s ease;
    border: 1px solid transparent; line-height: 1.2; cursor: pointer;
  }
.sx-page .sx-btn i { font-style: normal; display: inline-block; transition: transform .25s ease; }
.sx-page .sx-btn:hover i { transform: translate(3px, -3px); }
.sx-page .sx-btn:hover { transform: translateY(-2px); }
.sx-page .sx-btn-primary { background: var(--lime); color: #17242b; box-shadow: 0 10px 30px -10px rgba(217, 255, 67, .55); }
.sx-page .sx-btn-primary:hover { box-shadow: 0 16px 36px -10px rgba(217, 255, 67, .75); }
.sx-page .sx-btn-ghost { color: #fff; border-color: rgba(255, 255, 255, .35); }
.sx-page .sx-btn-ghost:hover { background: rgba(255, 255, 255, .08); }
.sx-page .sx-btn-lg { padding: 18px 30px; font-size: 16px; white-space: nowrap; }
.sx-page .sx-hero {
    position: relative; overflow: hidden; color: #fff; padding: 150px 0 90px;
    background:
      radial-gradient(900px 520px at 88% 8%, rgba(217, 255, 67, .13), transparent 60%),
      radial-gradient(700px 520px at 0% 100%, rgba(179, 74, 67, .25), transparent 60%),
      linear-gradient(120deg, #0f1a1f, #17242b 55%, #1f3038);
  }
.sx-page .sx-hero::before {
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background-image: linear-gradient(rgba(255, 255, 255, .06) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .06) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse at 60% 40%, #000 10%, transparent 70%);
    mask-image: radial-gradient(ellipse at 60% 40%, #000 10%, transparent 70%);
  }
.sx-page .sx-hero-grid { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; gap: 40px; align-items: center; }
.sx-page .sx-pill {
    display: inline-flex; align-items: center; gap: 10px; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; font-weight: 700;
    padding: 8px 14px; border-radius: 999px; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .16); margin-bottom: 28px;
  }
.sx-page .sx-dot { width: 8px; height: 8px; border-radius: 50%; background: #b9db1c; box-shadow: 0 0 0 0 rgba(185, 219, 28, .7); animation: sx-ping 2s infinite; }
.sx-page .sx-hero h1 {
    font-size: clamp(46px, 6.4vw, 92px); line-height: 1; letter-spacing: -.045em; margin: 0 0 26px; color: #fff; max-width: 11ch;
  }
.sx-page .sx-hero h1 span {
    display: block; color: var(--lime);
    background: linear-gradient(transparent 82%, rgba(217, 255, 67, .22) 82%); width: fit-content;
  }
.sx-page .sx-hero p { font-size: clamp(18px, 1.7vw, 21px); line-height: 1.55; color: rgba(255, 255, 255, .8); max-width: 34em; margin: 0 0 34px; }
.sx-page .sx-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.sx-page .sx-note { margin-top: 26px; font-size: 13px; color: rgba(255, 255, 255, .6); }
.sx-page .sx-proof { background: #0f1a1f; color: #fff; padding: 64px 0; border-top: 1px solid rgba(255, 255, 255, .08); }
.sx-page .sx-proof-grid { display: grid; grid-template-columns: 1fr 1.7fr; gap: 48px; align-items: center; }
.sx-page .sx-proof-lead { font-size: clamp(24px, 2.8vw, 36px); line-height: 1.15; letter-spacing: -.03em; font-weight: 700; font-family: 'Mona Bold', 'Mona Reg', sans-serif; }
.sx-page .sx-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.sx-page .sx-stat { border-left: 1px solid rgba(255, 255, 255, .16); padding-left: 18px; }
.sx-page .sx-num { font-family: 'Mona Bold Pro Max', 'Mona Bold', sans-serif; font-size: clamp(38px, 4.4vw, 58px); line-height: 1; color: var(--lime); letter-spacing: -.04em; }
.sx-page .sx-stat-l { margin-top: 10px; font-size: 13px; line-height: 1.4; color: rgba(255, 255, 255, .65); }
.sx-page .sx-ico { flex: 0 0 auto; width: 42px; height: 42px; display: grid; place-items: center; border-radius: 12px; background: rgba(179, 74, 67, .12); color: var(--red); font-size: 20px; font-weight: 700; }
.sx-page .sx-p-t { font-weight: 700; font-size: 17px; color: var(--ink); margin-bottom: 4px; }
.sx-page .sx-p-d { font-size: 15px; line-height: 1.5; color: var(--muted); }
.sx-page .sx-vs { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
.sx-page .sx-vs-card { border-radius: 26px; padding: clamp(26px, 3.4vw, 44px); border: 1px solid var(--line); }
.sx-page .sx-vs-card h3 { font-size: clamp(26px, 2.8vw, 36px); line-height: 1.1; margin: 10px 0 24px; }
.sx-page .sx-vs-card ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; }
.sx-page .sx-vs-card li { display: flex; gap: 12px; align-items: flex-start; font-size: 17px; line-height: 1.45; padding: 12px 0; border-top: 1px solid currentColor; border-color: rgba(128, 128, 128, .22); }
.sx-page .sx-vs-k { font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; display: flex; align-items: center; gap: 10px; }
.sx-page .sx-vs-old { background: transparent; color: var(--muted); border-style: dashed; }
.sx-page .sx-vs-old h3 { color: var(--muted); }
.sx-page .sx-vs-old li { text-decoration: line-through; text-decoration-color: rgba(179, 74, 67, .65); text-decoration-thickness: 2px; }
.sx-page .sx-vs-old .sx-vs-k { color: var(--red); }
.sx-page .sx-x { display: inline-grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--red); color: #fff; font-size: 15px; line-height: 1; }
