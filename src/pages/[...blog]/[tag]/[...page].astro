
---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogTagRobots, getStaticPathsBlogTag } from '~/utils/blog';

import SxBlogShell from '~/components/sx/SxBlogShell.astro';
import SxBlogHero from '~/components/sx/SxBlogHero.astro';
import BlogList from '~/components/blog/List.astro';
import Pagination from '~/components/blog/Pagination.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogTag({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page, tag } = Astro.props as Props;

const currentPage = page.currentPage ?? 1;

const breadcrumbs = [
  { text: 'Home', href: getPermalink('/') },
  { text: 'Blog', href: getBlogPermalink() },
  { text: 'Tags', href: getPermalink('/tags') },
  ...(currentPage > 1
    ? [
        {
          text: tag.title,
          href: getPermalink(tag.slug, 'tag'),
        },
        { text: `Page ${currentPage}` },
      ]
    : [{ text: tag.title }]),
];

const metadata = {
  title: `Posts by tag '${tag.title}'${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  description: `Articles tagged ${tag.title} on the Top League blog.`,
  robots: {
    index: blogTagRobots?.index,
    follow: blogTagRobots?.follow,
  },
};
---

<SxBlogShell metadata={metadata}>
  <SxBlogHero
    pill="Tag"
    title={tag.title}
    crumbs={breadcrumbs}
  />

  <section class="sx-section">
    <div class="sx-wrap">
      <BlogList posts={page.data} />
      <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    </div>
  </section>
</SxBlogShell>
