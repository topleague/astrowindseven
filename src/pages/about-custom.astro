highlight: true,
items: [
{ description: '10 Articles' },
{ description: '2,000 Words Each' },
{ description: 'ETA: 20 Business Days' },
],
callToAction: {
text: 'Order Now',
href: 'https://www.paypal.com/cgi-bin/webscr?cmd=_s-xclick&hosted_button_id=T5YZVB5HYRA62',
},
hasRibbon: true,
ribbonTitle: 'Popular',
},
{
title: 'Premium',
subtitle: '20 SEO articles',
price: { monthly: 1280, yearly: 1280 },
period: { monthly: '20 articles', yearly: '20 articles' },
items: [
{ description: '20 Articles' },
{ description: '2,000 Words Each' },
{ description: 'ETA: 40 Business Days' },
],
callToAction: {
text: 'Order Now',
href: 'https://www.paypal.com/cgi-bin/webscr?cmd=_s-xclick&hosted_button_id=P33VWYGB2VFKG',
},
