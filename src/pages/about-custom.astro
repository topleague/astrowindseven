---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'SEO Article Writing Services | Top League Tech',
  description:
    'Professionally crafted SEO articles that are researched, original, keyword-focused and written to connect with your audience.',
};

const features = [
  {
    number: '01',
    title: 'Highly Focused',
    description:
      'We tailor every article to its intended audience, brand voice and search intent so the content feels relevant rather than generic.',
  },
  {
    number: '02',
    title: '100% Original',
    description:
      'Every article is written from scratch and checked for originality before delivery.',
  },
  {
    number: '03',
    title: 'Proofread to Perfection',
    description:
      'We review every article for grammar, readability, structure and consistency before it reaches you.',
  },
  {
    number: '04',
    title: 'Compelling Discounts',
    description:
      'Larger article packages come with substantial savings compared with our standard pricing.',
  },
  {
    number: '05',
    title: 'Free Trial Option',
    description:
      'Not sure if we are the right fit? We can provide sample content designed around your requirements.',
  },
  {
    number: '06',
    title: 'Customer Satisfaction',
    description:
      'Your feedback matters. We accommodate revisions and rework articles when they do not meet your expectations.',
  },
];

const process = [
  {
    number: '01',
    title: 'Understand',
    description:
      'We learn about your business, audience, goals and the type of content you need.',
  },
  {
    number: '02',
    title: 'Research',
    description:
      'We research the topic, search intent, competing content and relevant information before writing.',
  },
  {
    number: '03',
    title: 'Write',
    description:
      'Our writers turn the research into useful, engaging and search-friendly content.',
  },
  {
    number: '04',
    title: 'Refine',
    description:
      'The article is reviewed and proofread before it is delivered to you.',
  },
];

const testimonials = [
  {
    quote:
      'A long-term client praised the quality of our SEO articles and said our work produced strong results for their online marketing campaign.',
    name: 'Roberto',
    role: 'Founder, Polo Mercantile',
  },
  {
    quote:
      'A client described our team as professional, communicative and dependable throughout the content-writing project.',
    name: 'Daniel',
    role: 'Founder, Future Success',
  },
  {
    quote:
      'A client highlighted our attention to quality and the effort we put into presenting and improving our work.',
    name: 'Michael',
    role: 'Founder, Idea Bubble',
  },
  {
    quote:
      'A website client appreciated that we followed their direction closely and remained available throughout the project.',
    name: 'Jason Hamblin',
    role: 'Sr. Executive, L2T Media',
  },
  {
    quote:
      'A client noted that our articles were well written, concise and well optimized for search.',
    name: 'Sean',
    role: 'Founder, Acquisition Engine',
  },
  {
    quote:
      'A client praised the professionalism of our research and content for a specialist appliance-repair website.',
    name: 'Alex Garayev',
    role: 'Founder, SD Appliances',
  },
];

const pricing = [
  {
    title: 'Basic',
    subtitle: '5 SEO articles',
    price: '$320',
    articles: '5 Articles',
    words: '2,000 Words Each',
    eta: 'ETA: 10 Business Days',
    href: 'https://www.paypal.com/cgi-bin/webscr?cmd=_s-xclick&hosted_button_id=PZXUG9DELUY7N',
    popular: false,
  },
  {
    title: 'Standard',
    subtitle: '10 SEO articles',
    price: '$640',
    articles: '10 Articles',
    words: '2,000 Words Each',
    eta: 'ETA: 20 Business Days',
    href: 'https://www.paypal.com/cgi-bin/webscr?cmd=_s-xclick&hosted_button_id=T5YZVB5HYRA62',
    popular: true,
  },
  {
    title: 'Premium',
    subtitle: '20 SEO articles',
    price: '$1,280',
    articles: '20 Articles',
    words: '2,000 Words Each',
    eta: 'ETA: 40 Business Days',
    href: 'https://www.paypal.com/cgi-bin/webscr?cmd=_s-xclick&hosted_button_id=P33VWYGB2VFKG',
    popular: false,
  },
];
---

<Layout metadata={metadata}>

  <!-- HERO -->
  <section class="relative overflow-hidden px-6 pb-20 pt-16 sm:px-8 sm:pt-24 lg:px-8 lg:pb-28 lg:pt-28">
    <div class="mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-[1.1fr_0.9fr]">

      <div>
        <div class="mb-6 inline-flex items-center rounded-full border border-sky-200 bg-sky-50 px-4 py-2 text-sm font-semibold text-sky-700 dark:border-sky-800 dark:bg-sky-950 dark:text-sky-300">
          SEO Article Writing
        </div>

        <h1 class="max-w-4xl text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl lg:text-6xl">
          SEO articles that
          <span class="text-sky-600 dark:text-sky-400">people want to read.</span>
        </h1>

        <p class="mt-7 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-300 sm:text-xl">
          Professionally crafted SEO articles that are researched, original,
          useful and written to connect with your potential customers.
        </p>

        <div class="mt-9 flex flex-wrap gap-4">
          <a
            href="#pricing"
            class="inline-flex items-center rounded-lg bg-sky-600 px-6 py-3.5 text-base font-semibold text-white shadow-sm transition hover:bg-sky-700"
          >
            View Packages
          </a>

          <a
            href="#why-us"
            class="inline-flex items-center rounded-lg border border-gray-300 px-6 py-3.5 text-base font-semibold text-gray-800 transition hover:bg-gray-50 dark:border-gray-700 dark:text-gray-100 dark:hover:bg-gray-800"
          >
            Why Top League?
          </a>
        </div>

        <div class="mt-9 flex flex-wrap gap-x-7 gap-y-3 text-sm text-gray-600 dark:text-gray-400">
          <span>✓ Original content</span>
          <span>✓ Proofread</span>
          <span>✓ SEO focused</span>
          <span>✓ Revisions available</span>
        </div>
      </div>

      <div class="relative">
        <div class="rounded-3xl border border-gray-200 bg-gray-50 p-7 shadow-xl dark:border-gray-700 dark:bg-gray-800/70 sm:p-9">
          <div class="mb-7 flex items-center justify-between">
            <div>
              <p class="text-sm font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">
                Our approach
              </p>
              <h2 class="mt-2 text-2xl font-bold text-gray-900 dark:text-white">
                Content with a purpose.
              </h2>
            </div>

            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-sky-100 text-sky-600 dark:bg-sky-900 dark:text-sky-300">
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M5 19.5V5.8A1.8 1.8 0 0 1 6.8 4H19v13.7H6.8A1.8 1.8 0 0 0 5 19.5Zm0 0A1.8 1.8 0 0 0 6.8 21H19" />
                <path d="M8.5 8h7M8.5 11h7M8.5 14h4.5" />
              </svg>
            </div>
          </div>

          <div class="space-y-4">
            <div class="rounded-xl bg-white p-5 dark:bg-gray-900">
              <p class="text-sm font-semibold text-gray-900 dark:text-white">
                Research
              </p>
              <p class="mt-1 text-sm leading-6 text-gray-600 dark:text-gray-400">
                Understand the topic, audience and search intent.
              </p>
            </div>

            <div class="rounded-xl bg-white p-5 dark:bg-gray-900">
              <p class="text-sm font-semibold text-gray-900 dark:text-white">
                Write
              </p>
              <p class="mt-1 text-sm leading-6 text-gray-600 dark:text-gray-400">
                Turn research into useful, readable and engaging content.
              </p>
            </div>

            <div class="rounded-xl bg-white p-5 dark:bg-gray-900">
              <p class="text-sm font-semibold text-gray-900 dark:text-white">
                Refine
              </p>
              <p class="mt-1 text-sm leading-6 text-gray-600 dark:text-gray-400">
                Proofread, polish and prepare the article for delivery.
              </p>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>


  <!-- INTRODUCTION -->
  <section class="border-y border-gray-200 bg-gray-50 px-6 py-20 dark:border-gray-800 dark:bg-gray-900/50 sm:px-8 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <div class="grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">

        <div>
          <p class="text-sm font-bold uppercase tracking-widest text-sky-600 dark:text-sky-400">
            Why quality matters
          </p>

          <h2 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
            Article writing has changed.
          </h2>
        </div>

        <div class="space-y-6 text-lg leading-8 text-gray-600 dark:text-gray-300">
          <p>
            Any SEO professional worth their salt knows that article writing
            services aren't the same as they used to be.
          </p>

          <p>
            We started writing articles for businesses back in 2006. In the
            early days, it was possible to get away with publishing weak,
            generic content. That's no longer the case.
          </p>

          <p>
            Today, your content needs to be useful to readers while supporting
            your search strategy. That means choosing the right topics,
            researching them properly and writing with both people and search
            engines in mind.
          </p>

          <p>
            Since our inception, we have prioritized quality regardless of
            industry or budget. We obsess over the details, and that philosophy
            continues to shape the way we write every article.
          </p>
        </div>

      </div>
    </div>
  </section>


  <!-- WHY US -->
  <section id="why-us" class="px-6 py-20 sm:px-8 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-6xl">

      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-sky-600 dark:text-sky-400">
          What you get
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          Why choose our article writing services?
        </h2>

        <p class="mt-5 text-lg leading-8 text-gray-600 dark:text-gray-300">
          We combine research, writing experience and attention to detail to
          produce content that works for your audience and your SEO campaign.
        </p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {features.map((feature) => (
          <article class="group rounded-2xl border border-gray-200 bg-white p-7 transition duration-200 hover:-translate-y-1 hover:shadow-xl dark:border-gray-700 dark:bg-gray-800">
            <div class="flex items-start justify-between">
              <span class="text-sm font-bold text-sky-600 dark:text-sky-400">
                {feature.number}
              </span>

              <span class="h-2.5 w-2.5 rounded-full bg-sky-500 transition group-hover:scale-150"></span>
            </div>

            <h3 class="mt-8 text-xl font-bold text-gray-900 dark:text-white">
              {feature.title}
            </h3>

            <p class="mt-3 leading-7 text-gray-600 dark:text-gray-400">
              {feature.description}
            </p>
          </article>
        ))}
      </div>

    </div>
  </section>


  <!-- RESEARCH CALLOUT -->
  <section class="px-6 pb-20 sm:px-8 lg:px-8 lg:pb-24">
    <div class="mx-auto max-w-6xl">
      <div class="overflow-hidden rounded-3xl bg-sky-600 px-8 py-12 text-white sm:px-12 lg:flex lg:items-center lg:justify-between lg:px-16">
        <div class="max-w-3xl">
          <p class="text-sm font-bold uppercase tracking-widest text-sky-200">
            Built for SEO
          </p>

          <h2 class="mt-3 text-3xl font-bold sm:text-4xl">
            Highly researched. Naturally optimized. Written for humans.
          </h2>

          <p class="mt-5 max-w-2xl text-lg leading-8 text-sky-100">
            Good SEO content shouldn't read like it was written for a search
            engine. Our goal is to make the article useful first and optimized
            naturally around it.
          </p>
        </div>

        <a
          href="#pricing"
          class="mt-8 inline-flex shrink-0 items-center rounded-lg bg-white px-6 py-3.5 font-semibold text-sky-700 transition hover:bg-sky-50 lg:ml-10 lg:mt-0"
        >
          See Packages
        </a>
      </div>
    </div>
  </section>


  <!-- PROCESS -->
  <section class="border-y border-gray-200 bg-gray-50 px-6 py-20 dark:border-gray-800 dark:bg-gray-900/50 sm:px-8 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-6xl">

      <div class="max-w-2xl">
        <p class="text-sm font-bold uppercase tracking-widest text-sky-600 dark:text-sky-400">
          How it works
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          A straightforward writing process.
        </h2>

        <p class="mt-5 text-lg leading-8 text-gray-600 dark:text-gray-300">
          No complicated workflow. Just careful research, thoughtful writing
          and a final review before delivery.
        </p>
      </div>

      <div class="mt-14 grid gap-8 md:grid-cols-4">
        {process.map((step) => (
          <div class="relative">
            <div class="text-4xl font-bold text-sky-200 dark:text-sky-900">
              {step.number}
            </div>

            <h3 class="mt-3 text-xl font-bold text-gray-900 dark:text-white">
              {step.title}
            </h3>

            <p class="mt-3 leading-7 text-gray-600 dark:text-gray-400">
              {step.description}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>


  <!-- TESTIMONIALS -->
  <section class="px-6 py-20 sm:px-8 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-6xl">

      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-sky-600 dark:text-sky-400">
          Client feedback
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          What our clients say
        </h2>

        <p class="mt-5 text-lg leading-8 text-gray-600 dark:text-gray-300">
          We've worked with businesses across different industries and
          locations. Here's what some of our long-term clients have highlighted.
        </p>
      </div>

      <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {testimonials.map((testimonial) => (
          <blockquote class="flex h-full flex-col rounded-2xl border border-gray-200 bg-white p-7 shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <div class="text-3xl leading-none text-sky-500">“</div>

            <p class="mt-4 flex-1 leading-7 text-gray-600 dark:text-gray-300">
              {testimonial.quote}
            </p>

            <footer class="mt-7 border-t border-gray-100 pt-5 dark:border-gray-700">
              <p class="font-bold text-gray-900 dark:text-white">
                {testimonial.name}
              </p>

              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                {testimonial.role}
              </p>
            </footer>
          </blockquote>
        ))}
      </div>

    </div>
  </section>


  <!-- PRICING -->
  <section id="pricing" class="border-y border-gray-200 bg-gray-50 px-6 py-20 dark:border-gray-800 dark:bg-gray-900/50 sm:px-8 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-6xl">

      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-sky-600 dark:text-sky-400">
          Simple pricing
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          Our prices are unbeatable!
        </h2>

        <p class="mt-5 text-lg text-gray-600 dark:text-gray-300">
          We have a package for every budget.
        </p>
      </div>

      <div class="mt-14 grid gap-6 lg:grid-cols-3">
        {pricing.map((plan) => (
          <article
            class:list={[
              'relative flex flex-col rounded-2xl border bg-white p-8 shadow-sm dark:bg-gray-800',
              plan.popular
                ? 'border-sky-500 ring-2 ring-sky-500/20'
                : 'border-gray-200 dark:border-gray-700',
            ]}
          >
            {plan.popular && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-sky-600 px-4 py-1 text-xs font-bold uppercase tracking-wider text-white">
                Popular
              </div>
            )}

            <p class="text-sm font-semibold uppercase tracking-wider text-sky-600 dark:text-sky-400">
              {plan.title}
            </p>

            <h3 class="mt-2 text-2xl font-bold text-gray-900 dark:text-white">
              {plan.subtitle}
            </h3>

            <div class="mt-7">
              <span class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white">
                {plan.price}
              </span>
            </div>

            <ul class="mt-8 space-y-4 text-sm text-gray-600 dark:text-gray-300">
              <li class="flex gap-3">
                <span class="font-bold text-sky-600">✓</span>
                <span>{plan.articles}</span>
              </li>

              <li class="flex gap-3">
                <span class="font-bold text-sky-600">✓</span>
                <span>{plan.words}</span>
              </li>

              <li class="flex gap-3">
                <span class="font-bold text-sky-600">✓</span>
                <span>{plan.eta}</span>
              </li>
            </ul>

            <a
              href={plan.href}
              class:list={[
                'mt-9 inline-flex items-center justify-center rounded-lg px-5 py-3.5 text-center font-semibold transition',
                plan.popular
                  ? 'bg-sky-600 text-white hover:bg-sky-700'
                  : 'border border-gray-300 text-gray-800 hover:bg-gray-50 dark:border-gray-600 dark:text-white dark:hover:bg-gray-700',
              ]}
            >
              Order Now
            </a>
          </article>
        ))}
      </div>

    </div>
  </section>


  <!-- FINAL CTA -->
  <section class="px-6 py-20 sm:px-8 lg:px-8 lg:py-24">
    <div class="mx-auto max-w-4xl text-center">

      <p class="text-sm font-bold uppercase tracking-widest text-sky-600 dark:text-sky-400">
        Ready to get started?
      </p>

      <h2 class="mt-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl lg:text-5xl">
        Give your website content it deserves.
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-gray-600 dark:text-gray-300">
        Tell us what you need, and let's create SEO content that is useful to
        your audience and aligned with your goals.
      </p>

      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <a
          href="https://topleaguetech.com/contact/"
          class="inline-flex items-center rounded-lg bg-sky-600 px-7 py-3.5 font-semibold text-white transition hover:bg-sky-700"
        >
          Contact Us
        </a>

        <a
          href="#pricing"
          class="inline-flex items-center rounded-lg border border-gray-300 px-7 py-3.5 font-semibold text-gray-800 transition hover:bg-gray-50 dark:border-gray-700 dark:text-white dark:hover:bg-gray-800"
        >
          View Packages
        </a>
      </div>

    </div>
  </section>

</Layout>
