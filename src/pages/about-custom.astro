---
import Testimonials from '~/components/widgets/Testimonials.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Team from '~/components/widgets/Team.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About us',
  description:
    'About page demo built with AstroWind: hero, stats, feature grids and timelines ready to describe your company.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About us"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Caos Image',
    }}
  >
    <Fragment slot="title">
      Crafting Words that <br />
      <span class="text-accent dark:text-white"> Drive Results</span>
    </Fragment>

    <Fragment slot="subtitle">
      Customer-focused approach to deliver the best results possible.
    </Fragment>
  </Hero>

<!-- TLT About Hero Section  ******************* -->
<!-- Code Snippet Removed Can be Found Here (holybeaches.wordpress.com/2026/10/09/custom-hero-widget-about-astro/)  ******************* -->


  <!-- Content//About Us Widget ****************** -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: 'tabler:brand-dribbble',
        callToAction: {
          target: '_blank',
          text: 'Dribbble',
          href: '#',
        },
      },
      {
        icon: 'tabler:brand-behance',
        callToAction: {
          target: '_blank',
          text: 'Behance',
          href: '#',
        },
      },
      {
        icon: 'tabler:brand-pinterest',
        callToAction: {
          target: '_blank',
          text: 'Pinterest',
          href: '#',
        },
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1491349174775-aaafddd81942?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      alt: 'Colorful Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About Us</h2>
      <p>
        Every great story starts with a spark of inspiration—and for us, that spark was simple: a love for storytelling and a desire to help businesses find their voice online.
      </p>
      <br />
      <p>
        Back in 2010, when content was just beginning to rule the digital world, we set out to craft words that could make an impact. Armed with passion (and a whole lot of coffee), we started as a small, scrappy team in Bhubaneswar, India, driven by one goal: to create content that not only ranks but also resonates.
      </p>
      <br />
      <p>What started as a solo venture has since grown into a tight-knit, two-person team that works with clients from across the globe, helping businesses tell their unique stories and get the attention they deserve. Whether it’s an SEO-friendly blog post or a carefully crafted social media campaign, we take pride in every word we write, every idea we shape, and every client we help grow.</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Stats Widget ****************** -->
  <!-- (Delted) ****************** -->

  <!-- Features3 Widget ************** -->

  <!-- Features3 Widget ************** -->

  <!-- Team Widget ******************** -->

  <Team
    id="team"
    columns={2}
    tagline="The people"
    title="Meet the team"
    subtitle="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Morbi sagittis, quam nec venenatis lobortis, mi risus tempus nulla."
    members={[

      {
        name: 'Susanta',
        role: 'Founder / Chief Blogger',
        image: {
          src: 'https://topleaguetech.com/wp-content/uploads/2021/09/Untitled-drawing-2.png',
          alt: 'Susanta',
        },
        bio: 'He’s worked with small businesses, translating their ideas into content.',
        socials: [{ icon: 'tabler:brand-github', href: 'https://github.com/', ariaLabel: 'GitHub' }],
      },

      {
        name: 'Meera',
        role: 'Senior Content Writer',
        image: {
          src: 'https://topleaguetech.com/wp-content/uploads/2022/08/Untitled-design-1.png',
          alt: 'Meera',
        },
        bio: 'She creates well-researched, SEO-friendly articles that rank high.',
        socials: [{ icon: 'tabler:brand-dribbble', href: 'https://dribbble.com/', ariaLabel: 'Dribbble' }],
      },


    ]}
  />

