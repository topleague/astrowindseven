
---
/* PART 1: IMPORTS */
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Quote from '~/components/widgets/Quote.astro';

import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

import Projects from '~/components/widgets/Projects.astro';
import { findLatestPosts } from '~/utils/blog';
import { findImage } from '~/utils/images';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';


/* PART 2: FRONTMATTER */
const metadata = {
  title: 'Page Name',
  description: 'Random Page Description.',
};

const destination = 'https://github.com/arthelokyo/astrowind';

const posts = await findLatestPosts({ count: 3 });

const blogItems = await Promise.all(
  posts.map(async (post) => {
    const image = await findImage(post.image);

    return {
      title: post.title,
      image: image ? { src: image, alt: post.imageAlt || post.title } : undefined,
      tags: [
        post.publishDate.toLocaleDateString('en-IN', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        }),
        ...(post.category ? [post.category.title] : []),
      ],
      href: getPermalink(post.permalink, 'post'),
      linkText: 'Read More',
    };
  })
);

---

<!-- PART 3: TEMPLATE (PAGE BODY) -->
<Layout metadata={metadata}>

  <!-- Hero2 Widget ******************* -->


<!-- Custom SEO Article Writing Hero -->
<div class="seo-content-writing">
  <section
    class="article-hero"
    aria-labelledby="article-hero-title"
    style="background-image: linear-gradient(to right, #141618, #14161870), url('https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3…90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2040&h=1148&q=80')"
  >
    <div class="article-hero-content">
      <h1 id="article-hero-title">SEO Article Writing Services</h1>
      <p>
        Professionally crafted SEO articles that resonate with your
        potential customers.
      </p>
    </div>
  </section>

  <!-- Existing SVG Curve -->
  <div class="hero-separator dark:hidden" aria-hidden="true">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 1920 120"
      preserveAspectRatio="none"
      class="block w-full"
    >
      <path
        fill="#fff"
        fill-rule="evenodd"
        d="M0,0 C320,60 640,90 960,90 C1280,90 1600,60 1920,0 L1920,120 L0,120 L0,0 Z"
      />
    </svg>
  </div>
</div>


<!-- Features Widget ************************************************************************************************************************ -->


<!-- Content / Plain Text Widget -->

