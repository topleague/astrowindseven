
---
/* PART 1: IMPORTS */
import Layout from '~/layouts/PageLayout.astro';
import Features from '~/components/widgets/Features.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';


/* PART 2: FRONTMATTER */
const metadata = {
  title: 'Page Name',
  description: 'Random Page Description.',
};
---

<!-- PART 3: TEMPLATE (PAGE BODY) -->
<Layout metadata={metadata}>

<!-- Features Widget ************************************************************************************************************************ -->

  <Features
    id="features"
    title="Unleash the Full Power of SEO"
    subtitle="Get More Than Just Words—Experience the Power of Strategic SEO Content That Delivers Results."
    columns={2}
    items={[
      {
        title: 'Targeted Content',
        description:
          'We dive deep into your audience’s needs and your industry to craft content that resonates, drives engagement, and adds real value to your website.',
        icon: 'tabler:artboard',
      },
      {
        title: 'Specialist Proofreading',
        description: 'Our team of expert proofreaders ensures your content is flawless, polished, and ready to impress your audience.',
        icon: 'tabler:picture-in-picture',
      },
      {
        title: 'Risk-Free Sampling',
        description:
          'Try before you buy. We offer a complimentary sample to demonstrate our expertise and fit for your project.',
        icon: 'tabler:adjustments-horizontal',
      },
      {
        title: 'CopyScape Passed',
        description: 'Every piece of content we deliver is rigorously checked for originality with CopyScape, ensuring your site is both unique and authoritative.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Unlimited Revisions',
        description:
          'We’re committed to getting it right. Enjoy as many revisions as necessary to meet your exact specifications—free of charge.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Exclusive Bulk Discounts',
        description: 'The more you order, the more you save. Benefit from our tiered discount system designed for long-term partnerships.',
        icon: 'tabler:plug-connected',
      },
    ]}
  />


  <!-- Testimonials Widget ************************************************************************************************************************ -->
  <Testimonials
    title="Words from real customers"
    testimonials={[
      {
        title: 'Random Subtitle!',
        testimonial: `Random Words from Client..`,
        rating: 5,
        name: 'Random Name',
        job: 'Random Business name',
        image: {
          src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2040&h=1148&q=80',
          alt: 'Client testimonial image',
        },
      },
    ]}
    callToAction={{
      target: '_blank',
      text: 'Random CTA',
      href: 'https://example.com/',
      icon: 'tabler:chevron-right',
    }}
  />
</Layout>
