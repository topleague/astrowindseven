
---
/* PART 1: IMPORTS */
import Hero from '~/components/widgets/Hero.astro';
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';


/* PART 2: FRONTMATTER */
const metadata = {
  title: 'Page Name',
  description: 'Random Page Description.',
};

const destination = 'https://github.com/arthelokyo/astrowind';

---

<!-- PART 3: TEMPLATE (PAGE BODY) -->
<Layout metadata={metadata}>

  <!-- Hero2 Widget ******************* -->

  <Hero
    id="hero"
    title="Turn Boring Content into SEO Gold"
    tagline="The Power of Great Content"
    actions={[{ variant: 'primary', text: 'Hire me', href:'#' }]}
  >
    <Fragment slot="subtitle">
      Boost your rankings and captivate your audience with SEO-friendly content that converts.
    </Fragment>
  </Hero>

<!-- Hero Seperator ************************************************************************************************************************ -->
  <div class="hero-separator dark:hidden" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1920 120" preserveAspectRatio="none" class="block w-full">
      <path fill="var(--color-blue-50)" fill-rule="evenodd" d="M0,0 C320,60 640,90 960,90 C1280,90 1600,60 1920,0 L1920,120 L0,120 L0,0 Z" />
    </svg>
  </div>

<!-- Features Widget ************************************************************************************************************************ -->

  <Content
    id="preview"
    isReversed
    tagline="Our Services"
    title="Content that Resonates"
    subtitle="Get More Than Just Words—Experience the Power of Strategic SEO Content That Delivers Results."
    items={[
      {
        title: 'SEO Article Writing',
        description: "Turn your brand into an authority with our SEO-driven articles. Our expert writers craft compelling blog posts that don't just rank on Google—they build your reputation and engage your audience. Tailored for content marketing and guest blogging, these articles are designed to elevate your online presence.",
},
      {
        title: 'Product Description Writing',
        description:
          "Boost your eCommerce game with product descriptions that convert. We specialize in crafting keyword-optimized, customer-centric descriptions that enhance your product's appeal and drive sales. Let us help you turn browsers into buyers with content that speaks directly to your target audience.",
},
      {
        title: 'Website Content Writing',
        description: "Give your website the voice it deserves. Our team rewrites your content to ensure it’s not only SEO-friendly but also compelling and professional. We focus on creating content that resonates with both search engines and your customers, ensuring higher rankings and better conversion rates. Turn clicks into clients!",
},
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1531973486364-5fa64260d75b?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1674&q=80',
      alt: 'A developer working at a laptop',
    }}

  >

    <!-- REMOVE this piece of content ******************** -->
    <!-- 
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Content that Resonates</h3>
      No Fluff. Our Content Speaks Your Audience’s Language and Adheres to SEO Standards.
    </Fragment>
    -->

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

 
<!-- Features Widget ************************************************************************************************************************ -->

  <Features
    id="features"
    title="Unleash the Full Power of SEO"
    subtitle="Get More Than Just Words—Experience the Power of Strategic SEO Content That Delivers Results."
    columns={2}
    items={[
      {
        title: 'Targeted Content',
        description:
          'We dive deep into your audience’s needs and your industry to craft content that resonates, drives engagement, and adds real value to your website.',
        icon: 'tabler:artboard',
      },
      {
        title: 'Specialist Proofreading',
        description: 'Our team of expert proofreaders ensures your content is flawless, polished, and ready to impress your audience.',
        icon: 'tabler:picture-in-picture',
      },
      {
        title: 'Risk-Free Sampling',
        description:
          'Try before you buy. We offer a complimentary sample to demonstrate our expertise and fit for your project.',
        icon: 'tabler:adjustments-horizontal',
      },
      {
        title: 'CopyScape Passed',
        description: 'Every piece of content we deliver is rigorously checked for originality with CopyScape, ensuring your site is both unique and authoritative.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Unlimited Revisions',
        description:
          'We’re committed to getting it right. Enjoy as many revisions as necessary to meet your exact specifications—free of charge.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Exclusive Bulk Discounts',
        description: 'The more you order, the more you save. Benefit from our tiered discount system designed for long-term partnerships.',
        icon: 'tabler:plug-connected',
      },
    ]}
  />


  <!-- Testimonials Widget ************************************************************************************************************************ -->
  <Testimonials
    title="Words from real customers"
    testimonials={[
      {
        title: 'Random Subtitle!',
        testimonial: `Random Words from Client..`,
        rating: 5,
        name: 'Random Name',
        job: 'Random Business name',
        image: {
          src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2040&h=1148&q=80',
          alt: 'Client testimonial image',
        },
      },
    ]}
    callToAction={{
      target: '_blank',
      text: 'Random CTA',
      href: 'https://example.com/',
      icon: 'tabler:chevron-right',
    }}
  />
</Layout>
