---
import Layout from '~/layouts/PageLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'SEO Copywriting Services | Top League',
  description:
    'Website copy that connects with your audience, communicates your value and encourages action.',
};

const enquiryLink = 'mailto:hello@topleaguetech.com?subject=SEO%20Copywriting%20Enquiry';

const stats = [
  { n: '2006', l: 'industry experience since', count: false },
  { n: '2010', l: 'Top League established', count: false },
  { n: 300, l: 'words per page, up to' },
  { n: 4, l: 'kinds of page we write' },
];

const steps = [
  { dot: '1', k: 'STEP 01', t: 'Understand your business', d: 'We learn about your business, audience, offerings and objectives.' },
  { dot: '2', k: 'STEP 02', t: 'Find the right message', d: 'We identify your selling points, customer concerns and the messages your website needs to communicate.' },
  { dot: '3', k: 'STEP 03', t: 'Write persuasive copy', d: 'We develop clear, engaging content with meaningful headlines, natural keyword integration and purposeful calls to action.' },
  { dot: '4', k: 'STEP 04', t: 'Review and refine', d: 'We polish the copy, incorporate agreed feedback and deliver content ready for your website.' },
];

const whys = [
  { icon: 'tabler:clock', t: 'Industry experience since 2006', d: 'We’ve been working with business content since 2006. Top League Technologies was established in 2010.' },
  { icon: 'tabler:target', t: 'Persuasion with SEO awareness', d: 'We write for people first while keeping search intent and on-page SEO considerations in mind.' },
  { icon: 'tabler:message-circle', t: 'Your business, your voice', d: 'We understand your offerings and communicate them in a way that reflects your brand.' },
  { icon: 'tabler:users', t: 'A hands-on team', d: 'Work directly with an experienced, approachable team instead of being another order in a content production pipeline.' },
];

const plans = [
  {
    k: 'Basic', t: 'For a smaller website', price: '$299', li: ['5 website pages', 'Up to 300 words per page', '5 business days'],
    cta: 'Discuss this package', href: 'mailto:hello@topleaguetech.com?subject=Basic%20SEO%20Copywriting%20Package',
  },
  {
    k: 'Standard', t: 'For a growing website', price: '$449', li: ['10 website pages', 'Up to 300 words per page', '10 business days'],
    cta: 'Discuss this package', href: 'mailto:hello@topleaguetech.com?subject=Standard%20SEO%20Copywriting%20Package', feat: true, badge: 'Popular',
  },
  {
    k: 'Premium', t: 'For a larger website', price: '$599', li: ['20 website pages', 'Up to 300 words per page', '20 business days'],
    cta: 'Discuss this package', href: 'mailto:hello@topleaguetech.com?subject=Premium%20SEO%20Copywriting%20Package',
  },
];

const marquee = ['Message', 'Clarity', 'Persuasion', 'Search', 'Action'].join(' ✦ ') + ' ✦ ';
---

<Layout metadata={metadata} pageClass="product-description-page">

  <script is:inline>
    document.documentElement.classList.add('sx-js');
    // Safety net: if the page script ever fails to start, show everything.
    setTimeout(function () {
      if (!document.querySelector('.sx-page[data-sx-ready]')) document.documentElement.classList.remove('sx-js');
    }, 4000);
  </script>

  <div class="sx-page">
    <div class="sx-progress" aria-hidden="true"><span></span></div>

    <!-- 1. HERO -->
    <section class="sx-hero">
      <div class="sx-wrap sx-hero-grid">
        <div class="sx-hero-copy">
          <div class="sx-pill"><span class="sx-dot"></span> SEO copywriting</div>

          <h1>
            Website copy that
            <span>moves people.</span>
          </h1>

          <p>Website copy that connects with your audience, communicates your value and encourages action.</p>

          <div class="sx-actions">
            <a class="sx-btn sx-btn-primary" href="#packages">Explore packages <i>↗</i></a>
            <a class="sx-btn sx-btn-ghost" href="#process">See how we work <i>↓</i></a>
          </div>

          <div class="sx-note">Industry experience since 2006 · Top League established in 2010</div>
        </div>

        <div
          class="sx-stage"
          role="img"
          aria-label="Illustration: a website page with a meaningful headline, supporting copy and a clear call to action."
        >
          <div class="sx-win">
            <div class="sx-win-bar"><i></i><i></i><i></i><span>yourwebsite.com</span></div>
            <div class="sx-win-body">
              <div class="sx-row">
                <span class="sx-sk w20"></span>
                <span class="sx-sk w10" style="margin-left:auto;width:12%"></span>
                <span class="sx-sk" style="width:12%"></span>
                <span class="sx-sk" style="width:12%"></span>
              </div>
              <span class="sx-sk is-h w90 sx-hl" style="--hd:0s;margin-top:14px"></span>
              <span class="sx-sk is-h w60"></span>
              <span class="sx-sk w80"></span>
              <span class="sx-sk w70"></span>
              <span class="sx-sk is-btn sx-hl" style="--hd:6s;margin-top:4px"></span>
              <div class="sx-cols" style="--c:3;margin-top:10px">
                <div class="sx-box sx-hl" style="--hd:3s"><span class="sx-sk is-hot w50"></span><span class="sx-sk w90"></span><span class="sx-sk w70"></span></div>
                <div class="sx-box"><span class="sx-sk is-hot w50"></span><span class="sx-sk w90"></span><span class="sx-sk w70"></span></div>
                <div class="sx-box"><span class="sx-sk is-hot w50"></span><span class="sx-sk w90"></span><span class="sx-sk w70"></span></div>
              </div>
            </div>
          </div>

          <span class="sx-pin" style="right:-2%;top:12%"><b>1</b> Meaningful headline</span>
          <span class="sx-pin" style="left:-2%;top:52%"><b>2</b> Natural keywords</span>
          <span class="sx-pin" style="right:-2%;bottom:30%"><b>3</b> Purposeful call to action</span>
        </div>
      </div>
    </section>

    <!-- 2. NUMBERS -->
    <section class="sx-proof">
      <div class="sx-wrap sx-proof-grid">
        <div class="sx-proof-lead sx-reveal">Words matter.<br />Experience makes a difference.</div>
        <div class="sx-stats">
          {stats.map((s, i) => (
            <div class="sx-stat sx-reveal" style={`--d:${i * 0.08}s`}>
              <div class="sx-num">
                {s.count === false ? <span>{s.n}</span> : <span data-sx-count={s.n}>{s.n}</span>}
              </div>
              <div class="sx-stat-l">{s.l}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. THE MESSAGE MATTERS -->
    <section class="sx-section" id="story">
      <div class="sx-wrap sx-two">
        <div class="sx-copy">
          <div class="sx-kicker sx-reveal">The message matters</div>
          <h2 class="sx-h2 sx-reveal" style="max-width:none">Visitors are landing on your website. Are your words giving them a reason to stay?</h2>
          <p class="sx-reveal">
            Your website might have a great design, a useful product and a competitive offer. But if
            your message doesn't connect with visitors, you could be losing potential customers.
          </p>
          <p class="sx-reveal">
            Confusing headlines, generic descriptions and weak calls to action make it harder for
            people to understand why they should choose you.
          </p>
          <p class="sx-reveal">
            <strong>We help you get your message across.</strong> We combine persuasive writing with
            SEO-aware content structure to make your website clearer, more relevant and more compelling.
          </p>
        </div>

        <div class="sx-win sx-watch sx-reveal" role="img" aria-label="Illustration: a funnel that narrows at each point where copy fails to connect with visitors.">
          <div class="sx-funnel">
            <div class="sx-fbar" style="--w:100%">Visitors land on your website</div>
            <div class="sx-fbar" style="--w:80%;--d:.15s">A headline that makes sense</div>
            <div class="sx-fbar" style="--w:62%;--d:.3s">Copy that connects</div>
            <div class="sx-fbar" style="--w:46%;--d:.45s">A clear call to action</div>
          </div>
          <div class="sx-dots-cap">
            <span>Confusing headlines</span>
            <span>Generic descriptions</span>
            <span>Weak calls to action</span>
          </div>
          <div class="sx-dots-cap" style="padding-top:0"><div>Where visitors drop off. Illustration, not real data.</div></div>
        </div>
      </div>
    </section>

    <!-- 4. WHAT WE WRITE -->
    <section class="sx-section sx-alt" id="included">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">What we write</div>
          <h2 class="sx-h2 sx-reveal">Every page has a purpose. Your copy should reflect it.</h2>
          <p class="sx-lead sx-reveal">
            Website copy shaped around what each page needs to communicate—and what you want visitors to do next.
          </p>
        </div>

        <div class="sx-bento">

          <article class="sx-card sx-glow sx-reveal sx-b6">
            <div class="sx-viz is-stack" aria-hidden="true">
              <span class="sx-sk is-h w70"></span>
              <span class="sx-sk w90"></span>
              <span class="sx-sk is-btn" style="width:90px;height:24px"></span>
              <div class="sx-cols" style="--c:3">
                <div class="sx-box"><span class="sx-sk is-hot w50"></span><span class="sx-sk w90"></span></div>
                <div class="sx-box"><span class="sx-sk is-hot w50"></span><span class="sx-sk w90"></span></div>
                <div class="sx-box"><span class="sx-sk is-hot w50"></span><span class="sx-sk w90"></span></div>
              </div>
            </div>
            <div class="sx-card-k">01 — Homepage</div>
            <h3>Homepage copy</h3>
            <p>Communicate what your business does, who it serves and why visitors should care.</p>
          </article>

          <article class="sx-card sx-glow sx-reveal sx-b6" style="--d:.08s">
            <div class="sx-viz is-stack" aria-hidden="true">
              <div class="sx-cols" style="--c:2">
                <div class="sx-box" style="border:0;background:none;padding:0"><span class="sx-sk is-h w80"></span><span class="sx-sk w90"></span><span class="sx-sk w70"></span><span class="sx-sk w90"></span></div>
                <div class="sx-box"><div class="sx-stepmini"><b>✓</b><span></span></div><div class="sx-stepmini"><b>✓</b><span></span></div><div class="sx-stepmini"><b>✓</b><span></span></div></div>
              </div>
            </div>
            <div class="sx-card-k">02 — Services</div>
            <h3>Service page copy</h3>
            <p>Explain your services, highlight their benefits and encourage potential customers to get in touch.</p>
          </article>

          <article class="sx-card sx-glow sx-reveal sx-b6">
            <div class="sx-viz is-stack" aria-hidden="true" style="justify-items:center">
              <span class="sx-sk is-h w60"></span>
              <span class="sx-sk w80"></span>
              <span class="sx-sk w70"></span>
              <span class="sx-sk is-btn"></span>
            </div>
            <div class="sx-card-k">03 — Landing pages</div>
            <h3>Landing page copy</h3>
            <p>Build focused messages around a particular offer, campaign or audience.</p>
          </article>

          <article class="sx-card sx-glow sx-reveal sx-b6" style="--d:.08s">
            <div class="sx-viz is-stack" aria-hidden="true">
              <div class="sx-row"><span class="sx-sk is-av is-hot"></span><div style="flex:1;display:grid;gap:8px"><span class="sx-sk w50"></span><span class="sx-sk w30"></span></div></div>
              <span class="sx-sk w90"></span>
              <span class="sx-sk w80"></span>
              <span class="sx-sk w60"></span>
            </div>
            <div class="sx-card-k">04 — About Us</div>
            <h3>About Us pages</h3>
            <p>Tell your business story, communicate your values and give visitors reasons to trust you.</p>
          </article>

        </div>
      </div>
    </section>

    <!-- 5. OUR APPROACH -->
    <section class="sx-section sx-night" id="process">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">Our approach</div>
          <h2 class="sx-h2 sx-reveal">Good copy doesn't happen by accident.</h2>
          <p class="sx-lead sx-reveal">
            A straightforward process that turns what you know about your business into a clear message for your customers.
          </p>
        </div>

        <ol class="sx-tl sx-watch" style={`--n:${steps.length}`}>
          {steps.map((s) => (
            <li>
              <span class="sx-tl-dot">{s.dot}</span>
              <div class="sx-tl-k">{s.k}</div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6. WHY TOP LEAGUE -->
    <section class="sx-section" id="why">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">Why Top League</div>
          <h2 class="sx-h2 sx-reveal">Words matter. Experience makes a difference.</h2>
          <p class="sx-lead sx-reveal">
            Thoughtful copy, a practical understanding of SEO and a team that takes the time to understand your business.
          </p>
        </div>

        <div class="sx-bento">
          {whys.map((w, i) => (
            <article class="sx-card sx-glow sx-reveal sx-b6" style={`--d:${(i % 2) * 0.08}s`}>
              <span class="sx-ico" style="margin:6px 0 18px"><Icon name={w.icon} class="h-5 w-5" /></span>
              <h3>{w.t}</h3>
              <p>{w.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. CLIENT FEEDBACK -->
    <section class="sx-section sx-alt" id="proof">
      <div class="sx-wrap sx-two">
        <div>
          <div class="sx-kicker sx-reveal">Client feedback</div>
          <blockquote class="sx-bigq sx-reveal">They followed our direction very closely.</blockquote>
          <div class="sx-person sx-reveal">
            <span class="sx-av" aria-hidden="true">JH</span>
            <div class="sx-who"><b>Jason Hamblin</b><span>Senior Executive, L2T Media</span></div>
          </div>
        </div>

        <article class="sx-quote sx-reveal" style="--d:.1s">
          <div class="sx-stars" role="img" aria-label="5 out of 5 stars">★★★★★</div>
          <p>
            “Top League did a great job writing content for our website. They followed our direction very
            closely and were readily available for every stage of the project. I would highly recommend
            their writing skills and will be utilizing their services again. Great Job!”
          </p>
          <div class="sx-person">
            <span class="sx-av" aria-hidden="true">JH</span>
            <div class="sx-who"><b>Jason Hamblin</b><span>Senior Executive, L2T Media</span></div>
          </div>
        </article>
      </div>
    </section>

    <!-- 8. PACKAGES -->
    <section class="sx-section" id="packages">
      <div class="sx-wrap">
        <div class="sx-head">
          <div class="sx-kicker sx-reveal">Copywriting packages</div>
          <h2 class="sx-h2 sx-reveal">Professional website copy. Straightforward packages.</h2>
          <p class="sx-lead sx-reveal">Each page includes up to 300 words of website copy. Choose the package that fits your website.</p>
        </div>

        <div class="sx-paths">
          {plans.map((p, i) => (
            <article class={`sx-path sx-glow sx-reveal${p.feat ? ' is-feat' : ''}`} style={`--d:${i * 0.1}s`}>
              <span class="sx-path-n" aria-hidden="true">0{i + 1}</span>
              {p.badge && <span class="sx-badge">{p.badge}</span>}
              <div class="sx-card-k">{p.k}</div>
              <h3>{p.t}</h3>
              <div class="sx-price">{p.price}</div>
              <ul>{p.li.map((t) => <li><span class="sx-tick">✓</span>{t}</li>)}</ul>
              <a class={`sx-btn ${p.feat ? 'sx-btn-primary' : 'sx-btn-dark'}`} href={p.href}>{p.cta} <i>↗</i></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 9. MARQUEE -->
    <div class="sx-marquee" aria-hidden="true">
      <div class="sx-marquee-track">
        <span>{marquee}</span>
        <span>{marquee}</span>
        <span>{marquee}</span>
        <span>{marquee}</span>
      </div>
    </div>

    <!-- 10. CTA -->
    <section class="sx-cta" id="contact">
      <div class="sx-wrap">
        <div class="sx-cta-card sx-reveal">
          <div>
            <div class="sx-kicker sx-kicker-lime">Let's talk</div>
            <h2>Your website deserves better words.</h2>
            <p>Let's make your message clearer, your value easier to understand and your website more persuasive.</p>
          </div>
          <a class="sx-btn sx-btn-primary sx-btn-lg" href={enquiryLink}>Discuss your project <i>↗</i></a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style is:global>
.sx-page {
    --bg: #fff; --alt: #f1f4f2; --ink: #16202a; --muted: #566470; --line: #dfe5e8; --card: #fff;
    --red: #b34a43; --green: #1f5f55; --lime: #d9ff43; --night: #17242b; --night-2: #0f1a1f;
    color: var(--ink); background: var(--bg); overflow-x: clip; position: relative;
  }
.dark .sx-page {
    --bg: #1e293b; --alt: #172033; --ink: #f8fafc; --muted: #cbd5e1; --line: #334155; --card: #243247;
  }
.sx-page p { color: var(--muted); }
.sx-page .sx-wrap { max-width: 1180px; margin-inline: auto; padding-inline: 20px; }
.sx-page .sx-section { padding: clamp(72px, 9vw, 120px) 0; background: var(--bg); position: relative; }
.sx-page .sx-alt { background: var(--alt); border-block: 1px solid var(--line); }
.sx-page .sx-progress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 70; pointer-events: none; }
.sx-page .sx-progress span { display: block; height: 100%; background: var(--lime); transform: scaleX(0); transform-origin: 0 50%; }
.sx-js .sx-page .sx-reveal:not(.is-in) { opacity: 0; transform: translateY(22px); }
.sx-page .sx-reveal { transition: opacity .7s ease, transform .7s cubic-bezier(.2, .8, .2, 1); transition-delay: var(--d, 0s); }
.sx-page .sx-kicker { font-size: 13px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--red); margin-bottom: 18px; }
.sx-page .sx-kicker-lime { color: var(--lime); }
.sx-page .sx-h2 { font-size: clamp(34px, 4.6vw, 60px); line-height: 1.04; margin: 0 0 20px; color: var(--ink); max-width: 16ch; }
.sx-page .sx-head .sx-h2 { max-width: 20ch; }
.sx-page .sx-lead { font-size: clamp(17px, 1.6vw, 20px); line-height: 1.55; max-width: 46ch; margin: 0; }
.sx-page .sx-head { margin-bottom: 56px; max-width: 760px; }
.sx-page .sx-two { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(36px, 6vw, 90px); align-items: center; }
.sx-page .sx-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 15px 24px; border-radius: 999px;
    font-weight: 700; font-size: 15px; text-decoration: none; transition: transform .25s ease, background .25s ease, box-shadow .25s ease;
    border: 1px solid transparent; line-height: 1.2; cursor: pointer;
  }
.sx-page .sx-btn i { font-style: normal; display: inline-block; transition: transform .25s ease; }
.sx-page .sx-btn:hover i { transform: translate(3px, -3px); }
.sx-page .sx-btn:hover { transform: translateY(-2px); }
.sx-page .sx-btn-primary { background: var(--lime); color: #17242b; box-shadow: 0 10px 30px -10px rgba(217, 255, 67, .55); }
.sx-page .sx-btn-primary:hover { box-shadow: 0 16px 36px -10px rgba(217, 255, 67, .75); }
.sx-page .sx-btn-ghost { color: #fff; border-color: rgba(255, 255, 255, .35); }
.sx-page .sx-btn-ghost:hover { background: rgba(255, 255, 255, .08); }
.sx-page .sx-btn-dark { background: #17242b; color: #fff; }
.sx-page .sx-btn-dark:hover { background: #22343d; }
.sx-page .sx-btn-lg { padding: 18px 30px; font-size: 16px; white-space: nowrap; }
.sx-page .sx-hero {
    position: relative; overflow: hidden; color: #fff; padding: 150px 0 90px;
    background:
      radial-gradient(900px 520px at 88% 8%, rgba(217, 255, 67, .13), transparent 60%),
      radial-gradient(700px 520px at 0% 100%, rgba(179, 74, 67, .25), transparent 60%),
      linear-gradient(120deg, #0f1a1f, #17242b 55%, #1f3038);
  }
.sx-page .sx-hero::before {
    content: ""; position: absolute; inset: 0; pointer-events: none; opacity: .5;
    background-image: linear-gradient(rgba(255, 255, 255, .06) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .06) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(ellipse at 60% 40%, #000 10%, transparent 70%);
    mask-image: radial-gradient(ellipse at 60% 40%, #000 10%, transparent 70%);
  }
.sx-page .sx-hero-grid { position: relative; display: grid; grid-template-columns: 1.05fr .95fr; gap: 40px; align-items: center; }
.sx-page .sx-pill {
    display: inline-flex; align-items: center; gap: 10px; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; font-weight: 700;
    padding: 8px 14px; border-radius: 999px; background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .16); margin-bottom: 28px;
  }
.sx-page .sx-dot { width: 8px; height: 8px; border-radius: 50%; background: #b9db1c; box-shadow: 0 0 0 0 rgba(185, 219, 28, .7); animation: sx-ping 2s infinite; }
.sx-page .sx-hero h1 {
    font-size: clamp(46px, 6.4vw, 92px); line-height: 1; letter-spacing: -.045em; margin: 0 0 26px; color: #fff; max-width: 11ch;
  }
.sx-page .sx-hero h1 span {
    display: block; color: var(--lime);
    background: linear-gradient(transparent 82%, rgba(217, 255, 67, .22) 82%); width: fit-content;
  }
.sx-page .sx-hero p { font-size: clamp(18px, 1.7vw, 21px); line-height: 1.55; color: rgba(255, 255, 255, .8); max-width: 34em; margin: 0 0 34px; }
.sx-page .sx-actions { display: flex; flex-wrap: wrap; gap: 12px; }
.sx-page .sx-note { margin-top: 26px; font-size: 13px; color: rgba(255, 255, 255, .6); }
.sx-page .sx-proof { background: #0f1a1f; color: #fff; padding: 64px 0; border-top: 1px solid rgba(255, 255, 255, .08); }
.sx-page .sx-proof-grid { display: grid; grid-template-columns: 1fr 1.7fr; gap: 48px; align-items: center; }
.sx-page .sx-proof-lead { font-size: clamp(24px, 2.8vw, 36px); line-height: 1.15; letter-spacing: -.03em; font-weight: 700; font-family: 'Mona Bold', 'Mona Reg', sans-serif; }
.sx-page .sx-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.sx-page .sx-stat { border-left: 1px solid rgba(255, 255, 255, .16); padding-left: 18px; }
.sx-page .sx-num { font-family: 'Mona Bold Pro Max', 'Mona Bold', sans-serif; font-size: clamp(38px, 4.4vw, 58px); line-height: 1; color: var(--lime); letter-spacing: -.04em; }
