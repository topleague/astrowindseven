---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import QuickStart from '~/components/widgets/QuickStart.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogHighlightedPosts from '~/components/widgets/BlogHighlightedPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'AstroWind — Free template for creating websites with Astro + Tailwind CSS',
  ignoreTitleTemplate: true,
};

// Structured data for the site and its publisher, built only from
// `src/config.yaml` (`site.name`, `site.site`, `metadata.twitter.handle`), so
// it is correct for any site made with the template. Blog posts add
// BlogPosting on their own; the FAQs widget adds FAQPage.
const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];

// COMPARISION TABLE 
const usualWay = [
  {
    title: 'Start with the website',
    description:
      'The first question is “What kind of website do you want?”. A list of pages and features becomes the plan, and the business comes second.',
  },
  {
    title: 'Treat requirements as the strategy',
    description:
      'A quote follows the feature list. The real budget surfaces later, usually as a compromise.',
  },
  {
    title: 'Choose what is familiar',
    description:
      'Domain, hosting and platform are picked by habit, convenience or the lowest price.',
  },
  {
    title: 'Build first, think about SEO later',
    description:
      'Pages are designed and written first. Search intent and site structure are considered afterwards.',
  },
  {
    title: 'Fill the pages at the end',
    description:
      'Copy and images arrive late and get squeezed into whatever space the design left.',
  },
  {
    title: 'Launch and move on',
    description:
      'Speed, security, social presence and fresh content become somebody else’s problem.',
  },
];

const topLeagueWay = [
  {
    title: 'Start with the business',
    description:
      'We begin with your audience, your goals and what success means to you. Only then do we decide which pages and features earn a place.',
  },
  {
    title: 'Plan around the real budget',
    description:
      'Budget is part of the first conversation, so the plan is practical rather than padded.',
  },
  {
    title: 'Choose foundations deliberately',
    description:
      'Domain, hosting and CMS, platform or framework follow your requirements, not whatever we happen to use.',
  },
  {
    title: 'Map SEO before building pages',
    description:
      'Search intent, keywords, structure and the pages you need to compete are decided before the build begins.',
  },
  {
    title: 'Create content around the plan',
    description:
      'Content and visuals are prepared with your audience and search goals in mind, before the pages are assembled.',
  },
  {
    title: 'Plan for life after launch',
    description:
      'We build for speed and security from the start, keep social aligned with the site, and stay on for updates, analytics and new content.',
  },
];
---

<!-- //THIS IS A CUSTOM BODY CLASS CODE 🔴🟢🔴🟢🔴🟢🔴🟢🔴🟢 -->
<Layout metadata={metadata} pageClass="home-draft">
  <StructuredData slot="head" schema={structuredData} /> 

<!-- Features Widget (START) ************************************************************************************************************************ -->

  <!-- Hero Widget ******************* -->

 <!-- HERO -->
    <section class="hero">
      <div class="container">

        <div class="eyebrow"><span class="dot"></span> Digital partner for small businesses</div>

        <h1>
          Build Your Online Presence,
          <span>Not Just Another Website.</span>
        </h1>

        <p>
          Clear, persuasive and keyword-aware product descriptions written
          to help shoppers understand your products, find them in search,
          and feel confident buying them.
        </p>

        <div class="actions">
          <a class="btn primary" href="#packages">
            Explore packages
          </a>

          <a class="btn ghost" href="#benefits">
            See what's included
          </a>
        </div>

        <div class="hero-note">
          Original writing · Keyword-aware · Conversion-focused · Human-edited
        </div>

      </div>
    </section>

  <div class="proofbar">
    <div class="wrap proofgrid">
      <div class="proof"><strong>16 years</strong><span>in digital</span></div>
      <div class="proof"><strong>30+</strong><span>websites built recently</span></div>
      <div class="proof"><strong>20</strong><span>websites currently maintained</span></div>
      <div class="proof"><strong>10 countries</strong><span>clients served</span></div>
    </div>
  </div>
<!-- End of Hero Section ************************************************************************************************************************ -->

  <!-- SocialProof Widget ************ -->


<!-- THE IDEA // WHY IT MATTERS -->
<!-- 4. What is coming: three cards -->

  <Features2
    id="coming"
    classes={{container: 'coming-section', headline: {container: 'max-w-3xl !mx-0 !text-left',},}}// THIS IS A CUSTOM CLASS CODE 🔴🟢🔴🟢🔴🟢🔴🟢🔴🟢     
    tagline="Why it matters"
    title="Your website matters only when everything else is done right."
    subtitle="Your domain, brand, content, search visibility and social presence all shape what happens after the website goes live."
    columns={3}
    items={[
      {
        title: 'Domain Name',
        description:
          'A domain, hosting and technology choices can affect your brand and your future long after the website launches.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Social Presence',
        description:
          'Your website should work with your content, search and social presence — not sit apart from them.',
        icon: 'tabler:calendar-event',
      },
      {
        title: 'SEO Rankings',
        description:
          'Eublishing, SEO, campaigns, analytics and maintenance are what keep an online presence useful after launch day.',
        icon: 'tabler:gift',
      },
    ]}
  />

  <!-- QuickStart Widget ************* -->

  
<!-- Content Widget **************** --><!-- A REAL CLIENT STORY 🔴🟢 🔴🟢 🔴🟢  **************** -->
  <!-- Steps Widget ****************** -->

<div class="my-custom-class bg-white">
  <Steps
 isReversed
    classes="my-custom-class bg-white"
    tagline="Based on a Real Client Story."
    title="What an Expensive Mistake Looks Like!"
    items={[
      {
        title: 'Domain + logo',
        description:
          'Benefiting from the performance and developer-friendly features of this modern static site generator.',
        icon: 'tabler:x',
      },
      {
        title: 'Trademark conflict',
        description:
          'Facilitating rapid design and consistent styling with this highly popular utility-first CSS framework.',
        icon: 'tabler:check',
      },
      {
        title: 'Domain + logo abandoned',
        description:
          'Ensure your website looks and functions consistently across various web browsers, delivering a seamless experience to all users.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1758874572670-63042c5448c6?q=80&w=3840&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D',
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="tagline">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Based on a Real Client Story.</h3>
      A client came to us with a domain and logo already chosen. After the website was ready, a trademark conflict forced a change of name, domain and logo. Bummer.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
</Steps>
</div>
  
<!-- END OF CLIENT STORY 🔴🟢 🔴🟢 🔴🟢  **************** -->

<!-- EXPREIMENT ************************************************************************************************************************************************ -->
<!-- The Usual Way vs The Correct Way **************** -->

<section class="relative comparison-section">
  <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>

  <div class="relative mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">

    <!-- Section heading -->
    <div class="mx-auto mb-12 max-w-3xl text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary">
        The Top League Difference
      </p>

      <h2 class="text-4xl font-bold tracking-tight font-heading sm:text-5xl dark:text-white">
        A website is only as good as the thinking behind it.
      </h2>

      <p class="mt-4 text-xl text-muted dark:text-slate-400">
        Here’s what we do differently before we build, while we build, and after we launch.
      </p>
    </div>

    <!-- Two columns -->
    <div class="grid gap-10 md:grid-cols-2">

      <!-- LEFT: The Usual Way -->
      <div>
        <h3 class="mb-8 flex items-center text-2xl font-bold tracking-tight dark:text-white"> 
          <Icon
            name="tabler:x"
            class="mr-3 h-7 w-7 shrink-0 rounded-full bg-red-600 p-1 text-gray-50"
          />
          The Usual Way
        </h3>

        <div class="grid gap-8">
          {usualWay.map((item) => (
            <div class="comparison-item flex items-start">
              <span class="comparison-dot comparison-dot-usual"></span>
              <div class="ml-3">
                <h4 class="font-semibold dark:text-white">
                  {item.title}
                </h4>
                <p class="mt-2 text-muted dark:text-slate-400">
                  {item.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- RIGHT: The Correct Way -->
      <div>
        <h3 class="mb-8 flex items-center text-2xl font-bold tracking-tight dark:text-white">
          <Icon
            name="tabler:check"
            class="mr-3 h-7 w-7 shrink-0 rounded-full bg-green-600 p-1 text-gray-50"
          />
          The Top League Approach
        </h3>

        <div class="grid gap-8">
          {topLeagueWay.map((item) => (
            <div class="comparison-item flex items-start">
              <span class="comparison-dot comparison-dot-top-league"></span>
              <div class="ml-3">
                <h4 class="font-semibold dark:text-white">
                  {item.title}
                </h4>
                <p class="mt-2 text-muted dark:text-slate-400">
                  {item.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
<!-- EXPREIMENT ENDS ************************************************************************************************************************************************ -->

  <!-- Content Widget **************** -->

  <!-- Content Widget **************** -->


  <!-- Steps Widget ****************** -->

<div class="my-custom-class bg-white">
  <Steps
 isReversed
    classes="my-custom-class bg-white"
    tagline="Based on a Real Client Story."
    title="What an Expensive Mistake Looks Like!"
    items={[
      {
        title: 'Domain + logo',
        description:
          'Benefiting from the performance and developer-friendly features of this modern static site generator.',
        icon: 'tabler:x',
      },
      {
        title: 'Trademark conflict',
        description:
          'Facilitating rapid design and consistent styling with this highly popular utility-first CSS framework.',
        icon: 'tabler:check',
      },
      {
        title: 'Domain + logo abandoned',
        description:
          'Ensure your website looks and functions consistently across various web browsers, delivering a seamless experience to all users.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1758874572670-63042c5448c6?q=80&w=3840&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D',
      alt: 'Colorful Image',
    }}
  >
    <Fragment slot="tagline">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Based on a Real Client Story.</h3>
      A client came to us with a domain and logo already chosen. After the website was ready, a trademark conflict forced a change of name, domain and logo. Bummer.
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
</Steps>
</div>

  <!-- Features2 Widget ************** -->



  <!-- Timeline Widget **************** -->

  <!-- Note Widget ******************* -->

   <!-- <Note title="Philosophy:" description="Simplicity, Best Practices and High Performance" />-->

  <!-- HighlightedPosts Widget ******* -->

  <BlogHighlightedPosts
    title="Find out more content in our Blog"
    postIds={[
      'get-started-website-with-astro-tailwind-css',
      'how-to-customize-astrowind-to-your-brand',
      'useful-resources-to-create-websites',
      'landing',
    ]}
    information={`The blog is used to display AstroWind documentation.
                        Each new article will be an important step that you will need to know to be an expert in creating a website using Astro v7 + Tailwind CSS v4.
                        Astro is a very interesting technology. Thanks.
                `}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    id="faqs"
    title="Frequently Asked Questions"
    subtitle="The questions people ask before they clone the repository, answered briefly. For step-by-step tasks, the repository ships skills your AI coding assistant can follow."
    tagline="FAQs"
    schema
    items={[
      {
        title: 'What is AstroWind?',
        description:
          'A free, open-source template for Astro and Tailwind CSS: a static site with a header, footer, twenty-plus reusable widgets, a Markdown/MDX blog, dark mode, RTL support, image optimisation, SEO metadata and an RSS feed, ready to be customised and deployed anywhere static files are served.',
      },
      {
        title: 'What do I need to start?',
        description:
          'A current Node.js (the exact minimum is in <code>package.json</code>) and a terminal. Run <code>npm create astro@latest -- --template arthelokyo/astrowind</code>, then <code>npm run dev</code>. Site name, URL, metadata and blog options live in <code>src/config.yaml</code>; colours and fonts in <code>src/components/CustomStyles.astro</code>.',
      },
      {
        title: 'Can I use it for a site without a blog?',
        description:
          'Yes. Set <code>apps.blog.isEnabled: false</code> in <code>src/config.yaml</code> and the blog routes, the RSS feed and the post widgets disappear from the build. The rest of the template is unaffected.',
      },
      {
        title: 'How do I change colours, fonts and the logo?',
        description:
          'Colours are CSS variables in <code>src/components/CustomStyles.astro</code> (light and dark), fonts are configured in <code>astro.config.ts</code> through Astro’s Fonts API, and the logo is <code>src/components/Logo.astro</code>. The same variables also feed the shadcn/ui-compatible tokens, so shadcn-style components pick up your theme.',
      },
      {
        title: 'Does it work with an AI coding assistant?',
        description:
          'It is built for it. The repository includes <code>AGENTS.md</code> with the project conventions and a <code>.agents/skills/</code> folder with step-by-step guides for common tasks (disable the blog, set an Open Graph image, deploy under a base path, connect a CMS, deploy to Cloudflare…), so tools like Claude Code, Codex or Cursor can do them reliably.',
      },
      {
        title: 'Where can I deploy it and what does it cost?',
        description:
          'Anywhere that serves static files: Vercel, Netlify, Cloudflare, GitHub Pages, an nginx container (a Dockerfile is included) or your own server. The template is MIT licensed and free for personal and commercial projects.',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->


  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get template',
        href: 'https://github.com/arthelokyo/astrowind',
        target: '_blank',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">
      Astro&nbsp;+&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Tailwind CSS</span>
    </Fragment>

    <Fragment slot="subtitle">
      Free, open source and production-ready. <br class="hidden md:inline" />Clone it, replace the content and deploy.
    </Fragment>
  </CallToAction>
</Layout>
